                DataGridViewContentAlignment.MiddleRight;
        }

        // ??????????????????????????????????????????????????????
        //  DATA
        // ??????????????????????????????????????????????????????
        private void LoadProducts()
        {
            try
            {
                if (_service == null)
                {
                    MessageBox.Show("خدمة المنتجات غير متوفرة.", "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return;
                }

                var src = _service.GetAll();
                var list = src != null ? src.ToList() : new List<ProductDto>();
                var q = txtSearch?.Text?.Trim() ?? string.Empty;
                if (!string.IsNullOrEmpty(q))
                    list = list.Where(x => x.Name != null && x.Name.IndexOf(q, StringComparison.OrdinalIgnoreCase) >= 0).ToList();

                if (dgvProducts != null)
                {
                    dgvProducts.DataSource = new BindingSource { DataSource = list };
                    FitColumns();
                }

                if (lblCountBadge != null)
                    lblCountBadge.Text = $"{list.Count} منتج";
            }
            catch (Exception ex)
            {
                MessageBox.Show($"فشل تحميل المنتجات: {ex.Message}", "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void FitColumns()
        {
            if (dgvProducts == null || dgvProducts.Columns.Count == 0) return;
            int w = dgvProducts.ClientSize.Width; if (w <= 0) return;

            // Percent-based sizing: Product 40%, Purchase 20%, Sale 20%, Status 10%, Actions 10%
            int wProduct = (int)(w * 0.40);
            int wPurchase = (int)(w * 0.20);
            int wSale = (int)(w * 0.20);
            int wStatus = (int)(w * 0.10);
            int wActions = w - wProduct - wPurchase - wSale - wStatus; // ensure remaining pixels go to Actions

            if (dgvProducts.Columns.Contains("Product")) dgvProducts.Columns["Product"].Width = Math.Max(140, wProduct);
            if (dgvProducts.Columns.Contains("PurchasePrice")) dgvProducts.Columns["PurchasePrice"].Width = Math.Max(100, wPurchase);
            if (dgvProducts.Columns.Contains("SalePrice")) dgvProducts.Columns["SalePrice"].Width = Math.Max(100, wSale);
            if (dgvProducts.Columns.Contains("Status")) dgvProducts.Columns["Status"].Width = Math.Max(80, wStatus);
            if (dgvProducts.Columns.Contains("Actions")) dgvProducts.Columns["Actions"].Width = Math.Max(90, wActions);
        }

