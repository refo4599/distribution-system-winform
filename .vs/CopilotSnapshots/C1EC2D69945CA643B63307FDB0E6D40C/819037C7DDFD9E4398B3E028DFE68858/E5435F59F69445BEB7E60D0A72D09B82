        private void BuildLayout()
        {
            var root = new TableLayoutPanel
            {
                Dock = DockStyle.Fill,
                ColumnCount = 1,
                RowCount = 3,
                BackColor = Color.Transparent,
                Padding = new Padding(0)
            };
            // header (page header) + search + table
            root.RowStyles.Add(new RowStyle(SizeType.Absolute, 88F));   // header (taller for new banner)
            root.RowStyles.Add(new RowStyle(SizeType.Absolute, 48F));   // search
            root.RowStyles.Add(new RowStyle(SizeType.Percent, 100F));   // table
            Controls.Add(root);

            root.Controls.Add(BuildPageHeader(), 0, 0);
            root.Controls.Add(BuildSearchRow(), 0, 1);
            root.Controls.Add(BuildTableCard(), 0, 2);
        }

        private Panel BuildPageHeader()
        {
            var pnl = new Panel();
            pnl.Dock    = DockStyle.Fill;
            pnl.Height  = 88;
            pnl.Padding = new Padding(0, 0, 0, 12);
            pnl.BackColor = Color.Transparent;

            // ── Gradient banner panel ──────────────────
            var banner = new Panel();
            banner.Dock      = DockStyle.Fill;
            banner.BackColor = Color.Transparent;  // painted manually below

            banner.Paint += (s, e) =>
            {
                var g   = e.Graphics;
                var rc  = new Rectangle(0, 0, banner.Width, banner.Height);
                g.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias;

                // Gradient background
                using (var br = new System.Drawing.Drawing2D.LinearGradientBrush(
                    rc,
                    ColorTranslator.FromHtml("#1a2f5e"),   // dark navy right
                    ColorTranslator.FromHtml("#1565c0"),   // mid blue left
                    System.Drawing.Drawing2D.LinearGradientMode.Horizontal))
                {
                    // Rounded rect path
                    int r = 16;
                    using (var path = new System.Drawing.Drawing2D.GraphicsPath())
                    {
                        path.AddArc(rc.Left,         rc.Top,          r*2, r*2, 180, 90);
                        path.AddArc(rc.Right - r*2,  rc.Top,          r*2, r*2, 270, 90);
                        path.AddArc(rc.Right - r*2,  rc.Bottom - r*2, r*2, r*2,   0, 90);
                        path.AddArc(rc.Left,         rc.Bottom - r*2, r*2, r*2,  90, 90);
                        path.CloseFigure();
                        g.FillPath(br, path);
                    }
                }

                // Dot grid overlay
                using (var dotBrush = new SolidBrush(Color.FromArgb(18, 255, 255, 255)))
                {
                    for (int x = 10; x < banner.Width; x += 22)
                        for (int y = 8; y < banner.Height; y += 22)
                            g.FillEllipse(dotBrush, x, y, 2, 2);
                }

                // Decorative large circle (right side)
                using (var circleBrush = new SolidBrush(Color.FromArgb(14, 255, 255, 255)))
                {
                    g.FillEllipse(circleBrush,
                        banner.Width - 130, -50, 220, 220);   // top-right bleed circle
                    g.FillEllipse(circleBrush,
                        banner.Width - 30,  20,  160, 160);   // second smaller
                }

                // Drop shadow hint at bottom
                using (var shadowBrush = new System.Drawing.Drawing2D.LinearGradientBrush(
                    new Rectangle(0, banner.Height - 6, banner.Width, 6),
                    Color.FromArgb(40, 0, 0, 0),
                    Color.Transparent,
                    System.Drawing.Drawing2D.LinearGradientMode.Vertical))
                {
                    e.Graphics.FillRectangle(shadowBrush,
                        0, banner.Height - 6, banner.Width, 6);
                }
            };

            // ── Title group (right side, RTL) ────────
            var pnlTitle = new Panel();
            pnlTitle.Dock      = DockStyle.Right;
            pnlTitle.Width     = 340;
            pnlTitle.BackColor = Color.Transparent;
            pnlTitle.Padding   = new Padding(0, 0, 20, 0);

            var lblMain = new Label();
            lblMain.Text      = "إدارة المنتجات";
            lblMain.Font      = new Font("Cairo", 22F, FontStyle.Bold);
            lblMain.ForeColor = Color.White;
            lblMain.Dock      = DockStyle.Top;
            lblMain.Height    = 44;
            lblMain.TextAlign = ContentAlignment.BottomRight;
            lblMain.BackColor = Color.Transparent;

            var pnlAccent = new Panel();
            pnlAccent.Dock      = DockStyle.Top;
            pnlAccent.Height    = 18;
            pnlAccent.BackColor = Color.Transparent;

            // Accent bars + subtitle drawn manually:
            pnlAccent.Paint += (s, e) =>
            {
                var g = e.Graphics;
                g.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias;

                // Blue underline bars (right-aligned)
                int right = pnlAccent.Width;
                using (var b1 = new SolidBrush(ColorTranslator.FromHtml("#64B5F6")))
                    g.FillRoundedRectangle(b1, right - 38, 6, 36, 3, 2);  // wide bar
                using (var b2 = new SolidBrush(Color.FromArgb(120, 100, 181, 246)))
                    g.FillRoundedRectangle(b2, right - 56, 6, 12, 3, 2);  // small bar

                // Subtitle text
                using (var sf = new Font("Cairo", 10F, FontStyle.Regular))
                using (var brush = new SolidBrush(Color.FromArgb(140, 255, 255, 255)))
                {
                    var text = "عرض وإدارة جميع المنتجات";
                    g.DrawString(text, sf, brush, right - 220, 0);
                }
            };

            pnlTitle.Controls.Add(pnlAccent);
            pnlTitle.Controls.Add(lblMain);

            // ── Add button (left side, RTL) ──────────
            var pnlBtnWrap = new Panel();
            pnlBtnWrap.Dock      = DockStyle.Left;
            pnlBtnWrap.Width     = 180;
            pnlBtnWrap.BackColor = Color.Transparent;
            pnlBtnWrap.Padding   = new Padding(20, 0, 0, 0);

            btnAdd = new Guna2Button();
            btnAdd.Text        = "+ إضافة منتج";
            btnAdd.FillColor   = Color.FromArgb(30, 255, 255, 255);  // glass effect
            btnAdd.ForeColor   = Color.White;
            btnAdd.BorderRadius = 12;
            btnAdd.BorderThickness = 1;
            btnAdd.BorderColor = Color.FromArgb(60, 255, 255, 255);
            btnAdd.Font        = new Font("Cairo", 11.5F, FontStyle.Bold);
            btnAdd.Size        = new Size(148, 46);
            btnAdd.Dock        = DockStyle.None;
            btnAdd.Anchor      = AnchorStyles.Left | AnchorStyles.Top;
            btnAdd.Location    = new Point(20, (76 - 46) / 2);  // vertically centered
            btnAdd.ShadowDecoration.Enabled = true;
            btnAdd.ShadowDecoration.Color   = Color.FromArgb(40, 0, 0, 0);
            btnAdd.ShadowDecoration.Depth   = 8;
            btnAdd.HoverState.FillColor     = Color.FromArgb(55, 255, 255, 255);
            btnAdd.Click += (s, e) => ShowAddProductPopup();

            pnlBtnWrap.Controls.Add(btnAdd);

            // ── Assemble ─────────────────────────────
            banner.Controls.Add(pnlBtnWrap);
            banner.Controls.Add(pnlTitle);
            pnl.Controls.Add(banner);

            return pnl;
        }

