            for (int i = 0; i <= 80; i += 10)
            {
                overlay.BackColor = Color.FromArgb(i, 0, 0, 0);
                await Task.Delay(10);
            }

            // ????????? Popup Card ?????????
            var popup = new Guna2Panel
            {
                Size = new Size(520, 400),
                BorderRadius = 22,
                FillColor = Color.White,
                BackColor = Color.White
            };

            popup.ShadowDecoration.Enabled = true;
            popup.ShadowDecoration.Depth = 60;
            popup.ShadowDecoration.Color = Color.FromArgb(70, 0, 0, 0);

            popup.Location = new Point(
                (overlay.Width - popup.Width) / 2,
                (overlay.Height - popup.Height) / 2
            );

            overlay.Controls.Add(popup);

            // ????????? Header ?????????
            var header = new Panel
            {
                Dock = DockStyle.Top,
                Height = 75,
                BackColor = Color.White,
                Padding = new Padding(25, 0, 25, 0)
            };

            var lblTitle = new Label
            {
                Text = editDto == null ? "إضافة منتج جديد" : "تعديل المنتج",
                Dock = DockStyle.Fill,
                Font = new Font("Cairo", 16F, FontStyle.Bold),
                TextAlign = ContentAlignment.MiddleCenter,
                ForeColor = ColorTranslator.FromHtml("#111827")
            };

            var btnClose = new Guna2ControlBox
            {
                Dock = DockStyle.Left,
                FillColor = Color.Transparent,
                IconColor = ColorTranslator.FromHtml("#6B7280")
            };

            btnClose.Click += async (s, e) =>
            {
                for (int i = 80; i >= 0; i -= 10)
                {
                    overlay.BackColor = Color.FromArgb(i, 0, 0, 0);
                    await Task.Delay(10);
                }

                this.Controls.Remove(overlay);
                overlay.Dispose();
            };

            header.Controls.Add(lblTitle);
            header.Controls.Add(btnClose);

            // ????????? Body ?????????
            var body = new Panel
            {
                Dock = DockStyle.Fill,
                Padding = new Padding(45, 10, 45, 10),
                BackColor = Color.White
            };

            Guna2TextBox MakeInput(string placeholder)
            {
                return new Guna2TextBox
                {
                    Height = 50,
                    BorderRadius = 16,
                    Dock = DockStyle.Top,
                    PlaceholderText = placeholder,
                    Font = new Font("Cairo", 11F),
                    BorderColor = ColorTranslator.FromHtml("#E5E7EB"),
                    FocusedState = { BorderColor = ColorTranslator.FromHtml("#4F6EF7") },
                    Margin = new Padding(0, 0, 0, 8)
                };
            }

            Label MakeError()
            {
                return new Label
                {
                    ForeColor = ColorTranslator.FromHtml("#EF4444"),
                    Font = new Font("Cairo", 9F),
                    Dock = DockStyle.Top,
                    Height = 20,
                    Visible = false,
                    TextAlign = ContentAlignment.MiddleRight
                };
            }

            var txtName = MakeInput("اسم المنتج");
            var errName = MakeError();

            var txtPurchase = MakeInput("سعر الشراء");
            var errPurchase = MakeError();

            var txtSale = MakeInput("سعر البيع");
            var errSale = MakeError();

            body.Controls.Add(errSale);
            body.Controls.Add(txtSale);
            body.Controls.Add(errPurchase);
            body.Controls.Add(txtPurchase);
            body.Controls.Add(errName);
            body.Controls.Add(txtName);

            if (editDto != null)
            {
                txtName.Text = editDto.Name;
                txtPurchase.Text = editDto.PurchasePrice.ToString();
                txtSale.Text = editDto.SalePrice.ToString();
            }

            // ????????? Footer ?????????
            var footer = new Panel
            {
                Dock = DockStyle.Bottom,
                Height = 95,
                Padding = new Padding(45, 15, 45, 25),
                BackColor = Color.White
            };

            var btnSave = new Guna2Button
            {
                Text = editDto == null ? "حفظ المنتج" : "تحديث المنتج",
                Dock = DockStyle.Fill,
                BorderRadius = 18,
                FillColor = ColorTranslator.FromHtml("#4F6EF7"),
                Font = new Font("Cairo", 12F, FontStyle.Bold),
                ForeColor = Color.White,
                Animated = true
            };

            btnSave.HoverState.FillColor = ColorTranslator.FromHtml("#3E5AE0");

            btnSave.Click += async (s, e) =>
            {
                errName.Visible = errPurchase.Visible = errSale.Visible = false;
                bool valid = true;

                if (string.IsNullOrWhiteSpace(txtName.Text))
                {
                    errName.Text = "الاسم مطلوب";
                    errName.Visible = true;
                    valid = false;
                }

                if (!decimal.TryParse(txtPurchase.Text, out decimal pp) || pp <= 0)
                {
                    errPurchase.Text = "قيمة غير صحيحة";
                    errPurchase.Visible = true;
                    valid = false;
                }

                if (!decimal.TryParse(txtSale.Text, out decimal sp) || sp <= 0)
                {
                    errSale.Text = "قيمة غير صحيحة";
                    errSale.Visible = true;
                    valid = false;
                }

                if (!valid) return;

                btnSave.Enabled = false;
                btnSave.Text = "جارٍ الحفظ...";

                await Task.Delay(700);

                var dto = new ProductDto
                {
                    Name = txtName.Text.Trim(),
                    PurchasePrice = pp,
                    SalePrice = sp
                };

                if (editDto == null)
                    _service.AddProduct(dto);
                else
                {
                    dto.Id = editDto.Id;
                    _service.Update(dto);
                }

                LoadProducts();

                for (int i = 80; i >= 0; i -= 10)
                {
                    overlay.BackColor = Color.FromArgb(i, 0, 0, 0);
                    await Task.Delay(10);
                }

                this.Controls.Remove(overlay);
                overlay.Dispose();
            };

            footer.Controls.Add(btnSave);

            popup.Controls.Add(body);
            popup.Controls.Add(footer);
            popup.Controls.Add(header);

            // Add popup to overlay and set focus
            txtName.Focus();
        }
    }

    // Graphics extensions used by the new header painting
    public static class GraphicsExtensions
    {
        public static void FillRoundedRectangle(this Graphics g, Brush brush, int x, int y, int width, int height, int radius)
        {
            try
            {
                int d = radius * 2;
                using (var path = new GraphicsPath())
                {
                    path.AddArc(x, y, d, d, 180, 90);
                    path.AddArc(x + width - d, y, d, d, 270, 90);
                    path.AddArc(x + width - d, y + height - d, d, d, 0, 90);
                    path.AddArc(x, y + height - d, d, d, 90, 90);
                    path.CloseFigure();
                    g.FillPath(brush, path);
                }
            }
            catch
            {
                // fallback: simple rectangle
                g.FillRectangle(brush, x, y, width, height);
            }
        }
    }