            var lblTitle = new Label { Text = title, Dock = DockStyle.Bottom, Height = 20, Font = new Font("Cairo", 9F), ForeColor = ColorTranslator.FromHtml("#9CA3AF"), TextAlign = ContentAlignment.MiddleLeft };

