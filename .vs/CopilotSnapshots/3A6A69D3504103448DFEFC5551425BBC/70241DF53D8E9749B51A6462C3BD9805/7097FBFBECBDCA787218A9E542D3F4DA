        // Painting avatar in ProductName cell (column index 0) and action icons in Actions cell
        private void Dgv_CellPainting_AvatarAndActions(object sender, DataGridViewCellPaintingEventArgs e)
        {
            if (e.RowIndex < 0) return;

            // product column is index 0
            if (e.ColumnIndex == 0)
            {
                e.Handled = true;

                // Clip drawing to cell bounds to avoid drawing outside
                e.Graphics.SetClip(e.CellBounds);

                // Draw background
                e.Graphics.FillRectangle(new SolidBrush(e.CellStyle.BackColor), e.CellBounds);

                var dto = dgv.Rows[e.RowIndex].DataBoundItem as WarehouseBalanceDto;

                // avatar circle on the RIGHT side of cell
                int avatarSize = 36;
                int avatarPadding = 10;
                int circleX = e.CellBounds.Right - avatarSize - avatarPadding; // e.CellBounds.Right - 46
                int circleY = e.CellBounds.Top + (e.CellBounds.Height - avatarSize) / 2;
                var circleRect = new Rectangle(circleX, circleY, avatarSize, avatarSize);

                // ensure clipped to cell bounds
                var clippedAvatar = Rectangle.Intersect(circleRect, e.CellBounds);
                if (!clippedAvatar.IsEmpty)
                {
                    var colors = new[] { ColorTranslator.FromHtml("#4E73DF"), ColorTranslator.FromHtml("#10B981"), ColorTranslator.FromHtml("#F59E0B"), ColorTranslator.FromHtml("#8B5CF6"), ColorTranslator.FromHtml("#EF4444") };
                    var bg = colors[e.RowIndex % colors.Length];

                    using (var path = new System.Drawing.Drawing2D.GraphicsPath())
                    {
                        path.AddEllipse(clippedAvatar);
                        e.Graphics.SetClip(path);
                        using (var b = new SolidBrush(bg)) e.Graphics.FillEllipse(b, clippedAvatar);
                    }

                    e.Graphics.ResetClip();
                    e.Graphics.SetClip(e.CellBounds);

                    // initial
                    var initial = dto != null && !string.IsNullOrEmpty(dto.ProductName) ? dto.ProductName.Trim()[0].ToString() : "#";
                    using (var f = new Font("Cairo", 13F, FontStyle.Bold, GraphicsUnit.Pixel))
                    using (var sb = new SolidBrush(Color.White))
                    {
                        var sz = e.Graphics.MeasureString(initial, f);
                        e.Graphics.DrawString(initial, f, sb, clippedAvatar.Left + (clippedAvatar.Width - sz.Width) / 2, clippedAvatar.Top + (clippedAvatar.Height - sz.Height) / 2);
                    }
                }

                // product name to left of circle: compute width and draw
                using (var f = new Font("Cairo", 11F, FontStyle.Regular))
                using (var sb = new SolidBrush(ColorTranslator.FromHtml("#1A1D23")))
                {
                    var text = dto != null ? dto.ProductName : Convert.ToString(e.Value);
                    var textRect = new Rectangle(e.CellBounds.Left + 8, e.CellBounds.Top + 8, Math.Max(16, (e.CellBounds.Right - 8) - (circleX + avatarSize) - 16), e.CellBounds.Height - 16);
                    // fallback: if width negative, set to small area
                    if (textRect.Width < 20) textRect.Width = Math.Max(20, e.CellBounds.Width - avatarSize - 32);
                    TextRenderer.DrawText(e.Graphics, text, f, textRect, ColorTranslator.FromHtml("#1A1D23"), TextFormatFlags.Right | TextFormatFlags.VerticalCenter | TextFormatFlags.EndEllipsis);
                }

                // selection border
                if (e.State.HasFlag(DataGridViewElementStates.Selected))
                {
                    using (var pen = new Pen(Color.FromArgb(235, 243, 255), 2))
                    {
                        var r = e.CellBounds; r.Inflate(-1, -1);
                        e.Graphics.DrawRectangle(pen, r);
                    }
                }

                e.Graphics.ResetClip();
            }
            else
            {
                var col = dgv.Columns[e.ColumnIndex].Name;
                if (col == "Actions")
                {
                    e.Handled = true;
                    e.PaintBackground(e.CellBounds, true);

                    // icons: each 28x28, spacing 4, totalW = 92, start from LEFT side
                    int iconSize = 28; int spacing = 4; int totalW = iconSize * 3 + spacing * 2; int startX = e.CellBounds.Left + 8; int y = e.CellBounds.Top + (e.CellBounds.Height - iconSize) / 2;

                    var r1 = new Rectangle(startX, y, iconSize, iconSize);
                    var r2 = new Rectangle(r1.Right + spacing, y, iconSize, iconSize);
                    var r3 = new Rectangle(r2.Right + spacing, y, iconSize, iconSize);

                    // Icon 1 - view (eye)
                    DrawRoundedRect(e.Graphics, r1, 5, Color.FromArgb(238, 242, 255));
                    DrawEyeIcon(e.Graphics, r1, ColorTranslator.FromHtml("#4E73DF"));

                    // Icon 2 - edit (pencil)
                    DrawRoundedRect(e.Graphics, r2, 5, Color.FromArgb(209, 250, 229));
                    DrawPencilIcon(e.Graphics, r2, ColorTranslator.FromHtml("#059669"));

                    // Icon 3 - delete (trash)
                    DrawRoundedRect(e.Graphics, r3, 5, Color.FromArgb(254, 226, 226));
                    DrawTrashIcon(e.Graphics, r3, ColorTranslator.FromHtml("#EF4444"));
                }
            }
        }

        private void DrawRoundedRect(Graphics g, Rectangle rect, int radius, Color fill)
        {
            using (var b = new SolidBrush(fill))
            using (var path = RoundedRectPath(rect, radius))
            {
                g.FillPath(b, path);
            }
        }

        private void DrawEyeIcon(Graphics g, Rectangle rect, Color pupilColor)
        {
            using (var pen = new Pen(ColorTranslator.FromHtml("#4E73DF"), 1.6f))
            using (var brush = new SolidBrush(pupilColor))
            {
                // outer eye ellipse centered
                int w = 14, h = 10;
                int cx = rect.Left + (rect.Width - w) / 2;
                int cy = rect.Top + (rect.Height - h) / 2;
                g.DrawEllipse(pen, cx, cy, w, h);
                // pupil
                int p = 5;
                g.FillEllipse(brush, rect.Left + rect.Width / 2 - p / 2, rect.Top + rect.Height / 2 - p / 2, p, p);
            }
        }

        private void DrawPencilIcon(Graphics g, Rectangle rect, Color color)
        {
            using (var pen = new Pen(color, 2f))
            using (var brush = new SolidBrush(color))
            {
                // shaft: diagonal line
                g.DrawLine(pen, rect.Left + 6, rect.Bottom - 8, rect.Right - 8, rect.Top + 6);
                // tip: small triangle at right-top
                var tip = new Point[] { new Point(rect.Right - 8, rect.Top + 6), new Point(rect.Right - 4, rect.Top + 10), new Point(rect.Right - 12, rect.Top + 12) };
                g.FillPolygon(brush, tip);
            }
        }

        private void DrawTrashIcon(Graphics g, Rectangle rect, Color color)
        {
