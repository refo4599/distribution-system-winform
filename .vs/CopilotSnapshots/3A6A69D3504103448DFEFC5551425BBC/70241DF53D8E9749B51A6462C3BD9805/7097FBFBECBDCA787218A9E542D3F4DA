        {
            var card = new Guna2ShadowPanel { Dock = DockStyle.Fill, FillColor = Color.White, Radius = 12, Padding = new Padding(12) };
            card.ShadowColor = Color.FromArgb(20, 0, 0, 0);

            // accent strip on the right
