        // helpers
        private Image CreateIconBitmap(string kind, Color color, int size)
        {
            var bmp = new Bitmap(size, size);
            using (var g = Graphics.FromImage(bmp))
            {
                g.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias;
                g.Clear(Color.Transparent);
                using (var pen = new Pen(color, Math.Max(1, size / 8)))
                using (var brush = new SolidBrush(color))
                {
                    if (kind == "search")
                    {
                        g.DrawEllipse(pen, 1, 1, size - 6, size - 6);
                        g.DrawLine(pen, size - 6, size - 6, size - 2, size - 2);
                    }
                    else
                    {
                        g.FillEllipse(brush, size * 0.2f, size * 0.2f, size * 0.6f, size * 0.6f);
                    }
                }
            }
            return bmp;
        }

        private System.Drawing.Drawing2D.GraphicsPath RoundedRectPath(Rectangle r, int radius)
        {
            var path = new System.Drawing.Drawing2D.GraphicsPath();
            int d = radius * 2;
            path.AddArc(r.Left, r.Top, d, d, 180, 90);
            path.AddArc(r.Right - d, r.Top, d, d, 270, 90);
            path.AddArc(r.Right - d, r.Bottom - d, d, d, 0, 90);
            path.AddArc(r.Left, r.Bottom - d, d, d, 90, 90);
            path.CloseFigure();
            return path;
        }

        private Color PickPastelColor(string key)
        {
            var palette = new[] {
                ColorTranslator.FromHtml("#4E73DF"), ColorTranslator.FromHtml("#10B981"), ColorTranslator.FromHtml("#F59E0B"), ColorTranslator.FromHtml("#8B5CF6"), ColorTranslator.FromHtml("#EF4444")
            };
            var hash = (key ?? string.Empty).Aggregate(0, (acc, c) => acc + c);
            return palette[Math.Abs(hash) % palette.Length];
        }
