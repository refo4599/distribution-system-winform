        private void Dgv_CellFormatting_NumbersDates(object sender, DataGridViewCellFormattingEventArgs e)
        {
            if (e.RowIndex < 0) return;
            var col = dgv.Columns[e.ColumnIndex].Name;
            var dto = dgv.Rows[e.RowIndex].DataBoundItem as WarehouseBalanceDto;
            if (dto == null) return;

            if (col == "Balance")
            {
                if (e.Value == null || e.Value == DBNull.Value)
                    e.Value = "0";
                else
                    e.Value = Convert.ToInt32(e.Value).ToString("N0", Invariant);
                e.FormattingApplied = true;
            }
            else if (col == "AvgCost")
            {
                if (e.Value == null || e.Value == DBNull.Value)
                {
                    e.Value = "0.00 جنيه";
                }
                else
                {
                    decimal val = 0m;
                    try { val = Convert.ToDecimal(e.Value); } catch { val = dto.AvgCost; }
                    e.Value = val.ToString("N2", Invariant) + " جنيه";
                }
                e.FormattingApplied = true;
            }
            else if (col == "TotalCost")
            {
                if (e.Value == null || e.Value == DBNull.Value)
                {
                    e.Value = "0.00 جنيه";
                }
                else
                {
                    decimal val = 0m;
                    try { val = Convert.ToDecimal(e.Value); } catch { val = dto.TotalCost; }
                    e.Value = val.ToString("N2", Invariant) + " جنيه";
                }
                e.FormattingApplied = true;
            }
            else if (col == "LastUpdate")
            {
                // Defensive date handling: prefer DTO property if present
                DateTime dt = DateTime.MinValue;
                bool got = false;
                try
                {
                    var prop = dto.GetType().GetProperty("LastUpdated");
                    if (prop != null)
                    {
                        var val = prop.GetValue(dto);
                        if (val is DateTime dtVal && dtVal.Year > 1) { dt = dtVal; got = true; }
                    }
                }
                catch { }

                if (!got)
                {
                    if (e.Value is DateTime dtVal2 && dtVal2.Year > 1) { dt = dtVal2; got = true; }
                    else
                    {
                        // cannot determine valid date
                        e.Value = "—";
                        e.FormattingApplied = true;
                        return;
                    }
                }

                // Force Gregorian using explicit calendar
                var gregorian = new System.Globalization.GregorianCalendar();
                int day = gregorian.GetDayOfMonth(dt);
                int month = gregorian.GetMonth(dt);
                int year = gregorian.GetYear(dt);
                string[] months = { "يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر" };
                e.Value = $"{day} {months[month - 1]} {year}";
                e.FormattingApplied = true;
            }
        }

        private void Dgv_CellClick_Actions(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0 || e.ColumnIndex < 0) return;
            var col = dgv.Columns[e.ColumnIndex];
            if (col.Name != "Actions") return;

            var cursor = dgv.PointToClient(Cursor.Position);
            var cellRect = dgv.GetCellDisplayRectangle(e.ColumnIndex, e.RowIndex, false);
            var relX = cursor.X - cellRect.Left;
            var relY = cursor.Y - cellRect.Top;

            int iconSize = 28; int spacing = 4; int startX = 8; int totalW = iconSize * 3 + spacing * 2;
            var r1 = new Rectangle(startX, (cellRect.Height - iconSize) / 2, iconSize, iconSize);
            var r2 = new Rectangle(r1.Right + spacing, r1.Y, iconSize, iconSize);
            var r3 = new Rectangle(r2.Right + spacing, r2.Y, iconSize, iconSize);

            // translate to cell coords
            var cr1 = new Rectangle(cellRect.Left + r1.Left, cellRect.Top + r1.Top, r1.Width, r1.Height);
            var cr2 = new Rectangle(cellRect.Left + r2.Left, cellRect.Top + r2.Top, r2.Width, r2.Height);
            var cr3 = new Rectangle(cellRect.Left + r3.Left, cellRect.Top + r3.Top, r3.Width, r3.Height);

            var dto = dgv.Rows[e.RowIndex].DataBoundItem as WarehouseBalanceDto;
            if (dto == null) return;

            var clickPt = new Point(cursor.X, cursor.Y);
            if (cr1.Contains(clickPt)) OnView(dto);
            else if (cr2.Contains(clickPt)) OnEdit(dto);
            else if (cr3.Contains(clickPt)) OnDelete(dto);
        }

