        private void RefreshData(int page)
        {
            _page = page < 1 ? 1 : page;
            _allBalances = _service.GetAllBalances()?.ToList() ?? new List<WarehouseBalanceDto>();

            var q = txtSearch?.Text?.Trim() ?? string.Empty;
            IEnumerable<WarehouseBalanceDto> filtered = _allBalances;
            if (!string.IsNullOrEmpty(q)) filtered = filtered.Where(x => !string.IsNullOrEmpty(x.ProductName) && x.ProductName.IndexOf(q, StringComparison.OrdinalIgnoreCase) >= 0);

            var totalCount = filtered.Count();
            var totalPages = Math.Max(1, (int)Math.Ceiling((double)totalCount / _pageSize));
            if (_page > totalPages) _page = totalPages;

            var pageItems = filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
            foreach (var it in pageItems) it.TotalCost = it.Balance * it.AvgCost;

            dgv.DataSource = new BindingSource { DataSource = pageItems };

            UpdateSummaryCards();
            UpdateTotals();
            UpdatePagination(totalCount);
        }

        private void UpdateSummaryCards()
        {
            var distinct = _allBalances.Select(x => x.ProductId).Distinct().Count();
            var qty = _allBalances.Where(x => x.Balance > 0).Sum(x => x.Balance);
            var totalValue = _allBalances.Sum(x => x.Balance * x.AvgCost);
            var denom = _allBalances.Sum(x => x.Balance);
            var avg = denom != 0 ? _allBalances.Sum(x => x.Balance * x.AvgCost) / denom : 0m;

            pnlCards.Controls.Clear();
            pnlCards.Controls.Add(MakeCard("عدد المنتجات", distinct.ToString("N0", Invariant), ColorTranslator.FromHtml("#4E73DF"), "📦"));
            pnlCards.Controls.Add(MakeCard("إجمالي الكمية", qty.ToString("N0", Invariant), ColorTranslator.FromHtml("#10B981"), "📊"));
            pnlCards.Controls.Add(MakeCard("متوسط التكلفة", avg.ToString("N2", Invariant) + " جنيه", ColorTranslator.FromHtml("#F6C23E"), "💰"));
            pnlCards.Controls.Add(MakeCard("قيمة المخزون", totalValue.ToString("N2", Invariant) + " جنيه", ColorTranslator.FromHtml("#E74A3B"), "🏪"));
        }

        private Guna2ShadowPanel MakeCard(string title, string value, Color accent, string emoji)
        {
            var card = new Guna2ShadowPanel { Dock = DockStyle.Fill, FillColor = Color.White, Radius = 12, Padding = new Padding(12) };
            card.ShadowColor = Color.FromArgb(20, 0, 0, 0);
            var strip = new Panel { Dock = DockStyle.Left, Width = 4, BackColor = accent }; card.Controls.Add(strip);
            var pic = new Label { Text = emoji, Dock = DockStyle.Right, Width = 36, TextAlign = ContentAlignment.MiddleCenter, Font = new Font("Segoe UI Symbol", 14F) }; card.Controls.Add(pic);
            var lblVal = new Label { Text = value, Dock = DockStyle.Fill, Font = new Font("Cairo", 22F, FontStyle.Bold), ForeColor = ColorTranslator.FromHtml("#1A1D23"), TextAlign = ContentAlignment.MiddleLeft };
            var lblTitle = new Label { Text = title, Dock = DockStyle.Bottom, Height = 20, Font = new Font("Cairo", 9F), ForeColor = ColorTranslator.FromHtml("#6C757D"), TextAlign = ContentAlignment.MiddleLeft };
            card.Controls.Add(lblVal); card.Controls.Add(lblTitle);
            return card;
        }

        private void UpdateTotals()
        {
            try
            {
                var total = _service.GetTotalInventoryValue();
                var count = _allBalances.Select(x => x.ProductId).Distinct().Count();
                lblSummary.Text = $"إجمالي قيمة المخزون: {total.ToString("N2", Invariant)} جنيه | عدد المنتجات: {count.ToString("N0", Invariant)}";
            }
            catch
            {
                lblSummary.Text = "إجمالي قيمة المخزون: N/A";
            }
        }

        private void UpdatePagination(int totalCount)
        {
            pnlPagination.Controls.Clear();
            var totalPages = Math.Max(1, (int)Math.Ceiling((double)totalCount / _pageSize));

            var btnPrev = new Guna2Button { Text = "السابق", Width = 90, Height = 36, BorderRadius = 8 };
            btnPrev.FillColor = Color.White; btnPrev.BorderColor = ColorTranslator.FromHtml("#E6EEF9"); btnPrev.ForeColor = ColorTranslator.FromHtml("#4E73DF"); btnPrev.Enabled = _page > 1; btnPrev.Click += (s, e) => RefreshData(_page - 1);

            var btnNext = new Guna2Button { Text = "التالي", Width = 90, Height = 36, BorderRadius = 8 };
            btnNext.FillColor = Color.White; btnNext.BorderColor = ColorTranslator.FromHtml("#4E73DF"); btnNext.ForeColor = ColorTranslator.FromHtml("#4E73DF"); btnNext.Enabled = _page < totalPages; btnNext.Click += (s, e) => RefreshData(_page + 1);

            lblPageInfo.Text = $"صفحة {_page} من {totalPages}";

            pnlPagination.Controls.Add(btnPrev);
            var start = Math.Max(1, _page - 2);
            var end = Math.Min(totalPages, start + 4);
            for (int i = start; i <= end; i++)
            {
                var b = new Guna2Button { Text = i.ToString(), Width = 40, Height = 36, BorderRadius = 8 };
                if (i == _page) { b.FillColor = ColorTranslator.FromHtml("#4E73DF"); b.ForeColor = Color.White; }
                else { b.FillColor = Color.FromArgb(245, 247, 250); b.ForeColor = Color.FromArgb(60, 70, 80); }
                var pi = i; b.Click += (s, e) => RefreshData(pi);
                pnlPagination.Controls.Add(b);
            }
            pnlPagination.Controls.Add(btnNext);
            pnlPagination.Controls.Add(lblPageInfo);
        }

        // Painting avatar in ProductName cell (column index 0) and small action icons in Actions cell
        private void Dgv_CellPainting_AvatarAndActions(object sender, DataGridViewCellPaintingEventArgs e)
        {
            if (e.RowIndex < 0) return;

            // product column is index 0
            if (e.ColumnIndex == 0)
            {
                e.Handled = true;

                // Step 1: paint background (respecting selection and alternating rows)
                e.PaintBackground(e.CellBounds, true);

                var dto = dgv.Rows[e.RowIndex].DataBoundItem as WarehouseBalanceDto;

                // Step 2: compute circle
                int avatarSize = 36;
                int circleX = e.CellBounds.Right - 46; // as specified
                int circleY = e.CellBounds.Top + (e.CellBounds.Height - avatarSize) / 2;
                var circleRect = new Rectangle(circleX, circleY, avatarSize, avatarSize);

                var colors = new[] { ColorTranslator.FromHtml("#4E73DF"), ColorTranslator.FromHtml("#10B981"), ColorTranslator.FromHtml("#F59E0B"), ColorTranslator.FromHtml("#8B5CF6"), ColorTranslator.FromHtml("#EF4444") };
                var bg = colors[e.RowIndex % colors.Length];
                using (var b = new SolidBrush(bg)) e.Graphics.FillEllipse(b, circleRect);

                // Step 3: initial
                var initial = dto != null && !string.IsNullOrEmpty(dto.ProductName) ? dto.ProductName.Trim()[0].ToString() : "#";
                using (var f = new Font("Cairo", 13F, FontStyle.Bold, GraphicsUnit.Pixel))
                using (var sb = new SolidBrush(Color.White))
                {
                    var sz = e.Graphics.MeasureString(initial, f);
                    e.Graphics.DrawString(initial, f, sb, circleRect.Left + (circleRect.Width - sz.Width) / 2, circleRect.Top + (circleRect.Height - sz.Height) / 2);
                }

                // Step 4: product name to left of circle
                using (var f = new Font("Cairo", 11F, FontStyle.Regular))
                using (var sb = new SolidBrush(ColorTranslator.FromHtml("#1A1D23")))
                {
                    var text = dto != null ? dto.ProductName : Convert.ToString(e.Value);
                    var textRect = new Rectangle(e.CellBounds.Left + 8, e.CellBounds.Top + 8, circleRect.Left - (e.CellBounds.Left + 16), e.CellBounds.Height - 16);
                    TextRenderer.DrawText(e.Graphics, text, f, textRect, ColorTranslator.FromHtml("#1A1D23"), TextFormatFlags.Right | TextFormatFlags.VerticalCenter | TextFormatFlags.EndEllipsis);
                }

                // selection border
                if (e.State.HasFlag(DataGridViewElementStates.Selected))
                {
                    using (var pen = new Pen(ColorTranslator.FromHtml("#EBF3FF"), 2))
                    {
                        var r = e.CellBounds; r.Inflate(-1, -1);
                        e.Graphics.DrawRectangle(pen, r);
                    }
                }
            }
            else
            {
                var col = dgv.Columns[e.ColumnIndex].Name;
                if (col == "Actions")
                {
                    e.Handled = true;
                    e.PaintBackground(e.CellBounds, true);

                    int iconSize = 20; int spacing = 6; // small icons
                    int totalW = iconSize * 3 + spacing * 2;
                    int startX = e.CellBounds.Left + (e.CellBounds.Width - totalW) / 2;
                    int y = e.CellBounds.Top + (e.CellBounds.Height - iconSize) / 2;

                    var r1 = new Rectangle(startX, y, iconSize, iconSize);
                    var r2 = new Rectangle(r1.Right + spacing, y, iconSize, iconSize);
                    var r3 = new Rectangle(r2.Right + spacing, y, iconSize, iconSize);

                    DrawColoredCircleWithGlyph(e.Graphics, r1, ColorTranslator.FromHtml("#4E73DF"), "eye");
                    DrawColoredCircleWithGlyph(e.Graphics, r2, ColorTranslator.FromHtml("#10B981"), "edit");
                    DrawColoredCircleWithGlyph(e.Graphics, r3, ColorTranslator.FromHtml("#EF4444"), "trash");
                }
            }
        }

        private void DrawColoredCircleWithGlyph(Graphics g, Rectangle rect, Color bg, string kind)
        {
            using (var b = new SolidBrush(bg)) g.FillEllipse(b, rect);
            using (var pen = new Pen(Color.White, 1.2f))
            using (var brush = new SolidBrush(Color.White))
            {
                if (kind == "eye")
                {
                    var rx = rect.Left + 1; var ry = rect.Top + rect.Height / 4;
                    g.DrawEllipse(pen, rx, ry, rect.Width - 2, rect.Height / 2);
                    g.FillEllipse(brush, rect.Left + rect.Width / 2 - 3, rect.Top + rect.Height / 2 - 3, 6, 6);
                }
                else if (kind == "edit")
                {
                    g.DrawLine(pen, rect.Left + 4, rect.Bottom - 6, rect.Right - 4, rect.Top + 4);
                    g.DrawRectangle(pen, rect.Right - 8, rect.Top + 2, 5, 5);
                }
                else // trash
                {
                    g.DrawRectangle(pen, rect.Left + 4, rect.Top + 6, rect.Width - 8, rect.Height - 10);
                    g.DrawLine(pen, rect.Left + 6, rect.Top + 6, rect.Right - 6, rect.Bottom - 6);
                }
            }
        }

        private void Dgv_CellFormatting_NumbersDates(object sender, DataGridViewCellFormattingEventArgs e)
        {
            if (e.RowIndex < 0) return;
            var col = dgv.Columns[e.ColumnIndex].Name;
            var dto = dgv.Rows[e.RowIndex].DataBoundItem as WarehouseBalanceDto;
            if (dto == null) return;

            if (col == "Balance")
            {
                e.Value = dto.Balance.ToString("N0", Invariant);
                e.FormattingApplied = true;
            }
            else if (col == "AvgCost")
            {
                e.Value = dto.AvgCost.ToString("N2", Invariant) + " جنيه";
                e.FormattingApplied = true;
            }
            else if (col == "TotalCost")
            {
                e.Value = dto.TotalCost.ToString("N2", Invariant) + " جنيه";
                e.FormattingApplied = true;
            }
            else if (col == "LastUpdate")
            {
                // display using Arabic month names but numeric formats are invariant
                var dt = DateTime.Now;
                e.Value = dt.ToString("dd MMMM yyyy", Arabic);
                e.FormattingApplied = true;
            }
        }

        private void Dgv_MouseClick_Actions(object sender, MouseEventArgs e)
        {
            var hit = dgv.HitTest(e.X, e.Y);
            if (hit.Type != DataGridViewHitTestType.Cell) return;
            var col = dgv.Columns[hit.ColumnIndex];
            if (col.Name != "Actions") return;

            var cellRect = dgv.GetCellDisplayRectangle(hit.ColumnIndex, hit.RowIndex, false);
            var relX = e.X - cellRect.Left;
            var relY = e.Y - cellRect.Top;

            int iconSize = 20; int spacing = 6;
            int totalW = iconSize * 3 + spacing * 2;
            int startX = (cellRect.Width - totalW) / 2;
            var r1 = new Rectangle(startX, (cellRect.Height - iconSize) / 2, iconSize, iconSize);
            var r2 = new Rectangle(r1.Right + spacing, r1.Y, iconSize, iconSize);
            var r3 = new Rectangle(r2.Right + spacing, r2.Y, iconSize, iconSize);

            var clickedX = relX;
            var dto = dgv.Rows[hit.RowIndex].DataBoundItem as WarehouseBalanceDto;
            if (dto == null) return;

            if (r1.Contains(clickedX, relY)) OnView(dto);
            else if (r2.Contains(clickedX, relY)) OnEdit(dto);
            else if (r3.Contains(clickedX, relY)) OnDelete(dto);
        }

