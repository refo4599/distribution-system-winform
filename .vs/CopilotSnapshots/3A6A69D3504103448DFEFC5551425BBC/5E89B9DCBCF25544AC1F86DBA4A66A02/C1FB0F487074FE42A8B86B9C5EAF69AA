using System;
using System.Collections.Generic;
using System.Data;
using System.Data.SqlClient;
using System.Linq;
using DistributionSystem.Data.Data;
using DistributionSystem.Data.Dtos;
using DistributionSystem.Data.Entities;
using DistributionSystem.Data.Interfaces;

namespace DistributionSystem.Data.Repositories
{
    public class WarehouseRepository : BaseRepository, IWarehouseRepository
    {
        public WarehouseRepository(SqlConnectionFactory connectionFactory) : base(connectionFactory)
        {
        }

        public Dtos.PagedResult<WarehouseBalanceDataDto> GetWarehouseBalances(int page, int pageSize, string searchTerm)
        {
            var result = new Dtos.PagedResult<WarehouseBalanceDataDto>
            {
                Page = page,
                PageSize = pageSize,
                Items = new List<WarehouseBalanceDataDto>()
            };

            try
            {
                using (var conn = Connection)
                using (var cmd = conn.CreateCommand())
                {
                    conn.Open();

                    var offset = Math.Max(0, (page - 1)) * pageSize;

                    cmd.CommandText = @"SELECT p.Id AS ProductId, p.Name AS ProductName,
    ISNULL(SUM(CASE WHEN wt.TransactionType IN ('Inbound','Return','وارد','رصيد افتتاحي') THEN wt.Quantity
                  WHEN wt.TransactionType IN ('CarLoad','Outbound') THEN -wt.Quantity
                  ELSE 0 END),0) AS Balance,
    CASE WHEN SUM(wt.Quantity) = 0 THEN 0 ELSE CAST(SUM(wt.Quantity * wt.UnitCost) / SUM(wt.Quantity) AS DECIMAL(18,6)) END AS AvgCost,
    CAST(ISNULL(SUM(wt.Quantity * wt.UnitCost),0) AS DECIMAL(18,2)) AS TotalCost
FROM dbo.Products p
LEFT JOIN dbo.WarehouseTransactions wt ON wt.ProductId = p.Id
WHERE (@Search IS NULL OR p.Name LIKE '%' + @Search + '%')
GROUP BY p.Id, p.Name
ORDER BY p.Name
OFFSET @Offset ROWS FETCH NEXT @PageSize ROWS ONLY;";

                    cmd.Parameters.Add(new SqlParameter("@Search", SqlDbType.NVarChar, 200) { Value = string.IsNullOrWhiteSpace(searchTerm) ? (object)DBNull.Value : searchTerm });
                    cmd.Parameters.Add(new SqlParameter("@Offset", SqlDbType.Int) { Value = offset });
                    cmd.Parameters.Add(new SqlParameter("@PageSize", SqlDbType.Int) { Value = pageSize });

                    using (var reader = cmd.ExecuteReader())
                    {
                        var list = new List<WarehouseBalanceDataDto>();
                        while (reader.Read())
                        {
                            list.Add(new WarehouseBalanceDataDto
                            {
                                ProductId = reader.GetInt32(0),
                                ProductName = reader.IsDBNull(1) ? string.Empty : reader.GetString(1),
                                Balance = reader.IsDBNull(2) ? 0 : reader.GetInt32(2),
                                AvgCost = reader.IsDBNull(3) ? 0m : reader.GetDecimal(3),
                                TotalCost = reader.IsDBNull(4) ? 0m : reader.GetDecimal(4)
                            });
                        }

                        result.Items = list;
                    }

                    // total count
                    using (var countCmd = conn.CreateCommand())
                    {
                        countCmd.CommandText = "SELECT COUNT(1) FROM dbo.Products p WHERE (@Search IS NULL OR p.Name LIKE '%' + @Search + '%')";
                        countCmd.Parameters.Add(new SqlParameter("@Search", SqlDbType.NVarChar, 200) { Value = string.IsNullOrWhiteSpace(searchTerm) ? (object)DBNull.Value : searchTerm });
                        result.TotalCount = Convert.ToInt32(countCmd.ExecuteScalar());
                    }
                }
            }
            catch (Exception)
            {
                throw;
            }

            return result;
        }

        public decimal? GetProductAverageCost(int productId)
        {
            try
            {
                using (var conn = Connection)
                using (var cmd = new SqlCommand(@"SELECT CASE WHEN SUM(Quantity) = 0 THEN NULL ELSE CAST(SUM(Quantity * UnitCost) / SUM(Quantity) AS DECIMAL(18,6)) END FROM dbo.WarehouseTransactions WITH (UPDLOCK, HOLDLOCK) WHERE ProductId = @ProductId", conn))
                {
                    cmd.Parameters.Add(new SqlParameter("@ProductId", SqlDbType.Int) { Value = productId });
                    conn.Open();
                    var res = cmd.ExecuteScalar();
                    if (res == DBNull.Value || res == null) return null;
                    return Convert.ToDecimal(res);
                }
            }
            catch (Exception)
            {
                throw;
            }
        }

        public decimal GetTotalInventoryValue()
        {
            try
            {
                using (var conn = Connection)
                using (var cmd = conn.CreateCommand())
                {
                    cmd.CommandText = "SELECT ISNULL(SUM(Quantity * UnitCost),0) FROM dbo.WarehouseTransactions";
                    conn.Open();
                    return Convert.ToDecimal(cmd.ExecuteScalar());
                }
            }
            catch (Exception)
            {
                throw;
            }
        }

        public int GetProductBalance(int productId)
        {
            try
            {
                using (var conn = Connection)
                using (var cmd = conn.CreateCommand())
                {
                    cmd.CommandText = @"SELECT ISNULL(SUM(CASE WHEN TransactionType IN ('Inbound','Return','وارد','رصيد افتتاحي') THEN Quantity WHEN TransactionType IN ('CarLoad','Outbound') THEN -Quantity ELSE 0 END),0) FROM dbo.WarehouseTransactions WHERE ProductId = @ProductId";
                    cmd.Parameters.Add(new SqlParameter("@ProductId", SqlDbType.Int) { Value = productId });
                    conn.Open();
                    return Convert.ToInt32(cmd.ExecuteScalar());
                }
            }
            catch (Exception)
            {
                throw;
            }
        }

        public int AddTransaction(WarehouseTransaction tx)
        {
            using (var conn = Connection)
            {
                conn.Open();
                using (var tran = conn.BeginTransaction())
                {
                    try
                    {
                        var id = AddTransaction(tx, conn, tran);
                        tran.Commit();
                        return id;
                    }
                    catch (Exception)
                    {
                        try { tran.Rollback(); } catch { }
                        throw;
                    }
                }
            }
        }

        public int AddTransaction(WarehouseTransaction tx, SqlConnection connection, SqlTransaction transaction)
        {
            if (tx == null) throw new ArgumentNullException(nameof(tx));
            try
            {
                using (var cmd = connection.CreateCommand())
                {
                    cmd.Transaction = transaction;
                    cmd.CommandText = @"INSERT INTO dbo.WarehouseTransactions (ProductId, Quantity, UnitCost, TransactionType, ReferenceId, CreatedAt, CreatedBy) VALUES (@ProductId, @Quantity, @UnitCost, @TransactionType, @ReferenceId, @CreatedAt, @CreatedBy); SELECT CAST(SCOPE_IDENTITY() AS INT);";
                    cmd.CommandType = CommandType.Text;

                    cmd.Parameters.Add(new SqlParameter("@ProductId", SqlDbType.Int) { Value = tx.ProductId });
                    cmd.Parameters.Add(new SqlParameter("@Quantity", SqlDbType.Int) { Value = tx.Quantity });
                    var unitParam = new SqlParameter("@UnitCost", SqlDbType.Decimal) { Precision = 18, Scale = 6 };
                    unitParam.Value = tx.UnitCost;
                    cmd.Parameters.Add(unitParam);

                    cmd.Parameters.Add(new SqlParameter("@TransactionType", SqlDbType.NVarChar, 50) { Value = tx.TransactionType });

                    var refParam = new SqlParameter("@ReferenceId", SqlDbType.Int);
                    if (tx.ReferenceId.HasValue) refParam.Value = tx.ReferenceId.Value; else refParam.Value = DBNull.Value;
                    cmd.Parameters.Add(refParam);

                    cmd.Parameters.Add(new SqlParameter("@CreatedAt", SqlDbType.DateTime2) { Value = tx.CreatedAt });
                    cmd.Parameters.Add(new SqlParameter("@CreatedBy", SqlDbType.NVarChar, 100) { Value = tx.CreatedBy ?? (object)DBNull.Value });

                    var result = cmd.ExecuteScalar();
                    return Convert.ToInt32(result);
                }
            }
            catch (Exception)
            {
                throw;
            }
        }

        public WarehouseTransaction GetTransactionById(int transactionId)
        {
            try
            {
                using (var conn = Connection)
                using (var cmd = conn.CreateCommand())
                {
                    cmd.CommandText = @"SELECT Id, ProductId, Quantity, UnitCost, TransactionType, ReferenceId, CreatedAt, CreatedBy FROM dbo.WarehouseTransactions WHERE Id = @Id";
                    cmd.Parameters.Add(new SqlParameter("@Id", SqlDbType.Int) { Value = transactionId });
                    conn.Open();
                    using (var rdr = cmd.ExecuteReader())
                    {
                        if (rdr.Read())
                        {
                            return new WarehouseTransaction
                            {
                                Id = rdr.GetInt32(0),
                                ProductId = rdr.GetInt32(1),
                                Quantity = rdr.GetInt32(2),
                                UnitCost = rdr.GetDecimal(3),
                                TransactionType = rdr.GetString(4),
                                ReferenceId = rdr.IsDBNull(5) ? (int?)null : rdr.GetInt32(5),
                                CreatedAt = rdr.GetDateTime(6),
                                CreatedBy = rdr.IsDBNull(7) ? null : rdr.GetString(7)
                            };
                        }
                    }
                }

                return null;
            }
            catch (Exception)
            {
                throw;
            }
        }

