using System;
using System.Linq;
using DistributionSystem.Data.Interfaces;
using DistributionSystem.Data.Entities;
using DistributionSystem.Business.Dtos;

namespace DistributionSystem.Business.Services
{
    public class WarehouseServiceImplement : BaseService, IWarehouseService
    {
        private readonly IWarehouseRepository _repo;

        public WarehouseServiceImplement(IWarehouseRepository repo)
        {
            _repo = repo;
        }

        public PagedResult<WarehouseBalanceDto> GetWarehouseBalances(int page, int pageSize, string searchTerm)
        {
            return Execute(() =>
            {
                var pageData = _repo.GetWarehouseBalances(page, pageSize, searchTerm);
                var dto = new PagedResult<WarehouseBalanceDto>
                {
                    Page = pageData.Page,
                    PageSize = pageData.PageSize,
                    TotalCount = pageData.TotalCount,
                    Items = pageData.Items.Select(item => new WarehouseBalanceDto
                    {
                        ProductId = item.ProductId,
                        ProductName = item.ProductName,
                        Balance = item.Balance,
                        AvgCost = item.AvgCost,
                        TotalCost = item.TotalCost
                    }).ToList()
                };

                return dto;
            });
        }

        public decimal GetProductAverageCost(int productId)
        {
            return Execute(() => _repo.GetProductAverageCost(productId) ?? 0m);
        }

        public decimal GetTotalInventoryValue()
        {
            return Execute(() => _repo.GetTotalInventoryValue());
        }

        public void ProcessInbound(int productId, int quantity, decimal purchasePrice, string createdBy, int? referenceId = null)
        {
            Execute(() =>
            {
                if (quantity <= 0) throw new ArgumentException("Quantity must be greater than zero.");
                if (purchasePrice < 0) throw new ArgumentException("Purchase price must be >= 0");

                var tx = new WarehouseTransaction
                {
                    ProductId = productId,
                    Quantity = quantity,
                    UnitCost = purchasePrice,
                    TransactionType = "Inbound",
                    ReferenceId = referenceId,
                    CreatedAt = DateTime.UtcNow,
                    CreatedBy = createdBy
                };

                _repo.AddTransaction(tx);
            });
        }

        public void ProcessOutbound(int productId, int quantity, string createdBy, int? referenceId = null)
        {
            Execute(() =>
            {
                if (quantity <= 0) throw new ArgumentException("Quantity must be greater than zero.");

                var avg = _repo.GetProductAverageCost(productId);
                if (!avg.HasValue) throw new InvalidOperationException("Cannot process outbound: no stock or average unavailable.");

                var balance = _repo.GetProductBalance(productId);
                if (balance < quantity) throw new InvalidOperationException("Insufficient stock for outbound.");

                var tx = new WarehouseTransaction
                {
                    ProductId = productId,
                    Quantity = -quantity,
                    UnitCost = avg.Value,
                    TransactionType = "Outbound",
                    ReferenceId = referenceId,
                    CreatedAt = DateTime.UtcNow,
                    CreatedBy = createdBy
                };

                _repo.AddTransaction(tx);
            });
        }

        public void ProcessReturn(int originalTransactionId, int quantity, string createdBy, int? referenceId = null)
        {
            Execute(() =>
            {
                if (quantity <= 0) throw new ArgumentException("Quantity must be greater than zero.");

                var original = _repo.GetTransactionById(originalTransactionId);
                if (original == null) throw new ArgumentException("Original transaction not found.");

                var tx = new WarehouseTransaction
                {
                    ProductId = original.ProductId,
                    Quantity = quantity,
                    UnitCost = original.UnitCost,
                    TransactionType = "Return",
                    ReferenceId = referenceId,
                    CreatedAt = DateTime.UtcNow,
                    CreatedBy = createdBy
                };

                _repo.AddTransaction(tx);
            });
        }
    }
}
