using System.Collections.Generic;
using System.Data.SqlClient;
using DistributionSystem.Data.Entities;

namespace DistributionSystem.Data.Interfaces
{
    public interface IWarehouseTransactionRepository
    {
        int AddTransaction(WarehouseTransaction tx);
        int AddTransaction(WarehouseTransaction tx, SqlConnection connection, SqlTransaction transaction);
        int GetProductBalance(int productId);
        IEnumerable<System.Tuple<int,int>> GetAllBalances();

        // Returns weighted average cost or null when there is no stock
        decimal? GetProductAverageCost(int productId);

        // Total inventory value across all products: SUM(Quantity * UnitCost)
        decimal GetTotalInventoryValue();

        // Create an outbound transaction (negative quantity) safely within caller's connection/transaction
        int CreateOutboundTransaction(int productId, int quantity, string transactionType, int? referenceId, SqlConnection connection, SqlTransaction transaction);

        // Get the unit cost (PurchasePrice) recorded for a specific warehouse transaction
        decimal? GetTransactionUnitCost(int transactionId);
    }
}
