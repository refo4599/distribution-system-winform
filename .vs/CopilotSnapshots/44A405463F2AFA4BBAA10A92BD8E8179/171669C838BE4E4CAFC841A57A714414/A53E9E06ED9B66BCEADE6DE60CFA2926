        {
            var card = new Panel
            {
                Dock = DockStyle.Fill,
                BackColor = Color.White,
                Padding = new Padding(0)
            };
            // Rounded shadow via Guna panel wrapper
            var shadow = new Guna2Panel { Dock = DockStyle.Fill, FillColor = Color.White, BorderRadius = 16 };
            shadow.ShadowDecoration.Enabled = true;
            shadow.ShadowDecoration.Color = Color.FromArgb(14, 0, 0, 0);
            shadow.ShadowDecoration.Depth = 7;

            // Header bar
            var header = new Panel { Dock = DockStyle.Top, Height = 52, BackColor = Color.White, Padding = new Padding(16, 8, 16, 8) };

            var pnlRight = new FlowLayoutPanel { Dock = DockStyle.Right, AutoSize = true, FlowDirection = FlowDirection.RightToLeft, BackColor = Color.Transparent, WrapContents = false };
            var lblTitle = new Label { Text = "قائمة المنتجات", Font = new Font("Cairo", 13F, FontStyle.Bold), ForeColor = ColorTranslator.FromHtml("#1A1D23"), AutoSize = true, Margin = new Padding(0, 4, 6, 0) };
            lblCountBadge = new Label { Text = "0 منتج", Font = new Font("Cairo", 9F, FontStyle.Bold), ForeColor = ColorTranslator.FromHtml("#4E73DF"), BackColor = ColorTranslator.FromHtml("#EEF2FF"), AutoSize = true, Padding = new Padding(10, 5, 10, 5), Margin = new Padding(0, 2, 0, 0) };
            pnlRight.Controls.Add(lblCountBadge);
            pnlRight.Controls.Add(lblTitle);

            txtSearch = new Guna2TextBox
            {
