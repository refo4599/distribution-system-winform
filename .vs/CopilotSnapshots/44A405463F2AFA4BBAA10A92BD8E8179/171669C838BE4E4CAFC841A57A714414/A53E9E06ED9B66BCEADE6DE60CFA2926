        // ══════════════════════════════════════════════════════
        //  LAYOUT
        // ══════════════════════════════════════════════════════
        private void BuildLayout()
        {
            var root = new TableLayoutPanel
            {
                Dock = DockStyle.Fill,
                ColumnCount = 1,
                RowCount = 3,
                BackColor = Color.Transparent,
                Padding = new Padding(0)
            };
            // header (page header) + search + table
            root.RowStyles.Add(new RowStyle(SizeType.Absolute, 52F));   // header
            root.RowStyles.Add(new RowStyle(SizeType.Absolute, 48F));   // search
            root.RowStyles.Add(new RowStyle(SizeType.Percent, 100F));   // table
            Controls.Add(root);

            root.Controls.Add(BuildPageHeader(), 0, 0);
            root.Controls.Add(BuildSearchRow(), 0, 1);
            root.Controls.Add(BuildTableCard(), 0, 2);
        }

