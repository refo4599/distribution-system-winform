        // ── Search row below header ───────────────────────────
        private Panel BuildSearchRow()
        {
            var pnlSearchRow = new Panel();
            pnlSearchRow.Dock = DockStyle.Top;
            pnlSearchRow.Height = 48;
            pnlSearchRow.BackColor = Color.Transparent;
            pnlSearchRow.Padding = new Padding(0, 4, 0, 8);

            txtSearch = new Guna2TextBox();
            txtSearch.Width = 240;
            txtSearch.Height = 38;
            txtSearch.BorderRadius = 10;
            txtSearch.PlaceholderText = "ابحث عن منتج...";
            txtSearch.FillColor = Color.White;
            txtSearch.BorderColor = ColorTranslator.FromHtml("#E5E7EB");
            txtSearch.FocusedState.BorderColor = ColorTranslator.FromHtml("#4E73DF");
            txtSearch.Font = new Font("Cairo", 11F);
            txtSearch.Dock = DockStyle.Right;
            txtSearch.TextChanged += (s, e) => { _searchTimer?.Dispose(); _searchTimer = new System.Threading.Timer(_ => Invoke(new Action(LoadProducts)), null, 280, System.Threading.Timeout.Infinite); };

