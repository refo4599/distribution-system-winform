        private void BuildGridColumns()
        {
            dgvProducts.Columns.Clear();
            var colProduct = new DataGridViewTextBoxColumn { Name = "Product", HeaderText = "المنتج", Width = 240, DataPropertyName = "Name" };
            var colPurchase = new DataGridViewTextBoxColumn { Name = "PurchasePrice", HeaderText = "سعر الشراء", Width = 160, DataPropertyName = "PurchasePrice" };
            var colSale = new DataGridViewTextBoxColumn { Name = "SalePrice", HeaderText = "سعر البيع", Width = 160, DataPropertyName = "SalePrice" };
            var colStatus = new DataGridViewTextBoxColumn { Name = "Status", HeaderText = "الحالة", Width = 100 };
            var colActions = new DataGridViewTextBoxColumn { Name = "Actions", HeaderText = "الإجراءات", Width = 110 };
            dgvProducts.Columns.Add(colProduct); dgvProducts.Columns.Add(colPurchase); dgvProducts.Columns.Add(colSale); dgvProducts.Columns.Add(colStatus); dgvProducts.Columns.Add(colActions);
            foreach (DataGridViewColumn c in dgvProducts.Columns) c.DefaultCellStyle.Alignment = DataGridViewContentAlignment.MiddleCenter;
        }

        private System.Threading.Timer _searchTimer;
        private void StartSearchDelay() { _searchTimer?.Dispose(); _searchTimer = new System.Threading.Timer(_ => this.Invoke(new Action(() => LoadProducts())), null, 300, System.Threading.Timeout.Infinite); }

        private void LoadProducts()
        {
            var list = _service.GetAll()?.ToList() ?? new List<ProductDto>();
            var q = txtSearch?.Text?.Trim() ?? string.Empty;
            if (!string.IsNullOrEmpty(q)) list = list.Where(x => x.Name != null && x.Name.IndexOf(q, StringComparison.OrdinalIgnoreCase) >= 0).ToList();
            dgvProducts.DataSource = new BindingSource { DataSource = list };
            FitColumnsToWidth(); UpdateProductCount(list.Count); ClearSelectionState();
        }

        private void UpdateProductCount(int count) => lblCountBadge.Text = $"{count} منتج";

        private void FitColumnsToWidth()
        {
            if (dgvProducts.Columns.Count == 0) return; int total = dgvProducts.ClientSize.Width; if (total <= 0) return;
            int wProduct = (int)(total * 0.40); int wPrice = (int)(total * 0.18); int wStatus = (int)(total * 0.12); int wActions = total - (wProduct + wPrice + wPrice + wStatus);
            if (dgvProducts.Columns.Contains("Product")) dgvProducts.Columns["Product"].Width = Math.Max(160, wProduct);
            if (dgvProducts.Columns.Contains("PurchasePrice")) dgvProducts.Columns["PurchasePrice"].Width = Math.Max(100, wPrice);
            if (dgvProducts.Columns.Contains("SalePrice")) dgvProducts.Columns["SalePrice"].Width = Math.Max(100, wPrice);
            if (dgvProducts.Columns.Contains("Status")) dgvProducts.Columns["Status"].Width = Math.Max(80, wStatus);
            if (dgvProducts.Columns.Contains("Actions")) dgvProducts.Columns["Actions"].Width = Math.Max(90, wActions);
        }

        private void ClearSelectionState() { _selectedProductId = 0; btnEdit.Enabled = false; btnDelete.Enabled = false; txtName.BorderColor = ColorTranslator.FromHtml("#E5E7EB"); txtPurchasePrice.BorderColor = ColorTranslator.FromHtml("#E5E7EB"); txtSalePrice.BorderColor = ColorTranslator.FromHtml("#E5E7EB"); dgvProducts.ClearSelection(); }

        private void DgvProducts_SelectionChanged(object sender, EventArgs e) { if (dgvProducts.CurrentRow?.DataBoundItem is ProductDto dto) { _selectedProductId = dto.Id; txtName.Text = dto.Name; txtPurchasePrice.Text = dto.PurchasePrice.ToString("N2", Invariant); txtSalePrice.Text = dto.SalePrice.ToString("N2", Invariant); btnEdit.Enabled = true; btnDelete.Enabled = true; } else ClearSelectionState(); }

        // Replaced Add handler with in-card validation logic per spec
        private void BtnAdd_Click(object sender, EventArgs e)
        {
            // Reset borders
            txtName.BorderColor = Color.FromArgb(229, 231, 235);
            txtPurchasePrice.BorderColor = Color.FromArgb(229, 231, 235);
            txtSalePrice.BorderColor = Color.FromArgb(229, 231, 235);

            bool valid = true;

            if (string.IsNullOrWhiteSpace(txtName.Text))
            {
                txtName.BorderColor = Color.FromArgb(239, 68, 68);
                valid = false;
            }

            decimal purchase = 0, sale = 0;
            if (!decimal.TryParse(txtPurchasePrice.Text,
                System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture,
                out purchase) || purchase <= 0)
            {
                txtPurchasePrice.BorderColor = Color.FromArgb(239, 68, 68);
                valid = false;
            }

            if (!decimal.TryParse(txtSalePrice.Text,
                System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture,
                out sale) || sale <= 0)
            {
                txtSalePrice.BorderColor = Color.FromArgb(239, 68, 68);
                valid = false;
            }

            if (!valid)
            {
                MessageBox.Show("يرجى تعبئة جميع الحقول المطلوبة بشكل صحيح",
                                "تنبيه", MessageBoxButtons.OK,
                                MessageBoxIcon.Warning);
                return;
            }

            try
            {
                var dto = new ProductDto
                {
                    Name = txtName.Text.Trim(),
                    PurchasePrice = purchase,
                    SalePrice = sale
                };
                _service.AddProduct(dto);
                ClearForm();
                LoadProducts();
                MessageBox.Show("تمت إضافة المنتج بنجاح",
                                "نجاح", MessageBoxButtons.OK,
                                MessageBoxIcon.Information);
            }
            catch (Exception ex)
            {
                MessageBox.Show("خطأ: " + ex.Message, "خطأ",
                                MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void BtnEdit_Click(object sender, EventArgs e)
        {
            try { if (_selectedProductId <= 0) { MessageBox.Show("اختر منتجًا للتعديل.", "معلومات", MessageBoxButtons.OK, MessageBoxIcon.Information); return; } if (!ValidateInputs(out var dto)) return; dto.Id = _selectedProductId; var ok = _service.Update(dto); if (ok) { MessageBox.Show("تم تحديث المنتج.", "تم", MessageBoxButtons.OK, MessageBoxIcon.Information); ClearForm(); LoadProducts(); } else MessageBox.Show("لم يتم تحديث المنتج.", "معلومة", MessageBoxButtons.OK, MessageBoxIcon.Information); }
            catch (Exception ex) { MessageBox.Show($"حدث خطأ: {ex.Message}", "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error); }
        }

        private void BtnDelete_Click(object sender, EventArgs e)
        {
            try { if (_selectedProductId <= 0) { MessageBox.Show("اختر منتجًا للحذف.", "معلومات", MessageBoxButtons.OK, MessageBoxIcon.Information); return; } if (MessageBox.Show("هل تريد حذف هذا المنتج؟", "تأكيد", MessageBoxButtons.YesNo, MessageBoxIcon.Warning) != DialogResult.Yes) return; var ok = _service.Delete(_selectedProductId); if (ok) { MessageBox.Show("تم الحذف.", "تم", MessageBoxButtons.OK, MessageBoxIcon.Information); ClearForm(); LoadProducts(); } else MessageBox.Show("لم يتم الحذف.", "معلومة", MessageBoxButtons.OK, MessageBoxIcon.Information); }
            catch (Exception ex) { MessageBox.Show($"حدث خطأ: {ex.Message}", "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error); }
        }

        private void BtnClear_Click(object sender, EventArgs e) => ClearForm();

        private bool ValidateInputs(out ProductDto dto)
        {
            dto = null; bool ok = true;
            if (string.IsNullOrWhiteSpace(txtName.Text)) { txtName.BorderColor = Color.FromArgb(239, 68, 68); ok = false; } else txtName.BorderColor = ColorTranslator.FromHtml("#E5E7EB");
            if (!decimal.TryParse(txtPurchasePrice.Text, NumberStyles.Number, Invariant, out var pp) || pp <= 0) { txtPurchasePrice.BorderColor = Color.FromArgb(239, 68, 68); ok = false; } else txtPurchasePrice.BorderColor = ColorTranslator.FromHtml("#E5E7EB");
            if (!decimal.TryParse(txtSalePrice.Text, NumberStyles.Number, Invariant, out var sp) || sp <= 0) { txtSalePrice.BorderColor = Color.FromArgb(239, 68, 68); ok = false; } else txtSalePrice.BorderColor = ColorTranslator.FromHtml("#E5E7EB");
            if (!ok) { MessageBox.Show("يرجى تصحيح الحقول الملحوظة.", "تحقق", MessageBoxButtons.OK, MessageBoxIcon.Warning); return false; }
            dto = new ProductDto { Name = txtName.Text.Trim(), PurchasePrice = pp, SalePrice = sp }; return true;
        }

        private void ClearForm()
        {
            txtName.Text = string.Empty;
            txtPurchasePrice.Text = string.Empty;
            txtSalePrice.Text = string.Empty;
            txtName.BorderColor = txtPurchasePrice.BorderColor = txtSalePrice.BorderColor = Color.FromArgb(229, 231, 235);
            _selectedProductId = 0;
            btnEdit.Enabled = false;
            btnDelete.Enabled = false;
        }

        private void DgvProducts_CellPainting(object sender, DataGridViewCellPaintingEventArgs e)
        {
            if (e.RowIndex < 0) return;
            try
            {
                Color bg = (e.RowIndex % 2 == 0) ? Color.White : ColorTranslator.FromHtml("#FAFBFF"); if (dgvProducts.Rows[e.RowIndex].Selected) bg = ColorTranslator.FromHtml("#EEF2FF");
                var colName = dgvProducts.Columns[e.ColumnIndex].Name;
                if (colName == "Product")
                {
                    e.Handled = true; e.Graphics.SetClip(e.CellBounds); using (var b = new SolidBrush(bg)) e.Graphics.FillRectangle(b, e.CellBounds);
                    var dto = dgvProducts.Rows[e.RowIndex].DataBoundItem as ProductDto; string name = dto?.Name ?? (e.Value?.ToString() ?? string.Empty);
                    Font nameFont = new Font("Cairo", 12F, FontStyle.Bold); int avatarSize = 34; int gap = 10;
                    var avatarColors = new[] { ColorTranslator.FromHtml("#4E73DF"), ColorTranslator.FromHtml("#10B981"), ColorTranslator.FromHtml("#F59E0B"), ColorTranslator.FromHtml("#8B5CF6"), ColorTranslator.FromHtml("#EF4444") };
                    var avatarColor = avatarColors[e.RowIndex % avatarColors.Length];
