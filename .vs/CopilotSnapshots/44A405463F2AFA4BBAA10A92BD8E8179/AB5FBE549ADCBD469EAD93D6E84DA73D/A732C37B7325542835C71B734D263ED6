                    string letter = !string.IsNullOrEmpty(name) ? name[0].ToString() : "?"; using (var lf = new Font("Cairo", 13F, FontStyle.Bold)) using (var lfb = new SolidBrush(Color.White)) { var ls = e.Graphics.MeasureString(letter, lf); e.Graphics.DrawString(letter, lf, lfb, startX + (avatarSize - ls.Width) / 2f, centerY + (avatarSize - ls.Height) / 2f); }
