        private void DgvProducts_CellFormatting(object sender, DataGridViewCellFormattingEventArgs e)
        {
            if (e.RowIndex < 0) return; var col = dgvProducts.Columns[e.ColumnIndex].Name; var dto = dgvProducts.Rows[e.RowIndex].DataBoundItem as ProductDto; if (dto == null) return;
            if (col == "PurchasePrice") { decimal val = 0m; try { val = Convert.ToDecimal(e.Value); } catch { val = dto.PurchasePrice; } e.Value = val.ToString("N2", Invariant) + " جنيه"; e.CellStyle.ForeColor = ColorTranslator.FromHtml("#059669"); e.CellStyle.Font = new Font("Cairo", 11F, FontStyle.Bold); e.FormattingApplied = true; }
            else if (col == "SalePrice") { decimal val = 0m; try { val = Convert.ToDecimal(e.Value); } catch { val = dto.SalePrice; } e.Value = val.ToString("N2", Invariant) + " جنيه"; e.CellStyle.ForeColor = ColorTranslator.FromHtml("#4E73DF"); e.CellStyle.Font = new Font("Cairo", 11F, FontStyle.Bold); e.FormattingApplied = true; }
        }

        private void DgvProducts_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0 || e.ColumnIndex < 0) return; var col = dgvProducts.Columns[e.ColumnIndex].Name; if (col != "Actions") return;
            var cellRect = dgvProducts.GetCellDisplayRectangle(e.ColumnIndex, e.RowIndex, false); var rel = dgvProducts.PointToClient(Cursor.Position);
            int boxW = 60; int boxH = 28; int gap = 8; int iconW = 28; int startX = cellRect.Left + 12;
            var r1 = new Rectangle(startX, cellRect.Top + (cellRect.Height - boxW) / 2, boxW, boxW); var r2 = new Rectangle(r1.Right + gap, cellRect.Top + (cellRect.Height - iconW) / 2, iconW, iconW);
            var dto = dgvProducts.Rows[e.RowIndex].DataBoundItem as ProductDto; if (dto == null) return;
            var c1 = new Rectangle(cellRect.Left + r1.Left, cellRect.Top + r1.Top, r1.Width, r1.Height); var c2 = new Rectangle(cellRect.Left + r2.Left, cellRect.Top + r2.Top, r2.Width, r2.Height);
            if (c1.Contains(rel)) { dgvProducts.ClearSelection(); dgvProducts.Rows[e.RowIndex].Selected = true; OnSelect(dto); }
            else if (c2.Contains(rel)) { if (MessageBox.Show("هل تريد حذف هذا المنتج؟", "تأكيد", MessageBoxButtons.YesNo, MessageBoxIcon.Warning) == DialogResult.Yes) { try { _service.Delete(dto.Id); LoadProducts(); MessageBox.Show("تم الحذف.", "تم", MessageBoxButtons.OK, MessageBoxIcon.Information); } catch (Exception ex) { MessageBox.Show($"خطأ: {ex.Message}", "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error); } } }
        }

        private void OnSelect(ProductDto dto) { _selectedProductId = dto.Id; txtName.Text = dto.Name; txtPurchasePrice.Text = dto.PurchasePrice.ToString("N2", Invariant); txtSalePrice.Text = dto.SalePrice.ToString("N2", Invariant); btnEdit.Enabled = true; btnDelete.Enabled = true; }

        private void DrawRoundedRect(Graphics g, Rectangle rect, int radius, Color fill) { using (var b = new SolidBrush(fill)) using (var path = RoundedRectPath(rect, radius)) { g.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias; g.FillPath(b, path); } }

        private System.Drawing.Drawing2D.GraphicsPath RoundedRectPath(Rectangle r, int radius) { var path = new System.Drawing.Drawing2D.GraphicsPath(); int d = radius * 2; path.AddArc(r.Left, r.Top, d, d, 180, 90); path.AddArc(r.Right - d, r.Top, d, d, 270, 90); path.AddArc(r.Right - d, r.Bottom - d, d, d, 0, 90); path.AddArc(r.Left, r.Bottom - d, d, d, 90, 90); path.CloseFigure(); return path; }

        private void DrawTrashIcon(Graphics g, Rectangle rect, Color color) { using (var pen = new Pen(color, 1.6f)) using (var brush = new SolidBrush(color)) { g.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias; var body = new Rectangle(rect.Left + 6, rect.Top + 6, rect.Width - 12, rect.Height - 12); g.DrawRectangle(pen, body); g.DrawArc(pen, rect.Left + 5, rect.Top + 3, rect.Width - 10, 8, 0, 180); } }
    }
