        private bool ValidateInputs(out ProductDto dto)
        {
            dto = null;
            bool ok = true;
            if (string.IsNullOrWhiteSpace(txtName.Text)) { txtName.BorderColor = Color.FromArgb(239, 68, 68); ok = false; }
            else txtName.BorderColor = ColorTranslator.FromHtml("#E5E7EB");

            if (!decimal.TryParse(txtPurchasePrice.Text, NumberStyles.Number, Invariant, out var pp) || pp <= 0) { txtPurchasePrice.BorderColor = Color.FromArgb(239, 68, 68); ok = false; }
            else txtPurchasePrice.BorderColor = ColorTranslator.FromHtml("#E5E7EB");

            if (!decimal.TryParse(txtSalePrice.Text, NumberStyles.Number, Invariant, out var sp) || sp <= 0) { txtSalePrice.BorderColor = Color.FromArgb(239, 68, 68); ok = false; }
            else txtSalePrice.BorderColor = ColorTranslator.FromHtml("#E5E7EB");

            if (!ok)
            {
                MessageBox.Show("يرجى تصحيح الحقول الملحوظة.", "تحقق", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            dto = new ProductDto { Name = txtName.Text.Trim(), PurchasePrice = pp, SalePrice = sp };
            return true;
        }

        private void ClearForm()
        {
            txtName.Clear(); txtPurchasePrice.Clear(); txtSalePrice.Clear();
            _selectedProductId = 0; btnEdit.Enabled = false; btnDelete.Enabled = false; txtName.Focus();
            txtName.BorderColor = ColorTranslator.FromHtml("#E5E7EB"); txtPurchasePrice.BorderColor = ColorTranslator.FromHtml("#E5E7EB"); txtSalePrice.BorderColor = ColorTranslator.FromHtml("#E5E7EB");
            dgvProducts.ClearSelection();
        }

        private void DgvProducts_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0 || e.ColumnIndex < 0) return;
            var col = dgvProducts.Columns[e.ColumnIndex].Name;
            if (col != "Actions") return; // clicks on actions are handled in painting hit test

            // fallback: select row
            if (dgvProducts.Rows[e.RowIndex].DataBoundItem is ProductDto dto)
            {
                _selectedProductId = dto.Id;
                txtName.Text = dto.Name;
                txtPurchasePrice.Text = dto.PurchasePrice.ToString("N2", Invariant);
                txtSalePrice.Text = dto.SalePrice.ToString("N2", Invariant);
                btnEdit.Enabled = true; btnDelete.Enabled = true;
            }
        }

        // paints avatar, status chip and action icons
        private void DgvProducts_CellPainting(object sender, DataGridViewCellPaintingEventArgs e)
        {
            if (e.RowIndex < 0) return;
            try
            {
                // background
                Color bg = (e.RowIndex % 2 == 0) ? Color.White : ColorTranslator.FromHtml("#FAFBFF");
                if (dgvProducts.Rows[e.RowIndex].Selected) bg = ColorTranslator.FromHtml("#EEF2FF");

                if (dgvProducts.Columns[e.ColumnIndex].Name == "Product")
                {
                    e.Handled = true;
                    e.Graphics.SetClip(e.CellBounds);
                    using (var b = new SolidBrush(bg)) e.Graphics.FillRectangle(b, e.CellBounds);

                    var dto = dgvProducts.Rows[e.RowIndex].DataBoundItem as ProductDto;
                    string name = dto?.Name ?? (e.Value?.ToString() ?? string.Empty);
                    Font nameFont = new Font("Cairo", 12F, FontStyle.Bold);

                    int avatarSize = 34; int gap = 10;
                    var avatarColors = new[] { ColorTranslator.FromHtml("#4E73DF"), ColorTranslator.FromHtml("#10B981"), ColorTranslator.FromHtml("#F59E0B"), ColorTranslator.FromHtml("#8B5CF6"), ColorTranslator.FromHtml("#EF4444") };
                    var avatarColor = avatarColors[e.RowIndex % avatarColors.Length];

                    int centerY = e.CellBounds.Y + (e.CellBounds.Height - avatarSize) / 2;
                    int startX = e.CellBounds.Right - avatarSize - 12; // RTL: avatar on rightmost

                    // avatar circle
                    using (var bb = new SolidBrush(avatarColor))
                    {
                        e.Graphics.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias;
                        e.Graphics.FillEllipse(bb, startX, centerY, avatarSize, avatarSize);
                    }

                    // first letter
                    string letter = !string.IsNullOrEmpty(name) ? name[0].ToString() : "?";
                    using (var lf = new Font("Cairo", 13F, FontStyle.Bold))
                    using (var lfb = new SolidBrush(Color.White))
                    {
                        var ls = e.Graphics.MeasureString(letter, lf);
                        e.Graphics.DrawString(letter, lf, lfb, startX + (avatarSize - ls.Width) / 2f, centerY + (avatarSize - ls.Height) / 2f);
                    }

                    // name text left of avatar
                    var nmSize = e.Graphics.MeasureString(name, nameFont);
                    float textX = startX - gap - nmSize.Width;
                    float textY = e.CellBounds.Y + (e.CellBounds.Height - nmSize.Height) / 2f;
                    using (var nb = new SolidBrush(ColorTranslator.FromHtml("#1A1D23")))
                    {
                        e.Graphics.DrawString(name, nameFont, nb, textX, textY);
                    }

                    if (e.State.HasFlag(DataGridViewElementStates.Selected))
                    {
                        using (var pen = new Pen(Color.FromArgb(235, 243, 255), 2))
                        {
                            var r = e.CellBounds; r.Inflate(-1, -1);
                            e.Graphics.DrawRectangle(pen, r);
                        }
                    }

                    e.Graphics.ResetClip();
                }
                else if (dgvProducts.Columns[e.ColumnIndex].Name == "Status")
                {
                    e.Handled = true;
                    e.Graphics.SetClip(e.CellBounds);
                    using (var b = new SolidBrush(bg)) e.Graphics.FillRectangle(b, e.CellBounds);

                    // draw pill
                    var pillW = 50; var pillH = 28;
                    var rx = e.CellBounds.Left + (e.CellBounds.Width - pillW) / 2;
                    var ry = e.CellBounds.Top + (e.CellBounds.Height - pillH) / 2;
                    var pillRect = new Rectangle(rx, ry, pillW, pillH);
                    using (var pb = new SolidBrush(ColorTranslator.FromHtml("#D1FAE5")))
                    using (var p = new Pen(ColorTranslator.FromHtml("#D1FAE5")))
                    {
                        var gp = new System.Drawing.Drawing2D.GraphicsPath();
                        gp.AddArc(pillRect.Left, pillRect.Top, pillH, pillH, 90, 180);
                        gp.AddArc(pillRect.Right - pillH, pillRect.Top, pillH, pillH, 270, 180);
                        gp.CloseFigure();
                        e.Graphics.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias;
                        e.Graphics.FillPath(pb, gp);
                    }

                    using (var tf = new Font("Cairo", 10F, FontStyle.Bold))
                    using (var tb = new SolidBrush(ColorTranslator.FromHtml("#059669")))
                    {
                        var txt = "نشط";
                        var sz = e.Graphics.MeasureString(txt, tf);
                        e.Graphics.DrawString(txt, tf, tb, pillRect.Left + (pillRect.Width - sz.Width) / 2f, pillRect.Top + (pillRect.Height - sz.Height) / 2f);
                    }

                    e.Graphics.ResetClip();
                    e.Handled = true;
                }
                else if (dgvProducts.Columns[e.ColumnIndex].Name == "Actions")
                {
                    e.Handled = true;
                    e.Graphics.SetClip(e.CellBounds);
                    using (var b = new SolidBrush(bg)) e.Graphics.FillRectangle(b, e.CellBounds);

                    int boxW = 60; int boxH = 28; int gap = 8;
                    int iconW = 28;
                    int startX = e.CellBounds.Left + 12; // left side for LTR painting of icons
                    int y = e.CellBounds.Top + (e.CellBounds.Height - boxH) / 2;

                    // "تحديد" box
                    var r1 = new Rectangle(startX, y, boxW, boxH);
                    DrawRoundedRect(e.Graphics, r1, 6, ColorTranslator.FromHtml("#EEF2FF"));
                    using (var f = new Font("Cairo", 9F))
                    using (var br = new SolidBrush(ColorTranslator.FromHtml("#4E73DF")))
                    {
                        var txt = "تحديد";
                        var sz = e.Graphics.MeasureString(txt, f);
                        e.Graphics.DrawString(txt, f, br, r1.Left + (r1.Width - sz.Width) / 2f, r1.Top + (r1.Height - sz.Height) / 2f);
                    }

                    // delete rounded icon
                    var r2 = new Rectangle(r1.Right + gap, y + (boxH - iconW) / 2, iconW, iconW);
                    DrawRoundedRect(e.Graphics, r2, 6, ColorTranslator.FromHtml("#FEE2E2"));
                    DrawTrashIcon(e.Graphics, r2, ColorTranslator.FromHtml("#EF4444"));

                    e.Graphics.ResetClip();
                }
            }
            catch { }
        }

        private void DgvProducts_CellFormatting(object sender, DataGridViewCellFormattingEventArgs e)
        {
            if (e.RowIndex < 0) return;
            var col = dgvProducts.Columns[e.ColumnIndex].Name;
            var dto = dgvProducts.Rows[e.RowIndex].DataBoundItem as ProductDto;
            if (dto == null) return;

            if (col == "PurchasePrice")
            {
                decimal val = 0m; try { val = Convert.ToDecimal(e.Value); } catch { val = dto.PurchasePrice; }
                e.Value = val.ToString("N2", Invariant) + " جنيه";
                e.CellStyle.ForeColor = ColorTranslator.FromHtml("#059669");
                e.CellStyle.Font = new Font("Cairo", 11F, FontStyle.Bold);
                e.FormattingApplied = true;
            }
            else if (col == "SalePrice")
            {
                decimal val = 0m; try { val = Convert.ToDecimal(e.Value); } catch { val = dto.SalePrice; }
                e.Value = val.ToString("N2", Invariant) + " جنيه";
                e.CellStyle.ForeColor = ColorTranslator.FromHtml("#4E73DF");
                e.CellStyle.Font = new Font("Cairo", 11F, FontStyle.Bold);
                e.FormattingApplied = true;
            }
        }

        private void DgvProducts_CellClick(object sender, DataGridViewCellMouseEventArgs e)
        {
            // handle action icon hits
            if (e.RowIndex < 0 || e.ColumnIndex < 0) return;

            var col = dgvProducts.Columns[e.ColumnIndex].Name;
            if (col != "Actions") return;

            var cellRect = dgvProducts.GetCellDisplayRectangle(e.ColumnIndex, e.RowIndex, false);
            var rel = dgvProducts.PointToClient(Cursor.Position);
            var x = rel.X - cellRect.Left; var y = rel.Y - cellRect.Top;

            int boxW = 60; int boxH = 28; int gap = 8; int iconW = 28;
            int startX = cellRect.Left + 12;
            var r1 = new Rectangle(startX, cellRect.Top + (cellRect.Height - boxH) / 2, boxW, boxH);
            var r2 = new Rectangle(r1.Right + gap, cellRect.Top + (cellRect.Height - iconW) / 2, iconW, iconW);

            var clickPoint = new Point(rel.X, rel.Y);

            var dto = dgvProducts.Rows[e.RowIndex].DataBoundItem as ProductDto;
            if (dto == null) return;

            var c1 = new Rectangle(cellRect.Left + r1.Left, cellRect.Top + r1.Top, r1.Width, r1.Height);
            var c2 = new Rectangle(cellRect.Left + r2.Left, cellRect.Top + r2.Top, r2.Width, r2.Height);

            if (c1.Contains(rel))
            {
                // select row
                dgvProducts.ClearSelection(); dgvProducts.Rows[e.RowIndex].Selected = true;
                OnSelect(dto);
            }
            else if (c2.Contains(rel))
            {
                if (MessageBox.Show("هل تريد حذف هذا المنتج؟", "تأكيد", MessageBoxButtons.YesNo, MessageBoxIcon.Warning) == DialogResult.Yes)
                {
                    try { _service.Delete(dto.Id); LoadProducts(); MessageBox.Show("تم الحذف.", "تم", MessageBoxButtons.OK, MessageBoxIcon.Information); }
                    catch (Exception ex) { MessageBox.Show($"خطأ: {ex.Message}", "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error); }
                }
            }
        }

        private void OnSelect(ProductDto dto)
        {
            _selectedProductId = dto.Id;
            txtName.Text = dto.Name;
            txtPurchasePrice.Text = dto.PurchasePrice.ToString("N2", Invariant);
            txtSalePrice.Text = dto.SalePrice.ToString("N2", Invariant);
            btnEdit.Enabled = true; btnDelete.Enabled = true;
        }

        private void DrawRoundedRect(Graphics g, Rectangle rect, int radius, Color fill)
        {
            using (var b = new SolidBrush(fill))
            using (var path = RoundedRectPath(rect, radius))
            {
                g.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias;
                g.FillPath(b, path);
            }
        }

        private System.Drawing.Drawing2D.GraphicsPath RoundedRectPath(Rectangle r, int radius)
        {
            var path = new System.Drawing.Drawing2D.GraphicsPath();
            int d = radius * 2;
            path.AddArc(r.Left, r.Top, d, d, 180, 90);
            path.AddArc(r.Right - d, r.Top, d, d, 270, 90);
            path.AddArc(r.Right - d, r.Bottom - d, d, d, 0, 90);
            path.AddArc(r.Left, r.Bottom - d, d, d, 90, 90);
            path.CloseFigure();
            return path;
        }

        private void DrawTrashIcon(Graphics g, Rectangle rect, Color color)
        {
            using (var pen = new Pen(color, 1.6f))
            using (var brush = new SolidBrush(color))
            {
                g.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias;
                var body = new Rectangle(rect.Left + 6, rect.Top + 6, rect.Width - 12, rect.Height - 12);
                g.DrawRectangle(pen, body);
                g.DrawArc(pen, rect.Left + 5, rect.Top + 3, rect.Width - 10, 8, 0, 180);
            }
        }
    }
