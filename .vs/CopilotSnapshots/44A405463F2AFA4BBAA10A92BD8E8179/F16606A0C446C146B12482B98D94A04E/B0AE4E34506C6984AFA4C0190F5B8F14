        private void BuildGridColumns()
        {
            dgvProducts.Columns.Clear();
            // RTL order: Product, PurchasePrice, SalePrice, Status, Actions
            var colProduct = new DataGridViewTextBoxColumn { Name = "Product", HeaderText = "المنتج", Width = 240, DataPropertyName = "Name" };
            var colPurchase = new DataGridViewTextBoxColumn { Name = "PurchasePrice", HeaderText = "سعر الشراء", Width = 160, DataPropertyName = "PurchasePrice" };
            var colSale = new DataGridViewTextBoxColumn { Name = "SalePrice", HeaderText = "سعر البيع", Width = 160, DataPropertyName = "SalePrice" };
            var colStatus = new DataGridViewTextBoxColumn { Name = "Status", HeaderText = "الحالة", Width = 100 };
            var colActions = new DataGridViewTextBoxColumn { Name = "Actions", HeaderText = "الإجراءات", Width = 110 };

            dgvProducts.Columns.Add(colProduct);
            dgvProducts.Columns.Add(colPurchase);
            dgvProducts.Columns.Add(colSale);
            dgvProducts.Columns.Add(colStatus);
            dgvProducts.Columns.Add(colActions);

            foreach (DataGridViewColumn c in dgvProducts.Columns)
            {
                c.DefaultCellStyle.Alignment = DataGridViewContentAlignment.MiddleCenter;
            }
        }

        private System.Threading.Timer _searchTimer;
        private void StartSearchDelay()
        {
            _searchTimer?.Dispose();
            _searchTimer = new System.Threading.Timer(_ => this.Invoke(new Action(() => LoadProducts())), null, 300, System.Threading.Timeout.Infinite);
        }

        private void LoadProducts()
        {
            var list = _service.GetAll()?.ToList() ?? new List<ProductDto>();
            var q = txtSearch?.Text?.Trim() ?? string.Empty;
            if (!string.IsNullOrEmpty(q)) list = list.Where(x => x.Name != null && x.Name.IndexOf(q, StringComparison.OrdinalIgnoreCase) >= 0).ToList();

            dgvProducts.DataSource = new BindingSource { DataSource = list };
            FitColumnsToWidth();
            UpdateProductCount(list.Count);
            ClearSelectionState();
        }

        private void UpdateProductCount(int count)
        {
            lblCountBadge.Text = $"{count} منتج";
        }

        private void FitColumnsToWidth()
        {
            if (dgvProducts.Columns.Count == 0) return;
            int total = dgvProducts.ClientSize.Width;
            if (total <= 0) return;
            int wProduct = (int)(total * 0.40);
            int wPrice = (int)(total * 0.18);
            int wStatus = (int)(total * 0.12);
            int wActions = total - (wProduct + wPrice + wPrice + wStatus);

            if (dgvProducts.Columns.Contains("Product")) dgvProducts.Columns["Product"].Width = Math.Max(160, wProduct);
            if (dgvProducts.Columns.Contains("PurchasePrice")) dgvProducts.Columns["PurchasePrice"].Width = Math.Max(100, wPrice);
            if (dgvProducts.Columns.Contains("SalePrice")) dgvProducts.Columns["SalePrice"].Width = Math.Max(100, wPrice);
            if (dgvProducts.Columns.Contains("Status")) dgvProducts.Columns["Status"].Width = Math.Max(80, wStatus);
            if (dgvProducts.Columns.Contains("Actions")) dgvProducts.Columns["Actions"].Width = Math.Max(90, wActions);
        }

        private void ClearSelectionState()
        {
            _selectedProductId = 0;
            btnEdit.Enabled = false; btnDelete.Enabled = false;
            txtName.BorderColor = ColorTranslator.FromHtml("#E5E7EB");
            txtPurchasePrice.BorderColor = ColorTranslator.FromHtml("#E5E7EB");
            txtSalePrice.BorderColor = ColorTranslator.FromHtml("#E5E7EB");
            dgvProducts.ClearSelection();
        }

        private void DgvProducts_SelectionChanged(object sender, EventArgs e)
        {
            if (dgvProducts.CurrentRow?.DataBoundItem is ProductDto dto)
            {
                _selectedProductId = dto.Id;
                txtName.Text = dto.Name;
                txtPurchasePrice.Text = dto.PurchasePrice.ToString("N2", Invariant);
                txtSalePrice.Text = dto.SalePrice.ToString("N2", Invariant);
                btnEdit.Enabled = true; btnDelete.Enabled = true;
            }
            else
            {
                ClearSelectionState();
            }
        }

        private void BtnAdd_Click(object sender, EventArgs e)
        {
            try
            {
                if (!ValidateInputs(out var dto)) return;

                var newId = _service.AddProduct(dto);
                MessageBox.Show("تم إضافة المنتج بنجاح.", "نجاح", MessageBoxButtons.OK, MessageBoxIcon.Information);
                ClearForm();
                LoadProducts();
            }
            catch (ValidationException vex)
            {
                MessageBox.Show(vex.Message, "تحقق", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
            catch (DataAccessException dax)
            {
                MessageBox.Show(dax.Message, "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"حدث خطأ: {ex.Message}", "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void BtnEdit_Click(object sender, EventArgs e)
        {
            try
            {
                if (_selectedProductId <= 0) return;
                if (!ValidateInputs(out var dto)) return;
                dto.Id = _selectedProductId;

                var ok = _service.Update(dto);
                if (ok)
                {
                    MessageBox.Show("تم تحديث المنتج.", "تم", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    ClearForm(); LoadProducts();
                }
                else
                {
                    MessageBox.Show("لم يتم تحديث المنتج.", "معلومة", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }
            }
            catch (ValidationException vex)
            {
                MessageBox.Show(vex.Message, "تحقق", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
            catch (DataAccessException dax)
            {
                MessageBox.Show(dax.Message, "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"حدث خطأ: {ex.Message}", "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void BtnDelete_Click(object sender, EventArgs e)
