using System;
using System.Collections.Generic;
using System.Linq;
using DistributionSystem.Business.Dtos;
using DistributionSystem.Data.Data;
using DistributionSystem.Data.Entities;
using DistributionSystem.Data.Interfaces;
using DistributionSystem.Data.Repositories;
using System.Data.SqlClient;

namespace DistributionSystem.Business.Services
{
    public class ValidationException : Exception
    {
        public ValidationException(string message) : base(message) { }
    }

    public class DataAccessException : Exception
    {
        public DataAccessException(string message, Exception inner) : base(message, inner) { }
    }

    public class ProductService : BaseService
    {
        private readonly IProductRepository _productRepository;
        private readonly SqlConnectionFactory _connectionFactory;

        public ProductService() : this(new ProductRepository(new SqlConnectionFactory()), new SqlConnectionFactory())
        {
        }

        // Constructor injection for DI
        public ProductService(IProductRepository productRepository, SqlConnectionFactory connectionFactory)
        {
            _productRepository = productRepository;
            _connectionFactory = connectionFactory;
        }

        public IEnumerable<ProductDto> GetAll()
        {
            return Execute(() => _productRepository.GetAll().Select(MapToDto).ToList());
        }

        public ProductDto GetById(int id)
        {
            return Execute(() =>
            {
                var p = _productRepository.GetById(id);
                if (p == null) return null;
                return MapToDto(p);
            });
        }

        // Create product
        public int AddProduct(ProductDto dto)
        {
            return Execute(() =>
            {
                ValidateDto(dto);

                try
                {
                    var productEntity = MapToEntity(dto);
                    var newProductId = _productRepository.Insert(productEntity);
                    return newProductId;
                }
                catch (Exception ex)
                {
                    LogError(ex);
                    throw new DataAccessException("حدث خطأ أثناء إضافة المنتج.", ex);
                }
            });
        }

        // Update product
        public bool Update(ProductDto dto)
        {
            return Execute(() =>
            {
                if (dto == null) throw new ValidationException("معلومات المنتج غير صالحة.");
                if (dto.Id <= 0) throw new ValidationException("معرّف المنتج غير صالح.");

                ValidateDto(dto);

                try
                {
                    var entity = MapToEntity(dto);
                    entity.Id = dto.Id;
                    return _productRepository.Update(entity);
                }
                catch (Exception ex)
                {
                    LogError(ex);
                    throw new DataAccessException("حدث خطأ أثناء تحديث المنتج.", ex);
                }
            });
        }

        // Delete product
        public bool Delete(int id)
        {
            return Execute(() =>
            {
                if (id <= 0) throw new ValidationException("معرّف المنتج غير صالح.");
                try
                {
                    return _productRepository.Delete(id);
                }
                catch (Exception ex)
                {
                    LogError(ex);
                    throw new DataAccessException("حدث خطأ أثناء حذف المنتج.", ex);
                }
            });
        }

        private void ValidateDto(ProductDto dto)
        {
            if (dto == null) throw new ValidationException("معلومات المنتج غير صالحة.");
            if (string.IsNullOrWhiteSpace(dto.Name)) throw new ValidationException("اسم المنتج مطلوب.");
            if (dto.PurchasePrice <= 0) throw new ValidationException("سعر الشراء يجب أن يكون أكبر من صفر.");
            if (dto.SalePrice <= 0) throw new ValidationException("سعر البيع يجب أن يكون أكبر من صفر.");
        }

        private void LogError(Exception ex)
        {
            // Simulate logging. Replace with real logging in production.
            System.Diagnostics.Debug.WriteLine($"[ERROR] {DateTime.UtcNow:o} - {ex}");
        }

        private static ProductDto MapToDto(Product p)
        {
            return new ProductDto
            {
                Id = p.Id,
                Name = p.Name,
                PurchasePrice = p.PurchasePrice,
                SalePrice = p.SalePrice
            };
        }

        private static Product MapToEntity(ProductDto dto)
        {
            return new Product
            {
                Name = dto.Name,
                PurchasePrice = dto.PurchasePrice,
                SalePrice = dto.SalePrice
            };
        }
    }
}
