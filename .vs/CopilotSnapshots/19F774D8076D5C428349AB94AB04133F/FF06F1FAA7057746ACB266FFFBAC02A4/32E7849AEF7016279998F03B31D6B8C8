        // ??????????????????????????????????????????????????????
        private void SetActiveButton(Guna2Button active)
        {
            var buttons = new[]
            {
                btnDashboard, btnTreasury, btnWarehouse, btnCustomers,
                btnProducts, btnInbound, btnVehicles, btnSalesInvoices,
                btnEmployees, btnTransactions, btnReports
            };
            foreach (var b in buttons)
            {
                if (b == null) continue;
                b.FillColor = b == active
                    ? ColorTranslator.FromHtml("#4E73DF")
                    : ColorTranslator.FromHtml("#111827");
                b.ForeColor = Color.White;
            }
        }

