        private void HeaderPanel_Paint(object sender, PaintEventArgs e)
        {
            var g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;
            var rc = new Rectangle(0, 0, headerPanel.Width, headerPanel.Height);
            using (var br = new LinearGradientBrush(rc,
                ColorTranslator.FromHtml("#1a2f5e"),
                ColorTranslator.FromHtml("#1565c0"),
                LinearGradientMode.Horizontal))
                g.FillRectangle(br, rc);
            using (var dot = new SolidBrush(Color.FromArgb(18, 255, 255, 255)))
                for (int x = 10; x < headerPanel.Width; x += 22)
                    for (int y = 8; y < headerPanel.Height; y += 22)
                        g.FillEllipse(dot, x, y, 2, 2);
            string title = "بصوص";
            using (var f = new Font("Cairo", 20F, FontStyle.Bold))
            using (var brush = new SolidBrush(Color.White))
            {
                var sz = g.MeasureString(title, f);
                g.DrawString(title, f, brush,
                    (headerPanel.Width - sz.Width) / 2f,
                    (headerPanel.Height - sz.Height) / 2f - 4);
            }
        }

        private GraphicsPath RoundPath(Rectangle r, int radius)
        {
            var path = new GraphicsPath();
            if (radius <= 0) { path.AddRectangle(r); return path; }
            int d = radius * 2;
            path.AddArc(r.Left, r.Top, d, d, 180, 90);
            path.AddArc(r.Right - d, r.Top, d, d, 270, 90);
            path.AddArc(r.Right - d, r.Bottom - d, d, d, 0, 90);
            path.AddArc(r.Left, r.Bottom - d, d, d, 90, 90);
            path.CloseFigure();
            return path;
        }

        private void InitializeRuntime()
        {
            lblUser.Text = $"المستخدم: {LoggedInUser}";
            _clockTimer = new Timer { Interval = 1000 };
            _clockTimer.Tick += (s, e) => lblDateTime.Text = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            _clockTimer.Start();
            Task.Run(() => new BackupService().AutoDailyBackup());
            LoadChildForm(new DashboardForm());
        }

        public void LoadChildForm(Form child)
        {
            try
            {
                if (panelContent.Controls.Count > 0)
                {
                    var existing = panelContent.Controls[0];
                    panelContent.Controls.Clear();
                    existing.Dispose();
                }
                child.TopLevel = false;
                child.FormBorderStyle = FormBorderStyle.None;
                child.Dock = DockStyle.Fill;
                panelContent.Controls.Add(child);
                child.Show();
                try { AnimationHelper.FadeIn(child, 300); } catch { }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"حدث خطأ أثناء تحميل الشاشة: {ex.Message}", "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

