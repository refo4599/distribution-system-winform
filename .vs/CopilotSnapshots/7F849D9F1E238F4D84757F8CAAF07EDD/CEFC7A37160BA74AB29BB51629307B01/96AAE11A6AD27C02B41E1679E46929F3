using System;
using System.Data;
using System.Data.SqlClient;
using System.IO;
using System.Linq;
using System.Xml.Linq;
using DistributionSystem.Business.Dtos;
using DistributionSystem.Data.Data;
using DistributionSystem.Data.Repositories;
using DistributionSystem.Data.Entities;

namespace DistributionSystem.Business.Services
{
    public class WrongDatabaseException : Exception
    {
        public WrongDatabaseException(string message) : base(message) { }
    }

    public class MissingTablesException : Exception
    {
        public MissingTablesException(string message) : base(message) { }
    }

    public class InboundService : BaseService
    {
        private readonly SqlConnectionFactory _factory;
        private readonly InboundRepository _inboundRepo;
        private readonly WarehouseTransactionRepository _warehouseRepo;

        public InboundService()
        {
            _factory = new SqlConnectionFactory();
            _inboundRepo = new InboundRepository(_factory);
            _warehouseRepo = new WarehouseTransactionRepository(_factory);
        }

        // public logging wrapper so UI can log without changing BaseService protection
        public void LogException(Exception ex)
        {
            LogError(ex);
        }

        public int SaveInboundOrder(InboundOrderDto dto)
        {
            return Execute(() =>
            {
                if (dto == null) throw new ArgumentNullException(nameof(dto));
                if (dto.Items == null || dto.Items.Count == 0) throw new ArgumentException("Inbound order must contain at least one item.");

                // Read expected DB from the application's configuration file to verify target database
                string expectedDb = null;
                try
                {
                    var configPath = AppDomain.CurrentDomain.SetupInformation.ConfigurationFile;
                    if (!string.IsNullOrWhiteSpace(configPath) && File.Exists(configPath))
                    {
                        var doc = XDocument.Load(configPath);
                        var add = doc.Descendants("add").FirstOrDefault(x => (string)x.Attribute("name") == "DistributionDb");
                        var cs = add?.Attribute("connectionString")?.Value;
                        if (!string.IsNullOrWhiteSpace(cs))
                        {
                            var builder = new SqlConnectionStringBuilder(cs);
                            expectedDb = builder.InitialCatalog;
                        }
                    }
                }
                catch (Exception ex)
                {
                    LogError(ex);
                }

                using (var conn = _factory.CreateConnection())
                {
                    // Pre-open diagnostics
                    try
                    {
                        var diagPath = Path.Combine(Path.GetTempPath(), "DistributionSystem.log");
                        var diag = $"{DateTime.UtcNow:u} - Creating connection. ConnectionString='{conn.ConnectionString}'" + Environment.NewLine;
                        File.AppendAllText(diagPath, diag);
                    }
                    catch { }

                    conn.Open();

                    // Verify connected database
                    try
                    {
                        var diagPath2 = Path.Combine(Path.GetTempPath(), "DistributionSystem.log");
                        var diag2 = $"{DateTime.UtcNow:u} - Opened connection. DataSource='{conn.DataSource}', Database='{conn.Database}'" + Environment.NewLine;
                        File.AppendAllText(diagPath2, diag2);
                    }
                    catch { }

                    if (!string.IsNullOrWhiteSpace(expectedDb) && !string.Equals(conn.Database, expectedDb, StringComparison.OrdinalIgnoreCase))
                    {
                        var msg = $"Application is connected to wrong database: {conn.Database} (expected: {expectedDb})";
                        throw new WrongDatabaseException(msg);
                    }

                    // Validate required tables exist
                    var requiredTables = new[] { "InboundOrders", "InboundOrderItems", "WarehouseTransactions" };
                    var existing = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    using (var checkCmd = conn.CreateCommand())
                    {
                        checkCmd.CommandText = "SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'dbo' AND TABLE_NAME IN ('InboundOrders','InboundOrderItems','WarehouseTransactions')";
                        checkCmd.CommandType = CommandType.Text;
                        using (var rdr = checkCmd.ExecuteReader())
                        {
                            while (rdr.Read())
                            {
                                existing.Add(rdr.GetString(0));
                            }
                        }
                    }

                    var missing = requiredTables.Where(t => !existing.Contains(t)).ToArray();
                    if (missing.Length > 0)
                    {
                        var msg = "Database is missing required tables. Please run migration or check DB. Missing: " + string.Join(", ", missing);
                        // Log missing tables
                        LogError(new InvalidOperationException(msg));
                        throw new MissingTablesException(msg);
                    }

                    // Pre-save debug output
                    try
                    {
                        var userCmd = conn.CreateCommand();
                        userCmd.CommandText = "SELECT SUSER_SNAME()";
                        var currentUser = userCmd.ExecuteScalar() as string ?? string.Empty;
                        var prePath = Path.Combine(Path.GetTempPath(), "DistributionSystem.log");
                        var preText = $"{DateTime.UtcNow:u} - About to save inbound. Database='{conn.Database}', TablesFound={existing.Count}, CurrentUser='{currentUser}'" + Environment.NewLine;
                        File.AppendAllText(prePath, preText);
                    }
                    catch (Exception) { }

                    // Duplicate prevention: simple heuristic — check recent identical inbound transactions (last 5 minutes)
                    try
                    {
                        using (var dupCmd = conn.CreateCommand())
                        {
                            dupCmd.CommandText = "SELECT COUNT(1) FROM dbo.WarehouseTransactions WHERE TransactionType = 'Inbound' AND ProductId = @ProductId AND Quantity = @Quantity AND DATEDIFF(MINUTE, CreatedAt, GETDATE()) < 5";
                            var pProd = new SqlParameter("@ProductId", SqlDbType.Int);
                            var pQty = new SqlParameter("@Quantity", SqlDbType.Int);
                            dupCmd.Parameters.Add(pProd);
                            dupCmd.Parameters.Add(pQty);

                            // For duplicate check, if multiple items we'll check first item
                            var first = dto.Items.First();
                            pProd.Value = first.ProductId;
                            pQty.Value = first.Quantity;

                            var dupCount = Convert.ToInt32(dupCmd.ExecuteScalar());
                            if (dupCount > 0)
                            {
                                throw new InvalidOperationException("Possible duplicate inbound detected. Operation aborted.");
                            }
                        }
                    }
                    catch (InvalidOperationException)
                    {
                        throw;
                    }
                    catch (Exception ex)
                    {
                        // non-fatal; log and continue
                        LogError(ex);
                    }

                    using (var tran = conn.BeginTransaction())
                    {
                        try
                        {
                            // Insert inbound order
                            var inboundId = _inboundRepo.InsertInboundOrder(conn, tran, dto.CustomerId, dto.CreatedAt);

                            // Insert items and warehouse transactions
                            foreach (var item in dto.Items)
                            {
                                if (item.ProductId <= 0) throw new ArgumentException("Invalid product in items.");
                                if (item.Quantity <= 0) throw new ArgumentException("Item quantity must be greater than zero.");
                                if (item.PurchasePrice <= 0) throw new ArgumentException("Item purchase price must be greater than zero.");

                                _inboundRepo.InsertInboundItem(conn, tran, inboundId, item.ProductId, item.Quantity, item.PurchasePrice);

                                var wt = new WarehouseTransaction
                                {
                                    ProductId = item.ProductId,
                                    Quantity = item.Quantity,
                                    TransactionType = "Inbound",
                                    ReferenceId = inboundId,
                                    PurchasePrice = item.PurchasePrice,
                                    CreatedAt = DateTime.UtcNow
                                };

                                _warehouseRepo.AddTransaction(wt, conn, tran);
                            }

                            tran.Commit();
                            // Log success
                            try
                            {
                                var logPath = Path.Combine(Path.GetTempPath(), "DistributionSystem.log");
                                File.AppendAllText(logPath, $"{DateTime.UtcNow:u} - Inbound saved. Id={inboundId}, Items={dto.Items.Count}\n");
                            }
                            catch { }

                            return inboundId;
                        }
                        catch (SqlException sqlEx)
                        {
                            try { tran.Rollback(); } catch { }
                            // Log technical details
                            LogError(sqlEx);
                            // Throw user-friendly message with technical details as inner exception
                            throw new InvalidOperationException("Failed to save inbound order. Please try again.", sqlEx);
                        }
                        catch (Exception ex)
                        {
                            try { tran.Rollback(); } catch { }
                            LogError(ex);
                            throw;
                        }
                    }
                }
            });
        }
    }
}
