using System;
using System.Diagnostics;
using System.IO;

namespace DistributionSystem.Business.Services
{
    public abstract class BaseService
    {
        // Common service-level utilities, exception handling helpers, and logging hooks could be added here.

        protected void Execute(Action action)
        {
            try
            {
                action();
            }
            catch (Exception ex)
            {
                // Basic error handling: log and rethrow with context.
                LogError(ex);
                throw new InvalidOperationException("An error occurred while executing service operation.", ex);
            }
        }

        protected T Execute<T>(Func<T> func)
        {
            try
            {
                return func();
            }
            catch (Exception ex)
            {
                // Wrap exception to provide service-level context and log it.
                LogError(ex);
                throw new InvalidOperationException("An error occurred while executing service operation.", ex);
            }
        }

        protected void LogError(Exception ex)
        {
            try
            {
                // Simple logging to debug/trace for now.
                Trace.TraceError($"{DateTime.UtcNow:u} - {ex.GetType().FullName}: {ex.Message}\n{ex.StackTrace}");

                // Also write to a simple rolling log file in temp so developers can inspect.
                var logPath = Path.Combine(Path.GetTempPath(), "DistributionInboundErrors.log");
                var text = $"{DateTime.UtcNow:u} - {ex.GetType().FullName}: {ex.Message}{Environment.NewLine}{ex.StackTrace}{Environment.NewLine}{Environment.NewLine}";
                File.AppendAllText(logPath, text);
            }
            catch
            {
                // Swallow any logging exceptions to avoid masking original errors.
            }
        }
    }
}
