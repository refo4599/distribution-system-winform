            var card = new Guna2Panel
            {
                Dock = DockStyle.Fill,
                FillColor = Color.White,
                BorderRadius = 16,
                BorderThickness = 0
            };
            card.ShadowDecoration.Enabled = true;
            card.ShadowDecoration.Depth = 15;
            card.ShadowDecoration.Color = Color.FromArgb(12, 0, 0, 0);

            // Left accent strip
            var strip = new Panel { Dock = DockStyle.Left, Width = 5, BackColor = accentColor };

            // Emoji circle
            var emojiPanel = new Panel
            {
                Size = new Size(48, 48),
                BackColor = bgColor,
                Anchor = AnchorStyles.None
            };
            emojiPanel.Paint += (s, pe) =>
            {
                pe.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
                using (var path = RoundPath(new Rectangle(0, 0, 47, 47), 12))
                using (var br = new SolidBrush(bgColor))
                    pe.Graphics.FillPath(br, path);
                using (var f = new Font("Segoe UI Emoji", 20F))
                    pe.Graphics.DrawString(emoji, f, Brushes.Black,
                        new RectangleF(0, 0, 48, 48),
                        new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
            };

            // Value label
            var lbl = new Label
            {
                Text = value,
                Font = new Font("Cairo", 22F, FontStyle.Bold),
                ForeColor = accentColor,
                AutoSize = false,
                Height = 36,
                Dock = DockStyle.Top,
                TextAlign = ContentAlignment.BottomRight,
                BackColor = Color.Transparent,
                Padding = new Padding(0, 0, 60, 0)
            };
            valueLabel = lbl;

            var lblTitle = new Label
            {
                Text = title,
                Font = new Font("Cairo", 9.5F),
                ForeColor = ColorTranslator.FromHtml("#6B7280"),
                AutoSize = false,
                Height = 20,
                Dock = DockStyle.Top,
                TextAlign = ContentAlignment.TopRight,
                BackColor = Color.Transparent,
                Padding = new Padding(0, 0, 60, 0)
            };

            var body = new Panel { Dock = DockStyle.Fill, BackColor = Color.Transparent, Padding = new Padding(12, 10, 12, 10) };
            body.Controls.Add(lbl);
            body.Controls.Add(lblTitle);

            card.Controls.Add(body);
