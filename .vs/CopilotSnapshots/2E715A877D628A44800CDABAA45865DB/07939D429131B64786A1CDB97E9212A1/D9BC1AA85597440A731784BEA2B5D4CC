        // ══════════════════════════════════════════════════════
        //  DATA
        // ══════════════════════════════════════════════════════
        private void LoadWarehouse()
        {
            try
            {
                var all = _service.GetAllBalances()?.ToList() ?? new List<WarehouseBalanceDto>();

                // Compute TotalCost per row
                foreach (var b in all)
                    b.TotalCost = b.Balance * b.AvgCost;

                _allBalances = all;
                _currentPage = Math.Min(_currentPage, TotalPages);

                var page = _allBalances.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();
                dgvWarehouse.DataSource = new BindingSource { DataSource = page };
                FitColumns();
                UpdateCards();
                RenderPagination();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"فشل تحميل المخزن: {GetInner(ex)}", "خطأ",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void UpdateCards()
        {
            int productCount = _allBalances.Select(x => x.ProductId).Distinct().Count();
            int totalQty = _allBalances.Sum(x => x.Balance);
            decimal totalVal;
            try { totalVal = _service.GetTotalInventoryValue(); }
            catch { totalVal = _allBalances.Sum(x => x.TotalCost); }

            if (lblProductCount != null) lblProductCount.Text = productCount.ToString("N0", Inv);
            if (lblTotalQty != null) lblTotalQty.Text = totalQty.ToString("N0", Inv);
            if (lblTotalValue != null) lblTotalValue.Text = totalVal.ToString("N2", Inv) + " ج";
        }

        private void FitColumns()
        {
            if (dgvWarehouse == null || dgvWarehouse.Columns.Count == 0) return;
            int w = dgvWarehouse.ClientSize.Width;
            if (w <= 0) return;

            int wName = (int)(w * 0.34);
            int wQty = (int)(w * 0.14);
            int wPrice = (int)(w * 0.24);
            int wTotal = w - wName - wQty - wPrice;

            dgvWarehouse.Columns["ProductName"].Width = Math.Max(120, wName);
            dgvWarehouse.Columns["Balance"].Width = Math.Max(70, wQty);
            dgvWarehouse.Columns["AvgCost"].Width = Math.Max(100, wPrice);
            dgvWarehouse.Columns["TotalCost"].Width = Math.Max(100, wTotal);
        }

        // ══════════════════════════════════════════════════════
        //  PAGINATION
        // ══════════════════════════════════════════════════════
        private void RenderPagination()
        {
            if (_paginationBar == null) return;
            _paginationBar.Controls.Clear();
            int total = TotalPages;

            var lblInfo = new Label
            {
                Text = $"عرض {Math.Min(_allBalances.Count, (_currentPage - 1) * PageSize + 1)}-{Math.Min(_allBalances.Count, _currentPage * PageSize)} من {_allBalances.Count}",
                Font = new Font("Cairo", 9.5F),
                ForeColor = ColorTranslator.FromHtml("#64748B"),
                AutoSize = false,
                Width = 180,
                Height = 52,
                TextAlign = ContentAlignment.MiddleRight,
                Dock = DockStyle.Right,
                BackColor = Color.Transparent
            };
            _paginationBar.Controls.Add(lblInfo);

            var pnlPages = new FlowLayoutPanel
            {
                Dock = DockStyle.Fill,
                FlowDirection = FlowDirection.RightToLeft,
                BackColor = Color.Transparent,
                WrapContents = false,
                AutoSize = false,
                Padding = new Padding(0)
            };
            pnlPages.Controls.Add(MakeNavBtn("›", _currentPage < total, () => { _currentPage++; LoadWarehouse(); }));
            for (int i = total; i >= 1; i--)
            {
                int pg = i; bool isCurrent = pg == _currentPage;
                var btn = new Panel { Size = new Size(34, 34), BackColor = Color.Transparent, Cursor = isCurrent ? Cursors.Default : Cursors.Hand, Margin = new Padding(3, 9, 3, 9) };
                btn.Paint += (s, pe) =>
                {
                    var g = pe.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
                    var rc = new Rectangle(0, 0, btn.Width - 1, btn.Height - 1);
                    if (isCurrent)
                    {
                        using (var br = new LinearGradientBrush(rc, ColorTranslator.FromHtml("#1a7a5e"), ColorTranslator.FromHtml("#0d3b2e"), LinearGradientMode.Vertical))
                        using (var path = RoundPath(rc, 7)) g.FillPath(br, path);
                        using (var f = new Font("Cairo", 10F, FontStyle.Bold))
                            g.DrawString(pg.ToString(), f, Brushes.White, rc, new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
                    }
                    else
                    {
                        using (var path = RoundPath(rc, 7))
                        { g.FillPath(new SolidBrush(ColorTranslator.FromHtml("#F8FAFC")), path); g.DrawPath(new Pen(ColorTranslator.FromHtml("#E2E8F0"), 1f), path); }
                        using (var f = new Font("Cairo", 10F))
                        using (var tb = new SolidBrush(ColorTranslator.FromHtml("#374151")))
                            g.DrawString(pg.ToString(), f, tb, rc, new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
                    }
                };
                if (!isCurrent) btn.Click += (s, e) => { _currentPage = pg; LoadWarehouse(); };
                pnlPages.Controls.Add(btn);
            }
            pnlPages.Controls.Add(MakeNavBtn("‹", _currentPage > 1, () => { _currentPage--; LoadWarehouse(); }));
            _paginationBar.Controls.Add(pnlPages);
        }

        private Panel MakeNavBtn(string text, bool enabled, Action onClick)
        {
            var btn = new Panel { Size = new Size(34, 34), BackColor = Color.Transparent, Cursor = enabled ? Cursors.Hand : Cursors.Default, Margin = new Padding(3, 9, 3, 9) };
            btn.Paint += (s, pe) =>
            {
                var g = pe.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
                var rc = new Rectangle(0, 0, btn.Width - 1, btn.Height - 1);
                using (var path = RoundPath(rc, 7))
                { g.FillPath(new SolidBrush(enabled ? ColorTranslator.FromHtml("#F8FAFC") : ColorTranslator.FromHtml("#F1F5F9")), path); g.DrawPath(new Pen(ColorTranslator.FromHtml("#E2E8F0"), 1f), path); }
                using (var f = new Font("Segoe UI", 13F))
                using (var tb = new SolidBrush(enabled ? ColorTranslator.FromHtml("#374151") : ColorTranslator.FromHtml("#CBD5E1")))
                    g.DrawString(text, f, tb, rc, new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
            };
            if (enabled) btn.Click += (s, e) => onClick();
            return btn;
        }

        // ══════════════════════════════════════════════════════
        //  CELL PAINTING
        // ══════════════════════════════════════════════════════
        private void Dgv_CellPainting(object sender, DataGridViewCellPaintingEventArgs e)
        {
            try
            {
                // ── Header ────────────────────────────────────
                if (e.RowIndex == -1)
                {
                    e.Handled = true;
                    var g = e.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
                    using (var br = new LinearGradientBrush(e.CellBounds,
                        ColorTranslator.FromHtml("#0d3b2e"), ColorTranslator.FromHtml("#124f3c"),
                        LinearGradientMode.Vertical))
                        g.FillRectangle(br, e.CellBounds);
                    using (var font = new Font("Cairo", 10.5F, FontStyle.Bold))
                    using (var tb = new SolidBrush(Color.White))
                        g.DrawString(e.Value?.ToString() ?? "", font, tb, e.CellBounds,
                            new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
                    using (var wPen = new Pen(ColorTranslator.FromHtml("#0d3b2e"), 2f))
                    {
                        g.DrawLine(wPen, e.CellBounds.Left, e.CellBounds.Top, e.CellBounds.Left, e.CellBounds.Bottom - 2);
                        g.DrawLine(wPen, e.CellBounds.Right - 1, e.CellBounds.Top, e.CellBounds.Right - 1, e.CellBounds.Bottom - 2);
                    }
                    return;
                }

                if (e.RowIndex < 0) return;

                bool sel = dgvWarehouse.Rows[e.RowIndex].Selected;
                Color bg = sel ? ColorTranslator.FromHtml("#ECFDF5")
                    : (e.RowIndex % 2 == 0 ? Color.White : ColorTranslator.FromHtml("#F0FDF4"));

                var col = dgvWarehouse.Columns[e.ColumnIndex].Name;

                if (col == "ProductName") PaintProductCell(e, bg);
                else if (col == "Balance") PaintQtyCell(e, bg);
                else if (col == "AvgCost" || col == "TotalCost") PaintPriceCell(e, bg);
                else
                {
                    e.Handled = true;
                    e.Graphics.FillRectangle(new SolidBrush(bg), e.CellBounds);
                    e.PaintContent(e.CellBounds);
                }

                // Row separator
                using (var linePen = new Pen(ColorTranslator.FromHtml("#E8F5E9"), 1f))
                    e.Graphics.DrawLine(linePen, e.CellBounds.Left, e.CellBounds.Bottom - 1, e.CellBounds.Right, e.CellBounds.Bottom - 1);
            }
            catch { }
        }

        private void PaintProductCell(DataGridViewCellPaintingEventArgs e, Color bg)
        {
            e.Handled = true;
            var g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;
            g.FillRectangle(new SolidBrush(bg), e.CellBounds);

            string name = e.Value?.ToString() ?? "";
            if (string.IsNullOrEmpty(name)) return;

            // Avatar circle
            Color[] palette = {
                ColorTranslator.FromHtml("#059669"), ColorTranslator.FromHtml("#1d4ed8"),
                ColorTranslator.FromHtml("#b45309"), ColorTranslator.FromHtml("#7c3aed"),
                ColorTranslator.FromHtml("#dc2626")
            };
            Color avatarColor = palette[e.RowIndex % palette.Length];

            int aw = 36, ah = 36;
            int ax = e.CellBounds.Right - 12 - aw;   // right-aligned inside cell (RTL)
            int ay = e.CellBounds.Top + (e.CellBounds.Height - ah) / 2;

            using (var br = new SolidBrush(avatarColor))
                g.FillEllipse(br, ax, ay, aw, ah);

            string letter = name.Length > 0 ? name[0].ToString() : "?";
            using (var lf = new Font("Cairo", 13F, FontStyle.Bold))
            {
                var lsz = g.MeasureString(letter, lf);
                g.DrawString(letter, lf, Brushes.White,
                    ax + (aw - lsz.Width) / 2f, ay + (ah - lsz.Height) / 2f);
            }

            // Product name — to the left of avatar (RTL)
            float textRight = ax - 10;
            using (var f = new Font("Cairo", 11F, FontStyle.Bold))
            using (var tb = new SolidBrush(ColorTranslator.FromHtml("#0F172A")))
            {
                var sf = new StringFormat { Alignment = StringAlignment.Far, LineAlignment = StringAlignment.Center, Trimming = StringTrimming.EllipsisCharacter };
                g.DrawString(name, f, tb,
                    new RectangleF(e.CellBounds.Left + 8, e.CellBounds.Top, textRight - e.CellBounds.Left - 8, e.CellBounds.Height),
                    sf);
            }
        }

        private void PaintQtyCell(DataGridViewCellPaintingEventArgs e, Color bg)
        {
            e.Handled = true;
            var g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;
            g.FillRectangle(new SolidBrush(bg), e.CellBounds);

            int qty = 0;
            try { qty = Convert.ToInt32(e.Value); } catch { }

            // Badge color: green if > 0, red if 0
            Color badgeColor = qty > 0 ? ColorTranslator.FromHtml("#059669") : ColorTranslator.FromHtml("#DC2626");
            Color badgeBg = qty > 0 ? ColorTranslator.FromHtml("#D1FAE5") : ColorTranslator.FromHtml("#FEE2E2");

            int pw = 60, ph = 28;
            int px = e.CellBounds.Left + (e.CellBounds.Width - pw) / 2;
            int py = e.CellBounds.Top + (e.CellBounds.Height - ph) / 2;
            var pillRc = new Rectangle(px, py, pw, ph);

            using (var path = RoundPath(pillRc, ph / 2))
            { g.FillPath(new SolidBrush(badgeBg), path); g.DrawPath(new Pen(badgeColor, 1f), path); }

            using (var f = new Font("Cairo", 10.5F, FontStyle.Bold))
            using (var tb = new SolidBrush(badgeColor))
                g.DrawString(qty.ToString("N0", Inv), f, tb,
                    new RectangleF(px, py, pw, ph),
                    new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
        }

        private void PaintPriceCell(DataGridViewCellPaintingEventArgs e, Color bg)
        {
            e.Handled = true;
            var g = e.Graphics;
            g.FillRectangle(new SolidBrush(bg), e.CellBounds);
            g.SmoothingMode = SmoothingMode.AntiAlias;

            decimal val = 0m;
            try { val = Convert.ToDecimal(e.Value); } catch { }

            string display = val.ToString("N2", Inv) + " ج";

            using (var f = new Font("Cairo", 11F, FontStyle.Bold))
            using (var tb = new SolidBrush(ColorTranslator.FromHtml("#0F172A")))
                g.DrawString(display, f, tb, e.CellBounds,
                    new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
        }

