using DistributionSystem.Business.Dtos;
using DistributionSystem.Business.Services;
using DistributionSystem.UI.Models;
using Guna.UI2.WinForms;
using System;
using System.Collections.Generic;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Globalization;
using System.Linq;
using System.Windows.Forms;

namespace DistributionSystem.UI.Forms
{
    public class TransactionsForm : Form
    {
        private Guna2DataGridView dgvTransactions;
        private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
        private readonly WarehouseService _service = new WarehouseService();

        public TransactionsForm()
        {
            RightToLeft = RightToLeft.Yes;
            RightToLeftLayout = true;
            BackColor = ColorTranslator.FromHtml("#EEF0F5");
            Dock = DockStyle.Fill;
            BuildLayout();
            Load += (s, e) => LoadTransactions();
            Resize += (s, e) => FitColumns();
        }

        private void BuildLayout()
        {
            var root = new TableLayoutPanel { Dock = DockStyle.Fill, ColumnCount = 1, RowCount = 2 };
            root.RowStyles.Add(new RowStyle(SizeType.Absolute, 88F));
            root.RowStyles.Add(new RowStyle(SizeType.Percent, 100F));

            root.Controls.Add(BuildHeader(), 0, 0);
            root.Controls.Add(BuildTableCard(), 0, 1);

            Controls.Add(root);
        }

        private Control BuildHeader()
        {
            var pnl = new Panel { Dock = DockStyle.Fill, BackColor = Color.Transparent };
            pnl.Paint += (s, e) =>
            {
                var g = e.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
                var rc = new Rectangle(0, 0, pnl.Width, pnl.Height);
                using (var br = new LinearGradientBrush(rc, ColorTranslator.FromHtml("#1a2f5e"), ColorTranslator.FromHtml("#1565c0"), LinearGradientMode.Horizontal))
                using (var path = RoundPath(rc, 16))
                    g.FillPath(br, path);

                using (var dot = new SolidBrush(Color.FromArgb(18, 255, 255, 255)))
                    for (int x = 10; x < pnl.Width; x += 22)
                        for (int y = 8; y < pnl.Height; y += 22)
                            g.FillEllipse(dot, x, y, 2, 2);

                using (var f = new Font("Cairo", 20F, FontStyle.Bold))
                using (var brush = new SolidBrush(Color.White))
                {
                    var title = "التنقلات";
                    var sz = g.MeasureString(title, f);
                    float x = (pnl.Width - sz.Width) / 2f;
                    float y = (pnl.Height - sz.Height) / 2f - 6;
                    g.DrawString(title, f, brush, x, y);
                }
            };
            return pnl;
        }

        private Control BuildTableCard()
        {
            var wrapper = new Panel { Dock = DockStyle.Fill, Padding = new Padding(12), BackColor = Color.Transparent };
            var card = new Guna2Panel { Dock = DockStyle.Fill, FillColor = Color.White, BorderRadius = 16 };

            dgvTransactions = new Guna2DataGridView
            {
                Dock = DockStyle.Fill,
                RightToLeft = RightToLeft.Yes,
                AutoGenerateColumns = false,
                ColumnHeadersHeight = 48,
                EnableHeadersVisualStyles = false,
                BackgroundColor = Color.White,
                BorderStyle = BorderStyle.None,
                SelectionMode = DataGridViewSelectionMode.FullRowSelect,
                RowHeadersVisible = false,
                AllowUserToAddRows = false,
                ReadOnly = true,
                CellBorderStyle = DataGridViewCellBorderStyle.None
            };
            dgvTransactions.RowTemplate.Height = 58;

            dgvTransactions.ColumnHeadersDefaultCellStyle.BackColor = ColorTranslator.FromHtml("#1a2f5e");
            dgvTransactions.ColumnHeadersDefaultCellStyle.ForeColor = Color.White;
            dgvTransactions.ColumnHeadersDefaultCellStyle.Font = new Font("Cairo", 10.5F, FontStyle.Bold);
            dgvTransactions.ColumnHeadersDefaultCellStyle.Alignment = DataGridViewContentAlignment.MiddleCenter;

            dgvTransactions.DefaultCellStyle.Font = new Font("Cairo", 11F);
            dgvTransactions.DefaultCellStyle.ForeColor = ColorTranslator.FromHtml("#374151");

            BuildColumns();

            dgvTransactions.CellPainting += DgvTransactions_CellPainting;
            dgvTransactions.Resize += (s, e) => FitColumns();

            card.Controls.Add(dgvTransactions);
            wrapper.Controls.Add(card);
            return wrapper;
        }

        private void BuildColumns()
        {
            dgvTransactions.Columns.Clear();

            dgvTransactions.Columns.Add(new DataGridViewTextBoxColumn
            { Name = "ProductName", HeaderText = "المنتج", DataPropertyName = "ProductName", Width = 200 });
            dgvTransactions.Columns.Add(new DataGridViewTextBoxColumn
            { Name = "TransactionType", HeaderText = "نوع الحركة", DataPropertyName = "TransactionType", Width = 130 });
            dgvTransactions.Columns.Add(new DataGridViewTextBoxColumn
            { Name = "Quantity", HeaderText = "الكمية", DataPropertyName = "Quantity", Width = 100 });
            dgvTransactions.Columns.Add(new DataGridViewTextBoxColumn
            { Name = "UnitCost", HeaderText = "سعر الوحدة", DataPropertyName = "UnitCost", Width = 130 });
            dgvTransactions.Columns.Add(new DataGridViewTextBoxColumn
            { Name = "TotalValue", HeaderText = "الإجمالي", DataPropertyName = "TotalValue", Width = 130 });
            dgvTransactions.Columns.Add(new DataGridViewTextBoxColumn
            { Name = "CreatedAt", HeaderText = "التاريخ", DataPropertyName = "CreatedAt", Width = 160 });

            foreach (DataGridViewColumn c in dgvTransactions.Columns)
                c.DefaultCellStyle.Alignment = DataGridViewContentAlignment.MiddleCenter;
        }

        private void FitColumns()
        {
            if (dgvTransactions == null || dgvTransactions.Columns.Count == 0) return;
            int w = dgvTransactions.ClientSize.Width;
            if (w <= 0) return;

            int c0 = (int)(w * 0.26);
            int c1 = (int)(w * 0.16);
            int c2 = (int)(w * 0.11);
            int c3 = (int)(w * 0.15);
            int c4 = (int)(w * 0.15);
            int c5 = w - c0 - c1 - c2 - c3 - c4;

            dgvTransactions.Columns["ProductName"].Width = Math.Max(120, c0);
            dgvTransactions.Columns["TransactionType"].Width = Math.Max(90, c1);
            dgvTransactions.Columns["Quantity"].Width = Math.Max(70, c2);
            dgvTransactions.Columns["UnitCost"].Width = Math.Max(90, c3);
            dgvTransactions.Columns["TotalValue"].Width = Math.Max(100, c4);
            dgvTransactions.Columns["CreatedAt"].Width = Math.Max(120, c5);
        }

        // ══════════════════════════════════════════════════════
        //  LOAD DATA
        // ══════════════════════════════════════════════════════
        private void LoadTransactions()
        {
            try
            {
                var data = _service.GetAllTransactions()?.ToList()
                           ?? new List<DistributionSystem.Business.Dtos.WarehouseTransactionViewDto>();

                // ترجمة نوع الحركة للعربي (use C#7-compatible code)
                foreach (var item in data)
                {
                    if (string.Equals(item.TransactionType, "Inbound", StringComparison.OrdinalIgnoreCase))
                        item.TransactionType = "وارد";
                    else if (string.Equals(item.TransactionType, "CarLoad", StringComparison.OrdinalIgnoreCase))
                        item.TransactionType = "تحميل سيارة";
                    else if (string.Equals(item.TransactionType, "Return", StringComparison.OrdinalIgnoreCase))
                        item.TransactionType = "مرتجع";
                    else if (string.Equals(item.TransactionType, "Outbound", StringComparison.OrdinalIgnoreCase))
                        item.TransactionType = "صادر";
                }

                dgvTransactions.DataSource = new BindingSource { DataSource = data };
                FitColumns();
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "فشل تحميل التنقلات: " + ex.Message,
                    "خطأ",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
        }

        // ══════════════════════════════════════════════════════
        //  CELL PAINTING
        // ══════════════════════════════════════════════════════
        private void DgvTransactions_CellPainting(object sender, DataGridViewCellPaintingEventArgs e)
        {
            try
            {
                if (e.RowIndex == -1)
                {
                    e.Handled = true;
                    e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
                    using (var br = new SolidBrush(ColorTranslator.FromHtml("#1a2f5e")))
                        e.Graphics.FillRectangle(br, e.CellBounds);
                    using (var f = new Font("Cairo", 10.5F, FontStyle.Bold))
                    using (var tb = new SolidBrush(Color.White))
                        e.Graphics.DrawString(e.Value?.ToString() ?? "", f, tb, e.CellBounds,
                            new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
                    return;
                }

                if (e.RowIndex < 0) return;

                e.Handled = true;
                var g = e.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
                var bg = (e.RowIndex % 2 == 0) ? Color.White : ColorTranslator.FromHtml("#F8FAFF");
                g.FillRectangle(new SolidBrush(bg), e.CellBounds);

                var col = dgvTransactions.Columns[e.ColumnIndex].Name;

                if (col == "ProductName")
                {
                    string name = e.Value?.ToString() ?? "";
                    Color[] palette = {
                        ColorTranslator.FromHtml("#059669"),
                        ColorTranslator.FromHtml("#1d4ed8"),
                        ColorTranslator.FromHtml("#b45309"),
                        ColorTranslator.FromHtml("#7c3aed"),
                        ColorTranslator.FromHtml("#dc2626")
                    };
                    var avatarColor = palette[e.RowIndex % palette.Length];

                    int aw = 36, ah = 36;
                    int ax = e.CellBounds.Right - 12 - aw;
                    int ay = e.CellBounds.Top + (e.CellBounds.Height - ah) / 2;
                    using (var br = new SolidBrush(avatarColor))
                        g.FillEllipse(br, ax, ay, aw, ah);
                    string letter = string.IsNullOrEmpty(name) ? "?" : name[0].ToString();
                    using (var lf = new Font("Cairo", 13F, FontStyle.Bold))
                    {
                        var lsz = g.MeasureString(letter, lf);
                        g.DrawString(letter, lf, Brushes.White,
                            ax + (aw - lsz.Width) / 2f,
                            ay + (ah - lsz.Height) / 2f);
                    }
                    var sf = new StringFormat
                    {
                        Alignment = StringAlignment.Far,
                        LineAlignment = StringAlignment.Center,
                        Trimming = StringTrimming.EllipsisCharacter
                    };
                    using (var f = new Font("Cairo", 11F, FontStyle.Bold))
                    using (var tb = new SolidBrush(ColorTranslator.FromHtml("#0F172A")))
                        g.DrawString(name, f, tb,
                            new RectangleF(e.CellBounds.Left + 8, e.CellBounds.Top,
                                ax - 10 - e.CellBounds.Left, e.CellBounds.Height), sf);
                }
                else if (col == "TransactionType")
                {
                    string val = e.Value?.ToString() ?? "";
                    Color badgeColor = ColorTranslator.FromHtml("#059669");
                    Color badgeBg = ColorTranslator.FromHtml("#ECFDF5");

                    if (val == "تحميل سيارة") { badgeColor = ColorTranslator.FromHtml("#D97706"); badgeBg = ColorTranslator.FromHtml("#FFFBEB"); }
                    else if (val == "مرتجع") { badgeColor = ColorTranslator.FromHtml("#7C3AED"); badgeBg = ColorTranslator.FromHtml("#F5F3FF"); }
                    else if (val == "صادر") { badgeColor = ColorTranslator.FromHtml("#DC2626"); badgeBg = ColorTranslator.FromHtml("#FEF2F2"); }

                    int pw = 100, ph = 28;
                    int px = e.CellBounds.Left + (e.CellBounds.Width - pw) / 2;
                    int py = e.CellBounds.Top + (e.CellBounds.Height - ph) / 2;
                    var pill = new Rectangle(px, py, pw, ph);
                    using (var path = RoundPath(pill, ph / 2))
                    {
                        g.FillPath(new SolidBrush(badgeBg), path);
                        g.DrawPath(new Pen(badgeColor, 1f), path);
                    }
                    using (var f = new Font("Cairo", 10.5F, FontStyle.Bold))
                    using (var tb = new SolidBrush(badgeColor))
                        g.DrawString(val, f, tb, pill,
                            new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
                }
                else if (col == "Quantity")
                {
                    int qty = 0; try { qty = Convert.ToInt32(e.Value); } catch { }
                    Color badgeColor = qty >= 0 ? ColorTranslator.FromHtml("#1d4ed8") : ColorTranslator.FromHtml("#dc2626");
                    Color badgeBg = qty >= 0 ? ColorTranslator.FromHtml("#EFF6FF") : ColorTranslator.FromHtml("#FEF2F2");
                    int pw = 80, ph = 28;
                    int px = e.CellBounds.Left + (e.CellBounds.Width - pw) / 2;
                    int py = e.CellBounds.Top + (e.CellBounds.Height - ph) / 2;
                    var pill = new Rectangle(px, py, pw, ph);
                    using (var path = RoundPath(pill, ph / 2))
                    {
                        g.FillPath(new SolidBrush(badgeBg), path);
                        g.DrawPath(new Pen(badgeColor, 1f), path);
                    }
                    using (var f = new Font("Cairo", 10.5F, FontStyle.Bold))
                    using (var tb = new SolidBrush(badgeColor))
                        g.DrawString(qty.ToString("N0", Inv), f, tb, pill,
                            new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
                }
                else if (col == "UnitCost" || col == "TotalValue")
                {
                    decimal val = 0m; try { val = Convert.ToDecimal(e.Value); } catch { }
                    string display = val.ToString("N2", Inv) + " ج";
                    using (var f = new Font("Cairo", 11F, FontStyle.Bold))
                    using (var tb = new SolidBrush(ColorTranslator.FromHtml("#0F172A")))
                        g.DrawString(display, f, tb, e.CellBounds,
                            new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
                }
                else if (col == "CreatedAt")
                {
                    DateTime dt = DateTime.MinValue;
                    try { dt = Convert.ToDateTime(e.Value); } catch { }
                    string display = dt == DateTime.MinValue
                        ? ""
                        : dt.ToString("yyyy-MM-dd HH:mm", Inv);
                    using (var f = new Font("Cairo", 10F))
                    using (var tb = new SolidBrush(ColorTranslator.FromHtml("#374151")))
                        g.DrawString(display, f, tb, e.CellBounds,
                            new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
                }

                using (var linePen = new Pen(ColorTranslator.FromHtml("#E8F5E9"), 1f))
                    g.DrawLine(linePen,
                        e.CellBounds.Left, e.CellBounds.Bottom - 1,
                        e.CellBounds.Right, e.CellBounds.Bottom - 1);
            }
            catch { }
        }

        // ══════════════════════════════════════════════════════
        //  HELPER
        // ══════════════════════════════════════════════════════
        private GraphicsPath RoundPath(Rectangle r, int radius)
        {
            int d = radius * 2;
            var path = new GraphicsPath();
            path.AddArc(r.Left, r.Top, d, d, 180, 90);
            path.AddArc(r.Right - d, r.Top, d, d, 270, 90);
            path.AddArc(r.Right - d, r.Bottom - d, d, d, 0, 90);
            path.AddArc(r.Left, r.Bottom - d, d, d, 90, 90);
            path.CloseFigure();
            return path;
        }
    }
}