        private void SetActiveButton(Guna2Button active)
        {
            var buttons = new[] { btnDashboard, btnProducts, btnCustomers, btnInbound, btnWarehouse, btnTransactions, btnCars, btnEmployees, btnLogout };
            foreach (var b in buttons)
            {
                if (b == null) continue;
                if (b == active)
                {
                    b.FillColor = ColorTranslator.FromHtml("#4E73DF");
                    b.ForeColor = Color.White;
                }
                else
                {
                    b.FillColor = ColorTranslator.FromHtml("#111827");
                    b.ForeColor = Color.White;
                }
            }
        }
