        private void HeaderPanel_Paint(object sender, PaintEventArgs e)
        {
            var g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;
            var rc = new Rectangle(0, 0, headerPanel.Width, headerPanel.Height);

            using (var br = new LinearGradientBrush(rc,
                ColorTranslator.FromHtml("#1a2f5e"),
                ColorTranslator.FromHtml("#1565c0"),
                LinearGradientMode.Horizontal))
            using (var path = RoundPath(rc, 0))
            {
                g.FillRectangle(br, rc);
            }

            // Dot overlay
            using (var dot = new SolidBrush(Color.FromArgb(18, 255, 255, 255)))
                for (int x = 10; x < headerPanel.Width; x += 22)
                    for (int y = 8; y < headerPanel.Height; y += 22)
                        g.FillEllipse(dot, x, y, 2, 2);

            // Centered title via manual measurement (RTL-safe)
            string title = "نظام إدارة التوزيع والمخازن";
            using (var f = new Font("Cairo", 20F, FontStyle.Bold))
            using (var brush = new SolidBrush(Color.White))
            {
                var sz = g.MeasureString(title, f);
                float x = (headerPanel.Width - sz.Width) / 2f;
                float y = (headerPanel.Height - sz.Height) / 2f - 4;
                g.DrawString(title, f, brush, x, y);
            }
        }

        private GraphicsPath RoundPath(Rectangle r, int radius)
        {
            var path = new GraphicsPath();
            if (radius <= 0) { path.AddRectangle(r); return path; }
            int d = radius * 2;
            path.AddArc(r.Left, r.Top, d, d, 180, 90);
            path.AddArc(r.Right - d, r.Top, d, d, 270, 90);
            path.AddArc(r.Right - d, r.Bottom - d, d, d, 0, 90);
            path.AddArc(r.Left, r.Bottom - d, d, d, 90, 90);
            path.CloseFigure();
            return path;
        }

