                }

                btnSave.Enabled = false; btnSave.Text = "جارٍ الحفظ...";
                try
                {
                    var dto = new SalesInvoiceDto
                    {
                        VehicleId = vId,
                        CustomerId = cId,
                        PaymentType = rbCash.Checked ? "Cash" : "Credit",
                        PaidAmount = paidNow
                    };
                    foreach (var row in validRows) dto.Items.Add(new SalesInvoiceItemDto
                    {
                        ProductId = Convert.ToInt32(row.cboProd.SelectedValue),
                        Quantity = Convert.ToInt32(row.txtQty.Text),
                        SalePrice = decimal.Parse(row.txtPrice.Text)
                    });
                    await Task.Run(() => _invoiceService.SaveInvoice(dto));
                    LoadData(); close(); ShowSuccessToast("تم حفظ الفاتورة ✓");
                }
                catch (Exception ex) { ShowErrorToast("فشل: " + GetInner(ex)); }
                finally { btnSave.Enabled = true; btnSave.Text = "💾  حفظ الفاتورة"; }
            };
            footer.Controls.Add(btnSave);
            popup.Controls.Add(footer);

            pf.Shown += (s, e) => { if (cboVeh.Items.Count > 0) cboVeh.SelectedIndex = 0; if (cboCust.Items.Count > 0) cboCust.SelectedIndex = 0; };
            pf.ShowDialog(this);
        }

