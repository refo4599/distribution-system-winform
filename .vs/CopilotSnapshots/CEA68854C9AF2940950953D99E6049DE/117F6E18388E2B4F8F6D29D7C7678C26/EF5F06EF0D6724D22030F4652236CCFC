        private void RenderPagination()
        {
            if (_pagBar == null) return; _pagBar.Controls.Clear();
            int total = TotalPages;
            var lblInfo = new Label
            {
                Text = $"عرض {Math.Min(_allInvoices.Count, (_currentPage - 1) * PageSize + 1)}-{Math.Min(_allInvoices.Count, _currentPage * PageSize)} من {_allInvoices.Count}",
                Font = new Font("Cairo", 9.5F),
                ForeColor = ColorTranslator.FromHtml("#64748B"),
                AutoSize = false,
                Width = 180,
                Height = 52,
                TextAlign = ContentAlignment.MiddleRight,
                Dock = DockStyle.Right,
                BackColor = Color.Transparent
            };
            _pagBar.Controls.Add(lblInfo);
            var pnl = new FlowLayoutPanel { Dock = DockStyle.Fill, FlowDirection = FlowDirection.RightToLeft, BackColor = Color.Transparent, WrapContents = false, Padding = new Padding(0) };
            pnl.Controls.Add(NavBtn("›", _currentPage < total, () => { _currentPage++; LoadData(); }));
            for (int i = total; i >= 1; i--)
            {
                int pg = i; bool isCur = pg == _currentPage;
                var btn = new Panel { Size = new Size(34, 34), BackColor = Color.Transparent, Cursor = isCur ? Cursors.Default : Cursors.Hand, Margin = new Padding(3, 9, 3, 9) };
                btn.Paint += (s, pe) => {
                    var g = pe.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias; var rc = new Rectangle(0, 0, btn.Width - 1, btn.Height - 1);
                    if (isCur)
                    {
                        using (var br = new LinearGradientBrush(rc, ColorTranslator.FromHtml("#4338ca"), ColorTranslator.FromHtml("#1e1b4b"), LinearGradientMode.Vertical))
                        using (var path = RoundPath(rc, 7)) g.FillPath(br, path);
                        using (var f = new Font("Cairo", 10F, FontStyle.Bold)) g.DrawString(pg.ToString(), f, Brushes.White, rc, new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
                    }
                    else
                    {
                        using (var path = RoundPath(rc, 7)) { g.FillPath(new SolidBrush(ColorTranslator.FromHtml("#F8FAFC")), path); g.DrawPath(new Pen(ColorTranslator.FromHtml("#E2E8F0"), 1f), path); }
                        using (var f = new Font("Cairo", 10F)) using (var tb = new SolidBrush(ColorTranslator.FromHtml("#374151"))) g.DrawString(pg.ToString(), f, tb, rc, new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
                    }
                };
                if (!isCur) btn.Click += (s, e) => { _currentPage = pg; LoadData(); };
                pnl.Controls.Add(btn);
            }
            pnl.Controls.Add(NavBtn("‹", _currentPage > 1, () => { _currentPage--; LoadData(); }));
            _pagBar.Controls.Add(pnl);
        }

        private Panel NavBtn(string text, bool en, Action onClick)
        {
            var btn = new Panel { Size = new Size(34, 34), BackColor = Color.Transparent, Cursor = en ? Cursors.Hand : Cursors.Default, Margin = new Padding(3, 9, 3, 9) };
            btn.Paint += (s, pe) => {
                var g = pe.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias; var rc = new Rectangle(0, 0, btn.Width - 1, btn.Height - 1);
                using (var path = RoundPath(rc, 7)) { g.FillPath(new SolidBrush(en ? ColorTranslator.FromHtml("#F8FAFC") : ColorTranslator.FromHtml("#F1F5F9")), path); g.DrawPath(new Pen(ColorTranslator.FromHtml("#E2E8F0"), 1f), path); }
                using (var f = new Font("Segoe UI", 13F)) using (var tb = new SolidBrush(en ? ColorTranslator.FromHtml("#374151") : ColorTranslator.FromHtml("#CBD5E1")))
                    g.DrawString(text, f, tb, rc, new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
            };
            if (en) btn.Click += (s, e) => onClick();
            return btn;
        }

