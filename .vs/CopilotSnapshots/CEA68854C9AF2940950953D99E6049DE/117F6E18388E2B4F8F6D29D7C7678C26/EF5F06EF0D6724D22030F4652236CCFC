        }

        private void FitColumns()
        {
            if (dgv == null || dgv.Columns.Count == 0) return;
            int w = dgv.ClientSize.Width; if (w <= 0) return;
            int wId = (int)(w * 0.05), wCust = (int)(w * 0.11), wVeh = (int)(w * 0.10), wRep = (int)(w * 0.09),
                wTot = (int)(w * 0.09), wPaid = (int)(w * 0.09), wRem = (int)(w * 0.09), wPt = (int)(w * 0.08), wSt = (int)(w * 0.08), wDt = (int)(w * 0.11);
            int wAct = w - wId - wCust - wVeh - wRep - wTot - wPaid - wRem - wPt - wSt - wDt;
            dgv.Columns["SId"].Width = Math.Max(40, wId);
            dgv.Columns["SCustomer"].Width = Math.Max(90, wCust);
            dgv.Columns["SVehicle"].Width = Math.Max(80, wVeh);
            dgv.Columns["SRep"].Width = Math.Max(80, wRep);
            dgv.Columns["STotal"].Width = Math.Max(80, wTot);
            dgv.Columns["SPaid"].Width = Math.Max(80, wPaid);
            dgv.Columns["SRemaining"].Width = Math.Max(80, wRem);
            dgv.Columns["SPayType"].Width = Math.Max(70, wPt);
            dgv.Columns["SStatus"].Width = Math.Max(70, wSt);
            dgv.Columns["SDate"].Width = Math.Max(100, wDt);
            dgv.Columns["SActions"].Width = Math.Max(90, wAct);
        }

        // ══════════════════════════════════════════════════════
        //  LOAD DATA
        // ══════════════════════════════════════════════════════
        private void LoadData()
        {
            try
            {
                _allInvoices = _invoiceService.GetAllInvoices()?.ToList() ?? new List<SalesInvoiceDto>();
                _currentPage = Math.Min(_currentPage, TotalPages);
                var page = _allInvoices.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();
                dgv.DataSource = new BindingSource { DataSource = page };
                FitColumns();
                UpdateCards();
                RenderPagination();
            }
            catch (Exception ex) { ShowErrorToast("خطأ في التحميل: " + GetInner(ex)); }
        }

        private void UpdateCards()
        {
            int total = _allInvoices.Count;
            decimal paid = _allInvoices.Sum(x => x.PaidAmount);
            decimal remain = _allInvoices.Sum(x => x.Remaining);
            if (lblTotalInvoices != null) lblTotalInvoices.Text = total.ToString("N0", Inv) + " فاتورة";
            if (lblTotalPaid != null) lblTotalPaid.Text = paid.ToString("N2", Inv) + " ج";
            if (lblTotalRemaining != null) lblTotalRemaining.Text = remain.ToString("N2", Inv) + " ج";
        }

        // ══════════════════════════════════════════════════════
        //  CELL PAINTING
        // ══════════════════════════════════════════════════════
        private void Dgv_CellPainting(object sender, DataGridViewCellPaintingEventArgs e)
        {
            try
            {
                if (e.RowIndex == -1)
                {
                    e.Handled = true; var g = e.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
                    using (var br = new LinearGradientBrush(e.CellBounds, ColorTranslator.FromHtml("#1e1b4b"), ColorTranslator.FromHtml("#312e81"), LinearGradientMode.Vertical))
                        g.FillRectangle(br, e.CellBounds);
                    using (var f = new Font("Cairo", 10.5F, FontStyle.Bold)) using (var tb = new SolidBrush(Color.White))
                        g.DrawString(e.Value?.ToString() ?? "", f, tb, e.CellBounds, new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
                    return;
                }
                if (e.RowIndex < 0) return;

                bool sel = dgv.Rows[e.RowIndex].Selected;
                Color bg = sel ? ColorTranslator.FromHtml("#EEF2FF") : (e.RowIndex % 2 == 0 ? Color.White : ColorTranslator.FromHtml("#F5F3FF"));
                string col = dgv.Columns[e.ColumnIndex].Name;

                if (col == "SStatus") PaintStatusBadge(e, bg);
                else if (col == "SPayType") PaintPayTypeBadge(e, bg);
                else if (col == "SActions") PaintActions(e, bg);
                else if (col == "STotal" || col == "SPaid" || col == "SRemaining") PaintMoneyCell(e, bg, col);
                else if (col == "SDate") PaintDateCell(e, bg);
                else if (col == "SCustomer") PaintCustomerCell(e, bg);
                else
                {
                    e.Handled = true;
                    e.Graphics.FillRectangle(new SolidBrush(bg), e.CellBounds);
                    e.PaintContent(e.CellBounds);
                }
                using (var lp = new Pen(ColorTranslator.FromHtml("#EDE9FE"), 1f))
                    e.Graphics.DrawLine(lp, e.CellBounds.Left, e.CellBounds.Bottom - 1, e.CellBounds.Right, e.CellBounds.Bottom - 1);
            }
            catch { }
        }

        private void PaintStatusBadge(DataGridViewCellPaintingEventArgs e, Color bg)
        {
            e.Handled = true; var g = e.Graphics; g.SetClip(e.CellBounds);
            g.FillRectangle(new SolidBrush(bg), e.CellBounds); g.SmoothingMode = SmoothingMode.AntiAlias;
            string status = e.Value?.ToString() ?? "";
            bool completed = status == "Completed";
            Color pillBg = completed ? ColorTranslator.FromHtml("#D1FAE5") : ColorTranslator.FromHtml("#FEF3C7");
            Color pillBdr = completed ? ColorTranslator.FromHtml("#A7F3D0") : ColorTranslator.FromHtml("#FDE68A");
            Color dotC = completed ? ColorTranslator.FromHtml("#059669") : ColorTranslator.FromHtml("#D97706");
            Color textC = completed ? ColorTranslator.FromHtml("#065F46") : ColorTranslator.FromHtml("#92400E");
            string txt = completed ? "مكتمل" : "جاري";
            int pw = 72, ph = 26, px = e.CellBounds.Left + (e.CellBounds.Width - pw) / 2, py = e.CellBounds.Top + (e.CellBounds.Height - ph) / 2;
            var pillRc = new Rectangle(px, py, pw, ph);
            using (var path = RoundPath(pillRc, ph / 2)) { g.FillPath(new SolidBrush(pillBg), path); g.DrawPath(new Pen(pillBdr, 1f), path); }
            g.FillEllipse(new SolidBrush(dotC), px + 8, py + (ph - 8) / 2, 8, 8);
            using (var f = new Font("Cairo", 9.5F, FontStyle.Bold)) using (var tb = new SolidBrush(textC))
                g.DrawString(txt, f, tb, new RectangleF(px + 10, py, pw - 10, ph), new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
            g.ResetClip();
        }

        private void PaintPayTypeBadge(DataGridViewCellPaintingEventArgs e, Color bg)
