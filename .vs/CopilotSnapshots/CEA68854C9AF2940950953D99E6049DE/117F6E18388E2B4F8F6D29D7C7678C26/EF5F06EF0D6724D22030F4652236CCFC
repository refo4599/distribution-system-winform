                Animated = true
            };
            btnSave.HoverState.FillColor = ColorTranslator.FromHtml("#1e1b4b");
            btnSave.Click += async (s, e) =>
            {
                if (!decimal.TryParse(txtAmt.Text, out decimal amt) || amt <= 0 || amt > dto.Remaining)
                { txtAmt.BorderColor = ColorTranslator.FromHtml("#EF4444"); ShowErrorToast($"المبلغ يجب أن يكون بين 0.01 و {dto.Remaining.ToString("N2", Inv)}"); return; }
