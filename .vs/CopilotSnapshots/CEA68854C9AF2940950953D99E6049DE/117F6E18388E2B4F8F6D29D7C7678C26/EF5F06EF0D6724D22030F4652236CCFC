            Color textC = cash ? ColorTranslator.FromHtml("#1D4ED8") : ColorTranslator.FromHtml("#6D28D9");
            string txt = cash ? "كاش" : "آجل";
            int pw = 60, ph = 26, px = e.CellBounds.Left + (e.CellBounds.Width - pw) / 2, py = e.CellBounds.Top + (e.CellBounds.Height - ph) / 2;
            var pillRc = new Rectangle(px, py, pw, ph);
            using (var path = RoundPath(pillRc, ph / 2)) { g.FillPath(new SolidBrush(pillBg), path); g.DrawPath(new Pen(pillBdr, 1f), path); }
            using (var f = new Font("Cairo", 9.5F, FontStyle.Bold)) using (var tb = new SolidBrush(textC))
                g.DrawString(txt, f, tb, new RectangleF(px, py, pw, ph), new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
            g.ResetClip();
        }

        private void PaintMoneyCell(DataGridViewCellPaintingEventArgs e, Color bg, string col)
        {
            e.Handled = true; var g = e.Graphics; g.FillRectangle(new SolidBrush(bg), e.CellBounds);
            decimal val = 0m; try { val = Convert.ToDecimal(e.Value); } catch { }
            Color textColor = col == "SRemaining" && val > 0
                ? ColorTranslator.FromHtml("#D97706")
                : col == "SRemaining"
                    ? ColorTranslator.FromHtml("#059669")
                    : ColorTranslator.FromHtml("#0F172A");
            using (var f = new Font("Cairo", 10.5F, FontStyle.Bold)) using (var tb = new SolidBrush(textColor))
                g.DrawString(val.ToString("N2", Inv) + " ج", f, tb, e.CellBounds, new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
        }

        private void PaintDateCell(DataGridViewCellPaintingEventArgs e, Color bg)
        {
            e.Handled = true; var g = e.Graphics; g.FillRectangle(new SolidBrush(bg), e.CellBounds);
            string txt = e.Value?.ToString() ?? "";
            if (DateTime.TryParse(txt, out DateTime dt)) txt = dt.ToString("yyyy/MM/dd", Inv) + "\n" + dt.ToString("HH:mm", Inv);
            using (var f = new Font("Cairo", 9.5F)) using (var tb = new SolidBrush(ColorTranslator.FromHtml("#64748B")))
                g.DrawString(txt, f, tb, e.CellBounds, new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
        }

        private void PaintCustomerCell(DataGridViewCellPaintingEventArgs e, Color bg)
        {
            e.Handled = true; var g = e.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
            g.FillRectangle(new SolidBrush(bg), e.CellBounds);
            string name = e.Value?.ToString() ?? "";
            Color[] palette ={ColorTranslator.FromHtml("#4338ca"),ColorTranslator.FromHtml("#059669"),
                ColorTranslator.FromHtml("#D97706"),ColorTranslator.FromHtml("#DC2626"),ColorTranslator.FromHtml("#0891B2")};
            Color aColor = palette[e.RowIndex % palette.Length];
            int aw = 32, ah = 32, ax = e.CellBounds.Right - 12 - aw, ay = e.CellBounds.Top + (e.CellBounds.Height - ah) / 2;
            using (var br = new SolidBrush(aColor)) g.FillEllipse(br, ax, ay, aw, ah);
            string letter = name.Length > 0 ? name[0].ToString() : "?";
            using (var lf = new Font("Cairo", 11F, FontStyle.Bold)) { var lsz = g.MeasureString(letter, lf); g.DrawString(letter, lf, Brushes.White, ax + (aw - lsz.Width) / 2f, ay + (ah - lsz.Height) / 2f); }
            float textRight = ax - 8;
            using (var f = new Font("Cairo", 10.5F, FontStyle.Bold)) using (var tb = new SolidBrush(ColorTranslator.FromHtml("#0F172A")))
            {
                var sf = new StringFormat { Alignment = StringAlignment.Far, LineAlignment = StringAlignment.Center, Trimming = StringTrimming.EllipsisCharacter };
                g.DrawString(name, f, tb, new RectangleF(e.CellBounds.Left + 4, e.CellBounds.Top, textRight - e.CellBounds.Left - 4, e.CellBounds.Height), sf);
            }
        }

        private void PaintActions(DataGridViewCellPaintingEventArgs e, Color bg)
        {
            e.Handled = true; var g = e.Graphics; g.SetClip(e.CellBounds);
            g.FillRectangle(new SolidBrush(bg), e.CellBounds); g.SmoothingMode = SmoothingMode.AntiAlias;

            var dto = dgv.Rows[e.RowIndex].DataBoundItem as SalesInvoiceDto;
            bool isPending = dto?.Status == "Pending";
            int btnH = 30, btnY = e.CellBounds.Top + (e.CellBounds.Height - btnH) / 2;
            int payW = isPending ? 56 : 0, delW = 30, gap = isPending ? 8 : 0;
            int totalW = payW + gap + delW;
            int startX = e.CellBounds.Left + (e.CellBounds.Width - totalW) / 2;

            if (isPending)
            {
                var payRect = new Rectangle(startX, btnY, payW, btnH);
                using (var path = RoundPath(payRect, 8)) { g.FillPath(new SolidBrush(ColorTranslator.FromHtml("#EEF2FF")), path); g.DrawPath(new Pen(ColorTranslator.FromHtml("#C7D2FE"), 1f), path); }
                using (var f = new Font("Cairo", 9.5F, FontStyle.Bold)) using (var tb = new SolidBrush(ColorTranslator.FromHtml("#4338ca")))
                { var sz = g.MeasureString("دفعة", f); g.DrawString("دفعة", f, tb, payRect.Left + (payRect.Width - sz.Width) / 2f, payRect.Top + (payRect.Height - sz.Height) / 2f); }
                startX += payW + gap;
            }

            var delRect = new Rectangle(startX, btnY, delW, btnH);
            using (var path = RoundPath(delRect, 8)) { g.FillPath(new SolidBrush(ColorTranslator.FromHtml("#FEF2F2")), path); g.DrawPath(new Pen(ColorTranslator.FromHtml("#FECACA"), 1f), path); }
            using (var pen = new Pen(ColorTranslator.FromHtml("#EF4444"), 1.6f))
            {
                int cx = delRect.Left + delRect.Width / 2, cy = delRect.Top + delRect.Height / 2;
                g.DrawLine(pen, cx - 5, cy - 4, cx + 5, cy - 4); g.DrawLine(pen, cx - 2, cy - 6, cx + 2, cy - 6);
                g.DrawRectangle(pen, cx - 4, cy - 3, 8, 7); g.DrawLine(pen, cx - 1, cy - 1, cx - 1, cy + 3); g.DrawLine(pen, cx + 1, cy - 1, cx + 1, cy + 3);
            }
            g.ResetClip();
        }

        // ══════════════════════════════════════════════════════
        //  CELL CLICK
        // ══════════════════════════════════════════════════════
        private void Dgv_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0 || e.ColumnIndex < 0) return;
            if (dgv.Columns[e.ColumnIndex].Name != "SActions") return;
            var dto = dgv.Rows[e.RowIndex].DataBoundItem as SalesInvoiceDto;
            if (dto == null) return;
            var cell = dgv.GetCellDisplayRectangle(e.ColumnIndex, e.RowIndex, false);
            var mouse = dgv.PointToClient(Cursor.Position);
            bool isPending = dto.Status == "Pending";
            int btnH = 30, btnY = cell.Top + (cell.Height - btnH) / 2;
            int payW = isPending ? 56 : 0, delW = 30, gap = isPending ? 8 : 0;
            int totalW = payW + gap + delW;
            int startX = cell.Left + (cell.Width - totalW) / 2;

            if (isPending)
            {
                var payRect = new Rectangle(startX, btnY, payW, btnH);
                if (payRect.Contains(mouse)) { ShowPaymentPopup(dto); return; }
                startX += payW + gap;
            }
            var delRect = new Rectangle(startX, btnY, delW, btnH);
            if (delRect.Contains(mouse))
            {
                if (MessageBox.Show($"هل تريد حذف الفاتورة #{dto.Id}؟", "تأكيد", MessageBoxButtons.YesNo, MessageBoxIcon.Warning) == DialogResult.Yes)
                    try { _invoiceService.DeleteInvoice(dto.Id); LoadData(); ShowSuccessToast("تم حذف الفاتورة ✓"); }
                    catch (Exception ex) { ShowErrorToast("فشل الحذف: " + GetInner(ex)); }
            }
        }

