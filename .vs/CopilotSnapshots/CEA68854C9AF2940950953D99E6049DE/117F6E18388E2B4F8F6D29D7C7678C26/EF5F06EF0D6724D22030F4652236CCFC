        private void BuildColumns()
        {
            dgv.Columns.Clear();
            void Add(string name, string hdr, string prop, int w) => dgv.Columns.Add(new DataGridViewTextBoxColumn { Name = name, HeaderText = hdr, DataPropertyName = prop, Width = w });
            Add("SId", "رقم", "Id", 55);
            Add("SCustomer", "العميل", "CustomerName", 140);
            Add("SVehicle", "السيارة", "VehicleName", 120);
            Add("SRep", "المندوب", "RepName", 110);
            Add("STotal", "الإجمالي", "TotalAmount", 110);
            Add("SPaid", "المدفوع", "PaidAmount", 110);
            Add("SRemaining", "المتبقي", "Remaining", 110);
            Add("SPayType", "نوع الدفع", "PaymentType", 90);
            Add("SStatus", "الحالة", "Status", 90);
