using System;
using System.Collections.Generic;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Globalization;
using System.Linq;
using System.Threading.Tasks;
using System.Windows.Forms;
using Guna.UI2.WinForms;
using DistributionSystem.Business.Services;
using DistributionSystem.Business.Dtos;

namespace DistributionSystem.UI.Forms
{
    public partial class CustomerDetailsForm : Form
    {
        private readonly CustomerService _customerService = new CustomerService();
        private readonly SalesInvoiceService _invoiceService = new SalesInvoiceService();
        private readonly InboundService _inboundService = new InboundService();

        private int _customerId;

        // UI controls
        private Label lblName, lblPhone, lblAddress;
        private Guna2DataGridView dgvInvoices, dgvInbound;
        private Label lblTotalInvoices, lblTotalPurchases, lblBalance;

        public CustomerDetailsForm(int customerId)
        {
            _customerId = customerId;
            InitializeComponent();
            BuildLayout();
            Shown += async (s, e) => await LoadDataAsync();
        }

        private void InitializeComponent()
        {
            this.Text = "تفاصيل العميل";
            this.Size = new Size(900, 700);
            this.StartPosition = FormStartPosition.CenterParent;
            this.Font = new Font("Cairo", 10F);
            this.RightToLeft = RightToLeft.Yes;
            this.RightToLeftLayout = true;
        }

        private void BuildLayout()
        {
            RightToLeft = RightToLeft.Yes;
            RightToLeftLayout = true;
            BackColor = ColorTranslator.FromHtml("#EEF0F5");
            Padding = new Padding(20);

            var root = new TableLayoutPanel { Dock = DockStyle.Fill, ColumnCount = 1, RowCount = 3 };
            root.RowStyles.Add(new RowStyle(SizeType.Absolute, 120F)); // header
            root.RowStyles.Add(new RowStyle(SizeType.Percent, 40F)); // top content
            root.RowStyles.Add(new RowStyle(SizeType.Percent, 60F)); // grids

            root.Controls.Add(BuildHeader(), 0, 0);
            root.Controls.Add(BuildTopMetrics(), 0, 1);
            root.Controls.Add(BuildGrids(), 0, 2);

            Controls.Add(root);
        }

        private Control BuildHeader()
        {
            var pnl = new Panel { Dock = DockStyle.Fill, BackColor = Color.Transparent };
            var banner = new Panel { Dock = DockStyle.Fill, BackColor = Color.Transparent };
            banner.Paint += (s, e) =>
            {
                var g = e.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
                var rc = new Rectangle(0, 0, banner.Width, banner.Height);
                using (var br = new LinearGradientBrush(rc, ColorTranslator.FromHtml("#0d3b2e"), ColorTranslator.FromHtml("#1a7a5e"), LinearGradientMode.Horizontal))
                using (var path = new GraphicsPath()) { path.AddArc(0, 0, 32, 32, 180, 90); path.AddArc(banner.Width - 32, 0, 32, 32, 270, 90); path.AddArc(banner.Width - 32, banner.Height - 32, 32, 32, 0, 90); path.AddArc(0, banner.Height - 32, 32, 32, 90, 90); path.CloseFigure(); g.FillPath(br, path); }
            };

            var inner = new Panel { Dock = DockStyle.Fill, BackColor = Color.Transparent, Padding = new Padding(20) };
            lblName = new Label { Text = "-", Font = new Font("Cairo", 16F, FontStyle.Bold), ForeColor = Color.White, AutoSize = true, BackColor = Color.Transparent };
            lblPhone = new Label { Text = "-", Font = new Font("Cairo", 11F), ForeColor = Color.White, AutoSize = true, BackColor = Color.Transparent };
            lblAddress = new Label { Text = "-", Font = new Font("Cairo", 11F), ForeColor = Color.White, AutoSize = true, BackColor = Color.Transparent };

            inner.Controls.Add(lblAddress); inner.Controls.Add(lblPhone); inner.Controls.Add(lblName);
            inner.Dock = DockStyle.Right;
            banner.Controls.Add(inner);
            pnl.Controls.Add(banner);
            return pnl;
        }

        private Control BuildTopMetrics()
        {
            var pnl = new Panel { Dock = DockStyle.Fill, BackColor = Color.Transparent };
            var card = new Panel { Dock = DockStyle.Fill, BackColor = Color.White, Padding = new Padding(12) };
            card.Paint += (s, e) => { e.Graphics.FillRectangle(Brushes.White, card.ClientRectangle); e.Graphics.DrawRectangle(new Pen(Color.FromArgb(18, 0, 0, 0)), 0, 0, card.Width - 1, card.Height - 1); };

            lblTotalInvoices = new Label { Text = "الإجمالي: 0", Font = new Font("Cairo", 14F, FontStyle.Bold), Location = new Point(20, 20), AutoSize = true };
            lblTotalPurchases = new Label { Text = "المشتريات: 0", Font = new Font("Cairo", 12F), Location = new Point(20, 52), AutoSize = true };
            lblBalance = new Label { Text = "الرصيد: 0", Font = new Font("Cairo", 12F), Location = new Point(20, 78), AutoSize = true };

            card.Controls.Add(lblTotalInvoices); card.Controls.Add(lblTotalPurchases); card.Controls.Add(lblBalance);
            pnl.Controls.Add(card);
            return pnl;
        }

        private Control BuildGrids()
        {
            var pnl = new Panel { Dock = DockStyle.Fill, BackColor = Color.Transparent };
            var split = new SplitContainer { Dock = DockStyle.Fill, Orientation = Orientation.Horizontal, SplitterDistance = (int)(Height * 0.45) };

            dgvInvoices = new Guna2DataGridView { Dock = DockStyle.Fill, ReadOnly = true, AllowUserToAddRows = false, AutoGenerateColumns = false };
            dgvInbound = new Guna2DataGridView { Dock = DockStyle.Fill, ReadOnly = true, AllowUserToAddRows = false, AutoGenerateColumns = false };

            dgvInvoices.Columns.Add(new DataGridViewTextBoxColumn { Name = "I_No", HeaderText = "رقم الفاتورة", DataPropertyName = "Id" });
            dgvInvoices.Columns.Add(new DataGridViewTextBoxColumn { Name = "I_Date", HeaderText = "التاريخ", DataPropertyName = "CreatedAt" });
            dgvInvoices.Columns.Add(new DataGridViewTextBoxColumn { Name = "I_Total", HeaderText = "الإجمالي", DataPropertyName = "TotalAmount" });

            dgvInbound.Columns.Add(new DataGridViewTextBoxColumn { Name = "P_Id", HeaderText = "رقم الأمر", DataPropertyName = "Id" });
            dgvInbound.Columns.Add(new DataGridViewTextBoxColumn { Name = "P_Date", HeaderText = "التاريخ", DataPropertyName = "CreatedAt" });
            dgvInbound.Columns.Add(new DataGridViewTextBoxColumn { Name = "P_Total", HeaderText = "الإجمالي", DataPropertyName = "TotalValue" });

            split.Panel1.Controls.Add(dgvInvoices);
            split.Panel2.Controls.Add(dgvInbound);
            pnl.Controls.Add(split);
            return pnl;
        }

        private async Task LoadDataAsync()
        {
            try
            {
                var data = await Task.Run(() => new CustomerDetailsService().GetCustomerFullDetails(_customerId));
                if (data == null)
                {
                    MessageBox.Show("لا توجد بيانات لهذا العميل.", "تنبيه", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    this.Close();
                    return;
                }

                lblName.Text = data.Customer?.Name ?? "-";
                lblPhone.Text = data.Customer?.Phone ?? "-";
                lblAddress.Text = data.Customer?.Address ?? "-";

                dgvInvoices.DataSource = new BindingSource { DataSource = (object)(data.Invoices ?? new List<SalesInvoiceDto>()) };
                dgvInbound.DataSource = new BindingSource { DataSource = (object)(data.Inbounds ?? new List<InboundOrderDto>()) };

                lblTotalInvoices.Text = $"إجمالي الفواتير: {data.Invoices?.Count ?? 0}";
                lblTotalPurchases.Text = $"إجمالي المشتريات: {data.Inbounds?.Count ?? 0}";
                // balance calculation if available
                decimal totalSales = data.Invoices?.Sum(x => x.TotalAmount) ?? 0m;
                decimal totalPaid = data.Invoices?.Sum(x => x.PaidAmount) ?? 0m;
                decimal balance = totalSales - totalPaid;
                lblBalance.Text = $"المتبقي: {balance:0.00}";
            }
            catch (Exception ex)
            {
                MessageBox.Show("فشل تحميل بيانات العميل: " + ex.Message, "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }
    }

    // DTO for full details returned to UI
    public class CustomerFullDetailsDto
    {
        public CustomerDto Customer { get; set; }
        public List<SalesInvoiceDto> Invoices { get; set; }
        public List<InboundOrderDto> Inbounds { get; set; }
    }
}
