using System;
using System.Collections.Generic;
using System.Linq;
using DistributionSystem.Business.Dtos;
using DistributionSystem.Data.Data;
using DistributionSystem.Data.Entities;
using DistributionSystem.Data.Repositories;

namespace DistributionSystem.Business.Services
{
    public class CustomerService : BaseService
    {
        private readonly CustomerRepository _repository;

        public CustomerService()
        {
            var factory = new SqlConnectionFactory();
            _repository = new CustomerRepository(factory);
        }

        public IEnumerable<CustomerDto> GetAll()
        {
            return Execute(() => _repository.GetAll().Select(MapToDto).ToList());
        }

        public CustomerDto GetById(int id)
        {
            return Execute(() =>
            {
                var c = _repository.GetById(id);
                if (c == null) return null;
                return MapToDto(c);
            });
        }

        public int Insert(CustomerDto dto)
        {
            return Execute(() =>
            {
                Validate(dto);
                var entity = new Customer
                {
                    Name = dto.Name,
                    Phone = dto.Phone,
                    Address = dto.Address
                };
                return _repository.Insert(entity);
            });
        }

        public bool Update(CustomerDto dto)
        {
            return Execute(() =>
            {
                if (dto.Id <= 0) throw new ArgumentException("Invalid customer Id.");
                Validate(dto);
                var entity = new Customer
                {
                    Id = dto.Id,
                    Name = dto.Name,
                    Phone = dto.Phone,
                    Address = dto.Address
                };
                return _repository.Update(entity);
            });
        }

        public bool Delete(int id)
        {
            return Execute(() =>
            {
                if (id <= 0) throw new ArgumentException("Invalid customer Id.");
                return _repository.Delete(id);
            });
        }

        private static void Validate(CustomerDto dto)
        {
            if (dto == null) throw new ArgumentNullException(nameof(dto));
            if (string.IsNullOrWhiteSpace(dto.Name)) throw new ArgumentException("Customer name is required.");
        }

        private static CustomerDto MapToDto(Customer c)
        {
            return new CustomerDto
            {
                Id = c.Id,
                Name = c.Name,
                Phone = c.Phone,
                Address = c.Address,
                CreatedAt = c.CreatedAt
            };
        }
    }

