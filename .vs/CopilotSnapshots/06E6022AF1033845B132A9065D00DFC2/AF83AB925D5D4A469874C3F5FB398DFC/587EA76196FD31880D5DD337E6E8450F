USE DistributionDb;
GO

IF OBJECT_ID('dbo.WarehouseTransactions','U') IS NOT NULL
    DROP TABLE dbo.WarehouseTransactions;
GO

CREATE TABLE dbo.WarehouseTransactions
(
    Id INT IDENTITY(1,1) PRIMARY KEY,
    ProductId INT NOT NULL,
    Quantity INT NOT NULL,
    TransactionType NVARCHAR(50) NOT NULL,
    ReferenceId INT NULL,
    PurchasePrice DECIMAL(18,2) NULL,
    CreatedAt DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT FK_WarehouseTransactions_Products FOREIGN KEY (ProductId) REFERENCES dbo.Products(Id)
);
GO
