using System;
using System.Collections.Generic;
using System.Linq;
using DistributionSystem.Business.Dtos;
using DistributionSystem.Data.Data;
using DistributionSystem.Data.Entities;
using DistributionSystem.Data.Repositories;

namespace DistributionSystem.Business.Services
{
    public class ProductService : BaseService
    {
        private readonly ProductRepository _repository;

        public ProductService()
        {
            var factory = new SqlConnectionFactory();
            _repository = new ProductRepository(factory);
        }

        public IEnumerable<ProductDto> GetAll()
        {
            return Execute(() => _repository.GetAll().Select(MapToDto).ToList());
        }

        public ProductDto GetById(int id)
        {
            return Execute(() =>
            {
                var p = _repository.GetById(id);
                if (p == null) return null;
                return MapToDto(p);
            });
        }

        public int Insert(ProductDto dto)
        {
            return Execute(() =>
            {
                Validate(dto);
                var entity = MapToEntity(dto);
                return _repository.Insert(entity);
            });
        }

        public bool Update(ProductDto dto)
        {
            return Execute(() =>
            {
                if (dto.Id <= 0) throw new ArgumentException("Invalid product Id.");
                Validate(dto);
                var entity = MapToEntity(dto);
                entity.Id = dto.Id;
                return _repository.Update(entity);
            });
        }

        public bool Delete(int id)
        {
            return Execute(() =>
            {
                if (id <= 0) throw new ArgumentException("Invalid product Id.");
                return _repository.Delete(id);
            });
        }

        private static void Validate(ProductDto dto)
        {
            if (string.IsNullOrWhiteSpace(dto.Name))
                throw new ArgumentException("Product name is required.");

            if (dto.PurchasePrice <= 0)
                throw new ArgumentException("Purchase price must be greater than zero.");

            if (dto.SalePrice <= 0)
                throw new ArgumentException("Sale price must be greater than zero.");
        }

        private static ProductDto MapToDto(Product p)
        {
            return new ProductDto
            {
                Id = p.Id,
                Name = p.Name,
                PurchasePrice = p.PurchasePrice,
                SalePrice = p.SalePrice,
                CreatedAt = p.CreatedAt
            };
        }

        private static Product MapToEntity(ProductDto dto)
        {
            return new Product
            {
                Name = dto.Name,
                PurchasePrice = dto.PurchasePrice,
                SalePrice = dto.SalePrice
            };
        }
    }
}
