using System;
using System.Windows.Forms;

namespace DistributionSystem.UI.Forms
{
    public partial class LoginForm : Form
    {
        public LoginForm()
        {
            InitializeComponent();
        }

        private void btnLogin_Click(object sender, EventArgs e)
        {
            try
            {
                var email = txtEmail.Text?.Trim();
                var password = txtPassword.Text;

                // Hardcoded credentials for now
                if (string.Equals(email, "admin@system.com", StringComparison.OrdinalIgnoreCase) && password == "1234")
                {
                    Hide();
                    using (var mainForm = new MainForm())
                    {
                        mainForm.ShowDialog();
                    }
                    Close();
                }
                else
                {
                    MessageBox.Show("Invalid credentials.", "Login Failed", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"An error occurred during login: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }
    }
}
