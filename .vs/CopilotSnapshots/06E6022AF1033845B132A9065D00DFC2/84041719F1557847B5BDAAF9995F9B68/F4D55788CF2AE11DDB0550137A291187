using System;
using System.Windows.Forms;
using Guna.UI2.WinForms;

namespace DistributionSystem.UI.Forms
{
    public partial class MainLayoutForm : Form
    {
        private Timer _clockTimer;

        public string LoggedInUser { get; set; } = "المستخدم";

        public MainLayoutForm()
        {
            InitializeComponent();
            InitializeRuntime();
        }

        private void InitializeRuntime()
        {
            // RTL
            this.RightToLeft = RightToLeft.Yes;
            this.RightToLeftLayout = true;

            lblTitle.Text = "نظام إدارة التوزيع والمخازن";
            lblUser.Text = $"المستخدم: {LoggedInUser}";

            _clockTimer = new Timer { Interval = 1000 };
            _clockTimer.Tick += (s, e) => lblDateTime.Text = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            _clockTimer.Start();

            // Default: load dashboard
            LoadChildForm(new DashboardForm());
        }

        private void LoadChildForm(Form child)
        {
            try
            {
                // Clear existing
                if (panelContent.Controls.Count > 0)
                {
                    var existing = panelContent.Controls[0] as Form;
                    panelContent.Controls.Clear();
                    if (existing != null)
                    {
                        existing.Dispose();
                    }
                }

                child.TopLevel = false;
                child.FormBorderStyle = FormBorderStyle.None;
                child.Dock = DockStyle.Fill;
                panelContent.Controls.Add(child);
                child.Show();

                // Fade in
                AnimationHelper.FadeIn(child, 300);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"حدث خطأ أثناء تحميل الشاشة: {ex.Message}", "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnDashboard_Click(object sender, EventArgs e)
        {
            LoadChildForm(new DashboardForm());
        }

        private void btnProducts_Click(object sender, EventArgs e)
        {
            LoadChildForm(new ProductForm());
        }

        private void btnCustomers_Click(object sender, EventArgs e)
        {
            LoadChildForm(new CustomerForm());
        }

        private void btnInbound_Click(object sender, EventArgs e)
        {
            LoadChildForm(new InboundForm());
        }

        private void btnWarehouse_Click(object sender, EventArgs e)
        {
            LoadChildForm(new WarehouseReportForm());
        }

        private void btnCars_Click(object sender, EventArgs e)
        {
            // placeholder form
            LoadChildForm(new DashboardForm("السيارات"));
        }

        private void btnEmployees_Click(object sender, EventArgs e)
        {
            LoadChildForm(new DashboardForm("الموظفين"));
        }

        private void btnLogout_Click(object sender, EventArgs e)
        {
            var confirm = MessageBox.Show("هل تريد تسجيل الخروج؟", "تأكيد", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (confirm == DialogResult.Yes)
            {
                this.Close();
            }
        }
    }
}
