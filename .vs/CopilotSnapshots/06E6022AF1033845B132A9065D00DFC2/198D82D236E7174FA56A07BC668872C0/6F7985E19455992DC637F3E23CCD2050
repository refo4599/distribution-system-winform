using System;
using System.Drawing;
using System.Threading.Tasks;
using System.Windows.Forms;
using DistributionSystem.Business.Services;

namespace DistributionSystem.UI.Forms
{
    public partial class DashboardForm : Form
    {
        private readonly DashboardService _service;

        public DashboardForm()
        {
            InitializeComponent();
            _service = new DashboardService();
        }

        private async void DashboardForm_Load(object sender, EventArgs e)
        {
            await LoadStatsAsync();
            AnimationHelper.FadeIn(this, 300);
        }

        private System.Windows.Forms.Label lblTotalProducts => this.cardProducts.Controls[0] is System.Windows.Forms.Panel p0 ? (System.Windows.Forms.Label)p0.Controls[0] : new System.Windows.Forms.Label();

        private System.Windows.Forms.Label lblTotalCustomers => this.cardCustomers.Controls[0] is System.Windows.Forms.Panel p1 ? (System.Windows.Forms.Label)p1.Controls[0] : new System.Windows.Forms.Label();

        private System.Windows.Forms.Label lblTotalSuppliers => this.cardSuppliers.Controls[0] is System.Windows.Forms.Panel p2 ? (System.Windows.Forms.Label)p2.Controls[0] : new System.Windows.Forms.Label();

        private System.Windows.Forms.Label lblTotalSales => this.cardSales.Controls[0] is System.Windows.Forms.Panel p3 ? (System.Windows.Forms.Label)p3.Controls[0] : new System.Windows.Forms.Label();

        private System.Windows.Forms.Label lblTotalPurchases => this.cardPurchases.Controls[0] is System.Windows.Forms.Panel p4 ? (System.Windows.Forms.Label)p4.Controls[0] : new System.Windows.Forms.Label();

        private System.Windows.Forms.Label lblLowStock => this.cardLowStock.Controls[0] is System.Windows.Forms.Panel p5 ? (System.Windows.Forms.Label)p5.Controls[0] : new System.Windows.Forms.Label();

        private async Task LoadStatsAsync()
        {
            await Task.Run(() =>
            {
                try
                {
                    var stats = _service.GetStats();
                    this.Invoke(new Action(() =>
                    {
                        cardProducts.CardValue = stats.TotalProducts.ToString();
                        cardCustomers.CardValue = stats.TotalCustomers.ToString();
                        cardSuppliers.CardValue = stats.TotalSuppliers.ToString();
                        cardSales.CardValue = stats.TotalSales.ToString();
                        cardPurchases.CardValue = stats.TotalPurchases.ToString();
                        cardLowStock.CardValue = stats.LowStockAlerts.ToString();
                    }));
                }
                catch (Exception ex)
                {
                    this.Invoke(new Action(() => MessageBox.Show($"فشل تحميل إحصائيات اللوحة: {ex.Message}", "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error)));
                }
            });
        }

        private void Card_Click(object sender, EventArgs e)
        {
            var card = sender as Controls.DashboardCard;
            if (card == null) return;

            var tag = card.Tag as string;
            var parent = this.ParentForm as MainLayoutForm;
            if (parent == null) return;

            switch (tag)
            {
                case "Products": parent.LoadChildForm(new ProductForm()); break;
                case "Customers": parent.LoadChildForm(new CustomerForm()); break;
                case "Suppliers": parent.LoadChildForm(new ProductForm()); break;
                case "Sales": parent.LoadChildForm(new ProductForm()); break;
                case "Purchases": parent.LoadChildForm(new ProductForm()); break;
                case "Warehouse": parent.LoadChildForm(new WarehouseReportForm()); break;
            }
        }
    }
}
