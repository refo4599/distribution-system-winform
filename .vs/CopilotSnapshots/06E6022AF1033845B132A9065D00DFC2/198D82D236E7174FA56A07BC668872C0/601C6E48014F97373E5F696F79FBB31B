using System;
using System.ComponentModel;
using System.Drawing;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace DistributionSystem.UI.Controls
{
    public class DashboardCard : Panel
    {
        private Label lblIcon;
        private Label lblTitle;
        private Label lblValue;
        private Label lblSubtitle;

        private Color baseColor = ColorTranslator.FromHtml("#3B82F6");
        private Color hoverColor;
        private bool isAnimating;

        [Category("Appearance")]
        public string CardTitle
        {
            get => lblTitle.Text;
            set => lblTitle.Text = value;
        }

        [Category("Appearance")]
        public string CardValue
        {
            get => lblValue.Text;
            set => lblValue.Text = value;
        }

        [Category("Appearance")]
        public string CardSubtitle
        {
            get => lblSubtitle.Text;
            set => lblSubtitle.Text = value;
        }

        [Category("Appearance")]
        public Color CardColor
        {
            get => baseColor;
            set
            {
                baseColor = value;
                BackColor = baseColor;
                hoverColor = ControlPaint.Light(baseColor);
                lblIcon.BackColor = Color.Transparent;
            }
        }

        [Category("Appearance")]
        public string IconText
        {
            get => lblIcon.Text;
            set => lblIcon.Text = value;
        }

        public DashboardCard()
        {
            InitializeComponents();
            // defaults
            CardColor = baseColor;
            this.Cursor = Cursors.Hand;
        }

        private void InitializeComponents()
        {
            this.Padding = new Padding(12);
            this.BorderStyle = BorderStyle.None;
            this.Margin = new Padding(10);
            this.BackColor = baseColor;
            this.DoubleBuffered = true;

            lblIcon = new Label
            {
                AutoSize = false,
                Size = new Size(48, 48),
                Font = new Font("Segoe UI", 24F, FontStyle.Bold),
                ForeColor = Color.White,
                TextAlign = ContentAlignment.MiddleCenter,
                Dock = DockStyle.Left
            };

            var rightPanel = new Panel { Dock = DockStyle.Fill, BackColor = Color.Transparent };

            lblTitle = new Label
            {
                AutoSize = false,
                Height = 22,
                Dock = DockStyle.Top,
                Font = new Font("Segoe UI", 10F, FontStyle.Bold),
                ForeColor = Color.White,
                TextAlign = ContentAlignment.MiddleRight
            };

            lblValue = new Label
            {
                AutoSize = false,
                Dock = DockStyle.Fill,
                Font = new Font("Segoe UI", 28F, FontStyle.Bold),
                ForeColor = Color.White,
                TextAlign = ContentAlignment.MiddleRight
            };

            lblSubtitle = new Label
            {
                AutoSize = false,
                Height = 18,
                Dock = DockStyle.Bottom,
                Font = new Font("Segoe UI", 9F, FontStyle.Regular),
                ForeColor = Color.WhiteSmoke,
                TextAlign = ContentAlignment.MiddleRight
            };

            rightPanel.Controls.Add(lblValue);
            rightPanel.Controls.Add(lblTitle);
            rightPanel.Controls.Add(lblSubtitle);

            this.Controls.Add(rightPanel);
            this.Controls.Add(lblIcon);

            // rounded corners via Region
            this.Paint += (s, e) =>
            {
                var rect = this.ClientRectangle;
                using (var gp = RoundedRect(rect, 12))
                {
                    this.Region = new System.Drawing.Region(gp);
                }
            };

            this.MouseEnter += DashboardCard_MouseEnter;
            this.MouseLeave += DashboardCard_MouseLeave;
            this.Click += DashboardCard_Click;
            foreach (Control c in this.Controls)
            {
                c.Click += (s, e) => this.OnClick(e);
            }
        }

        private void DashboardCard_Click(object sender, EventArgs e)
        {
            // bubble click
        }

        private void DashboardCard_MouseEnter(object sender, EventArgs e)
        {
            this.Cursor = Cursors.Hand;
            StartHoverAnimation(true);
        }

        private void DashboardCard_MouseLeave(object sender, EventArgs e)
        {
            StartHoverAnimation(false);
        }

        private async void StartHoverAnimation(bool hover)
        {
            if (isAnimating) return;
            isAnimating = true;
            try
            {
                var steps = 6;
                for (int i = 0; i < steps; i++)
                {
                    await Task.Delay(12);
                    if (hover)
                    {
                        this.BackColor = Blend(this.BackColor, hoverColor, 0.15f);
                        this.Padding = new Padding( (int)(this.Padding.Left * 0.98), (int)(this.Padding.Top * 0.98), (int)(this.Padding.Right * 0.98), (int)(this.Padding.Bottom * 0.98));
                    }
                    else
                    {
                        this.BackColor = Blend(this.BackColor, baseColor, 0.15f);
                        // reset padding gradually
                        this.Padding = new Padding(Math.Max(8, this.Padding.Left + 1), Math.Max(8, this.Padding.Top + 1), Math.Max(8, this.Padding.Right + 1), Math.Max(8, this.Padding.Bottom + 1));
                    }
                }
                this.BackColor = hover ? hoverColor : baseColor;
            }
            catch { }
            finally { isAnimating = false; }
        }

        private Color Blend(Color a, Color b, float amount)
        {
            float r = a.R + (b.R - a.R) * amount;
            float g = a.G + (b.G - a.G) * amount;
            float bl = a.B + (b.B - a.B) * amount;
            return Color.FromArgb((int)r, (int)g, (int)bl);
        }

        private System.Drawing.Drawing2D.GraphicsPath RoundedRect(Rectangle baseRect, int radius)
        {
            var path = new System.Drawing.Drawing2D.GraphicsPath();
            int diameter = radius * 2;
            var arc = new Rectangle(baseRect.Location, new Size(diameter, diameter));
            // top left
            path.AddArc(arc, 180, 90);
            // top right
            arc.X = baseRect.Right - diameter;
            path.AddArc(arc, 270, 90);
            // bottom right
            arc.Y = baseRect.Bottom - diameter;
            path.AddArc(arc, 0, 90);
            // bottom left
            arc.X = baseRect.Left;
            path.AddArc(arc, 90, 90);
            path.CloseFigure();
            return path;
        }
    }
}
