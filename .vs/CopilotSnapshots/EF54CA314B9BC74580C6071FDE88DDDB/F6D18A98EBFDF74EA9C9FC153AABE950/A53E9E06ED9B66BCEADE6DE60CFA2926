                        MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
            };

            footer.Controls.Add(btnSave);

            // ── Assemble popup ───────────────────────────────
            popup.Controls.Add(body);
            popup.Controls.Add(footer);
            popup.Controls.Add(headSep);
            popup.Controls.Add(pnlHead);

            popTxtName.Focus();
        }

        // ══════════════════════════════════════════════════════
        //  GRAPHICS HELPERS
        // ══════════════════════════════════════════════════════
        private GraphicsPath RoundPath(Rectangle r, int radius)
        {
            int d = radius * 2;
            var path = new GraphicsPath();
            path.AddArc(r.Left, r.Top, d, d, 180, 90);
            path.AddArc(r.Right - d, r.Top, d, d, 270, 90);
            path.AddArc(r.Right - d, r.Bottom - d, d, d, 0, 90);
            path.AddArc(r.Left, r.Bottom - d, d, d, 90, 90);
            path.CloseFigure();
            return path;
        }

        // Keep old name so nothing breaks
        private GraphicsPath RoundRect(Rectangle r, int radius) => RoundPath(r, radius);
    }

    // ── Graphics extension (used in header banner) ────────────
    public static class GraphicsExtensions
    {
        public static void FillRoundedRectangle(this Graphics g, Brush brush,
            int x, int y, int width, int height, int radius)
        {
            try
            {
                int d = radius * 2;
                using (var path = new GraphicsPath())
                {
                    path.AddArc(x, y, d, d, 180, 90);
                    path.AddArc(x + width - d, y, d, d, 270, 90);
                    path.AddArc(x + width - d, y + height - d, d, d, 0, 90);
                    path.AddArc(x, y + height - d, d, d, 90, 90);
                    path.CloseFigure();
                    g.FillPath(brush, path);
                }
            }
            catch { g.FillRectangle(brush, x, y, width, height); }
        }
    }
