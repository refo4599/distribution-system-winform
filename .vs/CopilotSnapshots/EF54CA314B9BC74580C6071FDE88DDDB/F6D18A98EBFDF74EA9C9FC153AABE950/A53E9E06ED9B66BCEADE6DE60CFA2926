            for (int i = 0; i <= 90; i += 9)
            {
                overlay.BackColor = Color.FromArgb(i, 0, 0, 0);
                await Task.Delay(8);
            }

            // ── Popup card ───────────────────────────────────
            var popup = new Guna2Panel
            {
                Size = new Size(500, 420),
                BorderRadius = 20,
                FillColor = Color.White,
                Location = new Point(
                    (overlay.Width - 500) / 2,
                    (overlay.Height - 420) / 2)
            };
