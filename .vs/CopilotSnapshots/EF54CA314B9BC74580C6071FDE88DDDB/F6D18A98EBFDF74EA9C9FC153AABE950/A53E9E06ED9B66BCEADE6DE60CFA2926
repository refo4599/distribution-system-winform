            {
                Dock = DockStyle.Left,
                FillColor = Color.Transparent,
                IconColor = ColorTranslator.FromHtml("#9CA3AF")
            };
            btnClose.MouseEnter += (s, e) => ((Guna2ControlBox)s).IconColor = ColorTranslator.FromHtml("#374151");
            btnClose.MouseLeave += (s, e) => ((Guna2ControlBox)s).IconColor = ColorTranslator.FromHtml("#9CA3AF");

            btnClose.Click += async (s, e) =>
            {
                for (int i = 90; i >= 0; i -= 9)
