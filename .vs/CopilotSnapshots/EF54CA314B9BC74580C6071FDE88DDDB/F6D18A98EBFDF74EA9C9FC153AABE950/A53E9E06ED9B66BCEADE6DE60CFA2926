                Font = new Font("Cairo", 10F, FontStyle.Bold),
                ForeColor = ColorTranslator.FromHtml("#374151"),
                TextAlign = ContentAlignment.MiddleRight,
                BackColor = Color.Transparent
            };
            var popTxtPurch = new Guna2TextBox
            {
                Height = 44,
                Dock = DockStyle.Top,
                BorderRadius = 12,
                FillColor = ColorTranslator.FromHtml("#F9FAFB"),
                BorderColor = ColorTranslator.FromHtml("#E5E7EB"),
                Font = new Font("Cairo", 11F),
                PlaceholderText = "0.00",
                PlaceholderForeColor = ColorTranslator.FromHtml("#9CA3AF"),
                ForeColor = ColorTranslator.FromHtml("#111827"),
                TextAlign = HorizontalAlignment.Right
            };
            popTxtPurch.FocusedState.BorderColor = ColorTranslator.FromHtml("#4E73DF");
            popTxtPurch.FocusedState.FillColor = Color.White;
            var errPurch = new Label
            {
                Dock = DockStyle.Top,
                Height = 0,
                Font = new Font("Cairo", 9F),
                ForeColor = ColorTranslator.FromHtml("#EF4444"),
                TextAlign = ContentAlignment.MiddleRight,
                BackColor = Color.Transparent,
