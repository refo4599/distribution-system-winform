                Dock = DockStyle.Fill,
                Font = new Font("Cairo", 15F, FontStyle.Bold),
                ForeColor = ColorTranslator.FromHtml("#111827"),
                TextAlign = ContentAlignment.MiddleRight,
                Padding = new Padding(0, 0, 6, 0)
