                    errSale.Text = "• يجب أن يكون أكبر من صفر";
                    errSale.Visible = true;
                    errSale.Height = 18;
                    valid = false;
                }

                if (!valid) return;

                btnSave.Enabled = false;
                btnSave.Text = "جارٍ الحفظ...";

                await Task.Delay(600); // simulate async save

                try
                {
                    var dto = new ProductDto
                    {
                        Name = popTxtName.Text.Trim(),
                        PurchasePrice = pp,
                        SalePrice = sp
                    };

                    if (!isEdit) _service.AddProduct(dto);
                    else { dto.Id = editDto.Id; _service.Update(dto); }

                    LoadProducts();

                    for (int i = 90; i >= 0; i -= 9)
                    {
