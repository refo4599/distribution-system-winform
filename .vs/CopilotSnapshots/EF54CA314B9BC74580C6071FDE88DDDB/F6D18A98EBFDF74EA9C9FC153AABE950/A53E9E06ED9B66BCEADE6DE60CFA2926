            popup.ShadowDecoration.Depth = 50;
            popup.ShadowDecoration.Color = Color.FromArgb(60, 0, 0, 0);

            overlay.Controls.Add(popup);
            overlay.Resize += (s, e) =>
                popup.Location = new Point((overlay.Width - popup.Width) / 2,
                                           (overlay.Height - popup.Height) / 2);

            // ── Popup header ─────────────────────────────────
