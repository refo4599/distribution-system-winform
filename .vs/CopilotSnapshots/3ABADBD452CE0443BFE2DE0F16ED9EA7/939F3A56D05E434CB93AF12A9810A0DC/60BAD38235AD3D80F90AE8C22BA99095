                try
                {
                    var dto = new VehicleDto { Id = edit?.Id ?? 0, Name = fName.Text.Trim(), RepName = fRep.Text.Trim() };
                    await Task.Run(() => _vehicleService.SaveVehicle(dto));
                    LoadVehicles(); onSaved?.Invoke(); popup.Close();
