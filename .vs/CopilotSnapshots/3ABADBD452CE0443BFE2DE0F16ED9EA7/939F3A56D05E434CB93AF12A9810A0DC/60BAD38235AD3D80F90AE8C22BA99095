            var footer = popup.Controls.Find("footer", true).FirstOrDefault() as Panel;
            var btnSave = MakeSaveBtn("حفظ أمر الصرف");
            btnSave.Click += async (s, e) =>
            {
                errV.Visible = false; errV.Height = 0;
                int vId = 0; try { vId = Convert.ToInt32(cboVeh.SelectedValue); } catch { }
                if (vId == 0) { errV.Text = "• اختر سيارة"; errV.Visible = true; errV.Height = 18; return; }
                if (itemRows.Count == 0) { ShowErrorToast("أضف منتجاً على الأقل"); return; }

                var items2 = new List<DispatchOrderItemDto>(); bool valid2 = true;
                foreach (var r in itemRows)
                {
                    int pid2 = 0; try { pid2 = Convert.ToInt32(r.cbo.SelectedValue); } catch { }
                    if (pid2 == 0) { valid2 = false; continue; }
                    int b2 = 24; var sp2 = products.FirstOrDefault(p => p.Id == pid2);
                    if (sp2 != null && sp2.BoxesPerCarton > 0) b2 = sp2.BoxesPerCarton;
                    int.TryParse(r.cartons.Text, out int c2); int.TryParse(r.extra.Text, out int x2);
                    int tot2 = Math.Max(0, c2) * b2 + Math.Max(0, x2);
                    if (tot2 <= 0) { valid2 = false; r.cartons.BorderColor = ColorTranslator.FromHtml("#EF4444"); continue; }

                    // FIX 2: parsing قوي للسعر
                    decimal pr2 = 0;
                    string priceText = (r.price.Text ?? "").Trim().Replace(",", ".");
                    if (!decimal.TryParse(priceText, NumberStyles.Any, Inv, out pr2))
                        if (!decimal.TryParse(priceText, NumberStyles.Any, CultureInfo.GetCultureInfo("ar-EG"), out pr2))
                            decimal.TryParse(r.price.Text.Trim(), out pr2);

                    items2.Add(new DispatchOrderItemDto { ProductId = pid2, Quantity = tot2, SalePrice = pr2 });
                }
                if (!valid2) { ShowErrorToast("تحقق من بيانات المنتجات"); return; }
                btnSave.Enabled = false; btnSave.Text = "جارٍ الحفظ...";
                try
                {
                    var dto2 = new DispatchOrderDto { VehicleId = vId, Notes = fNotes.Text.Trim(), Items = items2 };
                    await Task.Run(() => _vehicleService.SaveDispatchOrder(dto2));
                    LoadDispatches(); popup.Close(); ShowSuccessToast("تم حفظ أمر الصرف وخصم المخزن");
                }
                catch (Exception ex) { ShowErrorToast("فشل: " + GetInner(ex)); }
                finally { btnSave.Enabled = true; btnSave.Text = "حفظ أمر الصرف"; }
            };
            footer?.Controls.Add(btnSave);
            popup.ShowDialog(this);
        }

        private void RenderPagination()
        {
            if (_paginationBar == null) return;
            _paginationBar.Controls.Clear();

            var lblInfo = new Label
            {
                Text = $"عرض {Math.Min(_dispatches.Count, (_dispatchPage - 1) * PageSize + 1)}-{Math.Min(_dispatches.Count, _dispatchPage * PageSize)} من {_dispatches.Count}",
                Font = new Font("Cairo", 9.5F),
                ForeColor = ColorTranslator.FromHtml("#64748B"),
                AutoSize = false,
                Width = 180,
                Height = 52,
                TextAlign = ContentAlignment.MiddleRight,
                Dock = DockStyle.Right,
                BackColor = Color.Transparent
            };
            _paginationBar.Controls.Add(lblInfo);

            var flow = new FlowLayoutPanel { Dock = DockStyle.Fill, FlowDirection = FlowDirection.RightToLeft, BackColor = Color.Transparent, WrapContents = false };
            flow.Controls.Add(NavBtn("", _dispatchPage < TotalPages, () => { _dispatchPage++; RebindGrid(); }));
            for (int i = TotalPages; i >= 1; i--)
            {
                int pg = i; bool cur = pg == _dispatchPage;
                var btn = new Panel { Size = new Size(34, 34), BackColor = Color.Transparent, Cursor = cur ? Cursors.Default : Cursors.Hand, Margin = new Padding(3, 9, 3, 9) };
                btn.Paint += (s, pe) =>
                {
                    var g = pe.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
                    var rc = new Rectangle(0, 0, btn.Width - 1, btn.Height - 1);
                    if (cur)
                    { using (var br = new LinearGradientBrush(rc, ColorTranslator.FromHtml("#4E73DF"), ColorTranslator.FromHtml("#3B5DC9"), LinearGradientMode.Vertical)) using (var ph = RoundPath(rc, 7)) g.FillPath(br, ph); using (var f = new Font("Cairo", 10F, FontStyle.Bold)) g.DrawString(pg.ToString(), f, Brushes.White, rc, SF(StringAlignment.Center, StringAlignment.Center)); }
                    else
                    { using (var ph = RoundPath(rc, 7)) { g.FillPath(new SolidBrush(ColorTranslator.FromHtml("#F8FAFC")), ph); g.DrawPath(new Pen(ColorTranslator.FromHtml("#E2E8F0"), 1f), ph); } using (var f = new Font("Cairo", 10F)) using (var tb = new SolidBrush(ColorTranslator.FromHtml("#374151"))) g.DrawString(pg.ToString(), f, tb, rc, SF(StringAlignment.Center, StringAlignment.Center)); }
                };
                if (!cur) btn.Click += (s, e) => { _dispatchPage = pg; RebindGrid(); };
                flow.Controls.Add(btn);
            }
            flow.Controls.Add(NavBtn("", _dispatchPage > 1, () => { _dispatchPage--; RebindGrid(); }));
            _paginationBar.Controls.Add(flow);
        }

        private Panel NavBtn(string text, bool enabled, Action onClick)
        {
            var btn = new Panel { Size = new Size(34, 34), BackColor = Color.Transparent, Cursor = enabled ? Cursors.Hand : Cursors.Default, Margin = new Padding(3, 9, 3, 9) };
            btn.Paint += (s, pe) =>
            {
                var g = pe.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
                var rc = new Rectangle(0, 0, btn.Width - 1, btn.Height - 1);
                using (var ph = RoundPath(rc, 7)) { g.FillPath(new SolidBrush(enabled ? ColorTranslator.FromHtml("#F8FAFC") : ColorTranslator.FromHtml("#F1F5F9")), ph); g.DrawPath(new Pen(ColorTranslator.FromHtml("#E2E8F0"), 1f), ph); }
                using (var f = new Font("Segoe UI", 13F)) using (var tb = new SolidBrush(enabled ? ColorTranslator.FromHtml("#374151") : ColorTranslator.FromHtml("#CBD5E1")))
                    g.DrawString(text, f, tb, rc, SF(StringAlignment.Center, StringAlignment.Center));
            };
            if (enabled) btn.Click += (s, e) => onClick();
            return btn;
        }

        private Form CreateBlankPopup(int w, int h, string title, string sub)
        {
            var pf = new Form { FormBorderStyle = FormBorderStyle.None, StartPosition = FormStartPosition.Manual, Size = new Size(w, h), BackColor = Color.White, ShowInTaskbar = false, TopMost = true, RightToLeft = RightToLeft.Yes, RightToLeftLayout = true };
            var sc = Screen.FromControl(this).WorkingArea;
            pf.Location = new Point(sc.Left + (sc.Width - w) / 2, sc.Top + (sc.Height - h) / 2);
            using (var rgn = new GraphicsPath()) { rgn.AddArc(0, 0, 36, 36, 180, 90); rgn.AddArc(w - 36, 0, 36, 36, 270, 90); rgn.AddArc(w - 36, h - 36, 36, 36, 0, 90); rgn.AddArc(0, h - 36, 36, 36, 90, 90); rgn.CloseFigure(); pf.Region = new Region(rgn); }

            var popup = new Guna2Panel { Dock = DockStyle.Fill, BorderRadius = 0, FillColor = Color.White };
            popup.ShadowDecoration.Enabled = true; popup.ShadowDecoration.Depth = 30; popup.ShadowDecoration.Color = Color.FromArgb(60, 0, 0, 0);
            pf.Controls.Add(popup);

            var head = new Panel { Dock = DockStyle.Top, Height = 80, BackColor = Color.Transparent };
            head.Paint += (s, pe) =>
            {
                var g = pe.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
                var rc = new Rectangle(0, 0, head.Width, head.Height);
                using (var br = new LinearGradientBrush(rc, ColorTranslator.FromHtml("#1a2f5e"), ColorTranslator.FromHtml("#1565c0"), LinearGradientMode.Horizontal))
                    g.FillRectangle(br, rc);
                using (var db = new SolidBrush(Color.FromArgb(18, 255, 255, 255)))
                    for (int x = 8; x < head.Width; x += 20) for (int y = 6; y < head.Height; y += 20) g.FillEllipse(db, x, y, 2, 2);
                using (var cb = new SolidBrush(Color.FromArgb(10, 255, 255, 255))) g.FillEllipse(cb, head.Width - 90, -40, 170, 170);
                using (var tf = new Font("Cairo", 16F, FontStyle.Bold)) using (var tb = new SolidBrush(Color.White))
                { var tsz = g.MeasureString(title, tf); g.DrawString(title, tf, tb, head.Width - tsz.Width - 44, 12); }
                using (var sf2 = new Font("Cairo", 9.5F)) using (var sb2 = new SolidBrush(Color.FromArgb(200, 255, 255, 255)))
                { var ssz = g.MeasureString(sub, sf2); g.DrawString(sub, sf2, sb2, head.Width - ssz.Width - 44, 46); }
            };
            var btnX = new Guna2Button { Size = new Size(28, 28), Text = "X", FillColor = Color.FromArgb(45, 255, 255, 255), ForeColor = Color.White, BorderRadius = 7, Font = new Font("Segoe UI", 10F, FontStyle.Bold), Anchor = AnchorStyles.Top | AnchorStyles.Left };
            btnX.HoverState.FillColor = Color.FromArgb(80, 255, 255, 255);
            btnX.Click += (s, e) => pf.Close();
            head.Controls.Add(btnX); head.Layout += (s, e) => btnX.Location = new Point(8, 8);

            var body = new Panel { Dock = DockStyle.Fill, BackColor = Color.White, Padding = new Padding(22, 12, 22, 4), Name = "body" };
            var footer = new Panel { Dock = DockStyle.Bottom, BackColor = Color.White, Height = 64, Padding = new Padding(22, 10, 22, 14), Name = "footer" };

            popup.Controls.Add(body); popup.Controls.Add(footer); popup.Controls.Add(head);
            pf.Tag = body;
            return pf;
        }

