        private void ShowVehiclePopup(VehicleDto edit = null, Action onSaved = null)
        {
            bool isEdit = edit != null;
            var popup = CreateBlankPopup(420, 300, isEdit ? "تعديل سيارة" : "إضافة سيارة جديدة", isEdit ? "عدّل البيانات ثم اضغط تحديث" : "أدخل بيانات السيارة والمندوب");
            var body = popup.Tag as Panel; if (body == null) return;

            var errName = MakeErrLbl(); var fName = MakeTxt("اسم السيارة"); var lblN = MakeLbl("اسم السيارة *");
            var errRep = MakeErrLbl(); var fRep = MakeTxt("اسم المندوب"); var lblR = MakeLbl("اسم المندوب *");
            if (isEdit) { fName.Text = edit.Name; fRep.Text = edit.RepName; }

            body.Controls.Add(MakeSp()); body.Controls.Add(errRep); body.Controls.Add(fRep); body.Controls.Add(lblR);
            body.Controls.Add(MakeSp()); body.Controls.Add(errName); body.Controls.Add(fName); body.Controls.Add(lblN);

            var footer = popup.Controls.Find("footer", true).FirstOrDefault() as Panel;
            var btnSave = MakeSaveBtn(isEdit ? "تحديث" : "حفظ");
            btnSave.Click += async (s, e) =>
            {
                errName.Visible = errRep.Visible = false; errName.Height = errRep.Height = 0;
                bool ok = true;
                if (string.IsNullOrWhiteSpace(fName.Text)) { errName.Text = "• اسم السيارة مطلوب"; errName.Visible = true; errName.Height = 18; ok = false; }
                if (string.IsNullOrWhiteSpace(fRep.Text)) { errRep.Text = "• اسم المندوب مطلوب"; errRep.Visible = true; errRep.Height = 18; ok = false; }
