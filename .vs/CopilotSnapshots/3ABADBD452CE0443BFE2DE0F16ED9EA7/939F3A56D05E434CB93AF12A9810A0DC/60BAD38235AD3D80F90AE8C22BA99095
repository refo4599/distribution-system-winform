        private void LoadDispatches()
        {
            try
            {
                _dispatches = _vehicleService.GetAllDispatchOrders()?.ToList() ?? new List<DispatchOrderDto>();
                _dispatchPage = Math.Min(_dispatchPage, TotalPages);
                RebindGrid();
            }
            catch (Exception ex) { ShowErrorToast("فشل تحميل الأوامر: " + GetInner(ex)); }
        }

        private void RebindGrid()
        {
            var page = _dispatches.Skip((_dispatchPage - 1) * PageSize).Take(PageSize).ToList();
            dgvDispatch.DataSource = new BindingSource { DataSource = page };
            FitColumns();
            if (lblDispatchCount != null) lblDispatchCount.Text = $"{_dispatches.Count} أمر";
            RenderPagination();
        }

        private void FitColumns()
        {
            if (dgvDispatch == null || dgvDispatch.Columns.Count == 0) return;
            int w = dgvDispatch.ClientSize.Width; if (w <= 0) return;
            int wId = 55, wDet = 70, wDel = 62, wSt = 85, wDt = 160;
            int rest = w - wId - wDet - wDel - wSt - wDt;
            int wV = Math.Max(80, (int)(rest * 0.48));
            int wR = Math.Max(80, rest - wV);
            dgvDispatch.Columns["DId"].Width = wId;
            dgvDispatch.Columns["DVehicle"].Width = wV;
            dgvDispatch.Columns["DRep"].Width = wR;
            dgvDispatch.Columns["DDate"].Width = wDt;
            dgvDispatch.Columns["DStatus"].Width = wSt;
            dgvDispatch.Columns["DDetails"].Width = wDet;
            dgvDispatch.Columns["DActions"].Width = wDel;
        }

        private void Dgv_CellPainting(object sender, DataGridViewCellPaintingEventArgs e)
        {
            try
            {
                if (e.RowIndex == -1)
                {
                    e.Handled = true;
                    var g = e.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
                    using (var br = new LinearGradientBrush(e.CellBounds, ColorTranslator.FromHtml("#1e3a6e"), ColorTranslator.FromHtml("#243f7a"), LinearGradientMode.Vertical))
                        g.FillRectangle(br, e.CellBounds);
                    using (var f = new Font("Cairo", 10.5F, FontStyle.Bold))
                        g.DrawString(e.Value?.ToString() ?? "", f, Brushes.White, e.CellBounds, SF(StringAlignment.Center, StringAlignment.Center));
                    using (var sp = new Pen(Color.FromArgb(35, 255, 255, 255), 1f))
                        g.DrawLine(sp, e.CellBounds.Right - 1, e.CellBounds.Top + 8, e.CellBounds.Right - 1, e.CellBounds.Bottom - 8);
                    return;
                }
                if (e.RowIndex < 0) return;

                bool sel = dgvDispatch.Rows[e.RowIndex].Selected;
                Color bg = sel ? ColorTranslator.FromHtml("#EEF2FF")
                               : (e.RowIndex % 2 == 0 ? Color.White : ColorTranslator.FromHtml("#FAFBFF"));
                string col = dgvDispatch.Columns[e.ColumnIndex].Name;

                switch (col)
                {
                    case "DStatus": PaintStatus(e, bg); break;
                    case "DDate": PaintDate(e, bg); break;
                    case "DDetails": PaintEye(e, bg); break;
                    case "DActions": PaintDelete(e, bg); break;
                    default:
                        e.Handled = true;
                        e.Graphics.FillRectangle(new SolidBrush(bg), e.CellBounds);
                        using (var f = new Font("Cairo", 11F))
                        using (var tb = new SolidBrush(ColorTranslator.FromHtml("#0F172A")))
                            e.Graphics.DrawString(e.Value?.ToString() ?? "", f, tb, e.CellBounds, SF(StringAlignment.Center, StringAlignment.Center));
                        break;
                }

                using (var lp = new Pen(ColorTranslator.FromHtml("#F1F5F9"), 1f))
                    e.Graphics.DrawLine(lp, e.CellBounds.Left, e.CellBounds.Bottom - 1, e.CellBounds.Right, e.CellBounds.Bottom - 1);
            }
            catch { }
        }

        private void PaintStatus(DataGridViewCellPaintingEventArgs e, Color bg)
        {
            e.Handled = true;
            var g = e.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
            g.FillRectangle(new SolidBrush(bg), e.CellBounds);
            int pw = 64, ph = 26, px = e.CellBounds.Left + (e.CellBounds.Width - pw) / 2, py = e.CellBounds.Top + (e.CellBounds.Height - ph) / 2;
            using (var path = RoundPath(new Rectangle(px, py, pw, ph), ph / 2))
            { g.FillPath(new SolidBrush(ColorTranslator.FromHtml("#ECFDF5")), path); g.DrawPath(new Pen(ColorTranslator.FromHtml("#A7F3D0"), 1f), path); }
            using (var f = new Font("Cairo", 9.5F, FontStyle.Bold))
                g.DrawString("نشط", f, new SolidBrush(ColorTranslator.FromHtml("#065F46")), new RectangleF(px, py, pw, ph), SF(StringAlignment.Center, StringAlignment.Center));
        }

        private void PaintDate(DataGridViewCellPaintingEventArgs e, Color bg)
        {
            e.Handled = true;
            e.Graphics.FillRectangle(new SolidBrush(bg), e.CellBounds);
            string dt = "";
            if (DateTime.TryParse(e.Value?.ToString() ?? "", out DateTime d))
            {
                var utc = d.Kind == DateTimeKind.Local ? d.ToUniversalTime() : DateTime.SpecifyKind(d, DateTimeKind.Utc);
                dt = utc.ToLocalTime().ToString("yyyy/MM/dd  HH:mm");
            }
            using (var f = new Font("Cairo", 10F))
                e.Graphics.DrawString(dt, f, new SolidBrush(ColorTranslator.FromHtml("#64748B")), e.CellBounds, SF(StringAlignment.Center, StringAlignment.Center));
        }

        private void PaintEye(DataGridViewCellPaintingEventArgs e, Color bg)
        {
            e.Handled = true;
            var g = e.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
            g.FillRectangle(new SolidBrush(bg), e.CellBounds);
            int bw = 36, bh = 30;
            int bx = e.CellBounds.Left + (e.CellBounds.Width - bw) / 2;
            int by = e.CellBounds.Top + (e.CellBounds.Height - bh) / 2;
            var rc = new Rectangle(bx, by, bw, bh);
            using (var path = RoundPath(rc, 8))
            { g.FillPath(new SolidBrush(ColorTranslator.FromHtml("#EFF6FF")), path); g.DrawPath(new Pen(ColorTranslator.FromHtml("#93C5FD"), 1.2f), path); }
            int cx = bx + bw / 2, cy = by + bh / 2;
            using (var pen = new Pen(ColorTranslator.FromHtml("#2563EB"), 1.8f))
            {
                var ep = new GraphicsPath();
                ep.AddArc(cx - 9, cy - 5, 18, 10, 180, -180);
                ep.AddArc(cx - 9, cy - 5, 18, 10, 0, -180);
                g.DrawPath(pen, ep);
                ep.Dispose();
            }
            g.FillEllipse(new SolidBrush(ColorTranslator.FromHtml("#2563EB")), cx - 3, cy - 3, 6, 6);
            g.FillEllipse(Brushes.White, cx + 1, cy - 2, 2, 2);
        }

        private void PaintDelete(DataGridViewCellPaintingEventArgs e, Color bg)
        {
            e.Handled = true;
            var g = e.Graphics; g.SmoothingMode = SmoothingMode.AntiAlias;
            g.FillRectangle(new SolidBrush(bg), e.CellBounds);
            int bw = 30, bh = 28;
            int bx = e.CellBounds.Left + (e.CellBounds.Width - bw) / 2;
            int by = e.CellBounds.Top + (e.CellBounds.Height - bh) / 2;
            using (var path = RoundPath(new Rectangle(bx, by, bw, bh), 7))
            { g.FillPath(new SolidBrush(ColorTranslator.FromHtml("#FEF2F2")), path); g.DrawPath(new Pen(ColorTranslator.FromHtml("#FECACA"), 1f), path); }
            using (var pen = new Pen(ColorTranslator.FromHtml("#EF4444"), 1.6f))
            {
                int dx = bx + bw / 2, dy = by + bh / 2;
                g.DrawLine(pen, dx - 5, dy - 3, dx + 5, dy - 3);
                g.DrawLine(pen, dx - 1, dy - 5, dx + 1, dy - 5);
                g.DrawRectangle(pen, dx - 4, dy - 2, 8, 6);
                g.DrawLine(pen, dx - 1, dy, dx - 1, dy + 3);
                g.DrawLine(pen, dx + 1, dy, dx + 1, dy + 3);
            }
        }

        private void Dgv_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0) return;
            var dto = dgvDispatch.Rows[e.RowIndex].DataBoundItem as DispatchOrderDto;
            if (dto == null) return;
            string col = dgvDispatch.Columns[e.ColumnIndex].Name;

            if (col == "DDetails")
                ShowDetailsPopup(dto);
            else if (col == "DActions")
            {
                if (MessageBox.Show("حذف أمر الصرف وعكس المخزن؟", "تأكيد", MessageBoxButtons.YesNo, MessageBoxIcon.Warning) == DialogResult.Yes)
                {
                    try { _vehicleService.DeleteDispatchOrder(dto.Id); LoadDispatches(); ShowSuccessToast("تم الحذف وعكس المخزن"); }
                    catch (Exception ex) { ShowErrorToast(GetInner(ex)); }
                }
            }
        }

