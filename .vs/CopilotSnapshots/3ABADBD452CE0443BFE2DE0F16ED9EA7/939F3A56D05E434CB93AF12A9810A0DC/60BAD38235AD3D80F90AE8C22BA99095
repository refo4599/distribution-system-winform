                void Calc()
                {
                    int b2 = 24;
                    try { int pid2 = Convert.ToInt32(cboProd.SelectedValue); var pr2 = products.FirstOrDefault(p => p.Id == pid2); if (pr2 != null && pr2.BoxesPerCarton > 0) b2 = pr2.BoxesPerCarton; } catch { }
                    int.TryParse(txtCrt.Text, out int c2); int.TryParse(txtExt.Text, out int x2);
                    int tot = Math.Max(0, c2) * b2 + Math.Max(0, x2);
                    lblTot.Text = tot > 0 ? $"= {tot} علبة" : "= 0 علبة";
                    lblTot.ForeColor = tot > 0 ? ColorTranslator.FromHtml("#059669") : ColorTranslator.FromHtml("#94A3B8");
                    txtCrt.BorderColor = tot > 0 ? ColorTranslator.FromHtml("#059669") : ColorTranslator.FromHtml("#E5E7EB");
                }

                txtCrt.TextChanged += (s, e) => Calc();
                txtExt.TextChanged += (s, e) => Calc();

                // FIX 1: ملء سعر البيع تلقائياً من بيانات المنتج عند الاختيار
                cboProd.SelectedIndexChanged += (s, e) =>
                {
                    Calc();
                    try
                    {
                        int pid2 = Convert.ToInt32(cboProd.SelectedValue ?? 0);
                        var selProd = products.FirstOrDefault(p => p.Id == pid2);
                        if (selProd != null && selProd.Id > 0 && selProd.SalePrice > 0)
                            txtPrc.Text = selProd.SalePrice.ToString("N2", Inv);
                        else if (selProd != null && selProd.Id > 0)
                            txtPrc.Text = "";
                    }
                    catch { }
                };

                row.Resize += (s, e) =>
                {
