using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Reflection;
using iTextSharp.text;
using iTextSharp.text.pdf;
using DistributionSystem.Business.Dtos;

namespace DistributionSystem.Business.Services
{
    public class PdfReportService
    {
        private static readonly string[] ArabicMonths = new[]
        {
            "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو",
            "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"
        };

        // FIX 1: أزلنا readonly عشان بنعدله في ExtractEmbeddedFontToTemp
        private Assembly _asm;

        public PdfReportService()
        {
            _asm = Assembly.GetExecutingAssembly();
        }

        public byte[] GenerateVehicleMonthlyReport(
            VehicleDto vehicle, List<DispatchOrderDto> orders, int month, int year)
        {
            if (vehicle == null) throw new ArgumentNullException(nameof(vehicle));
            orders = orders ?? new List<DispatchOrderDto>();

            string regularPath = null;
            string boldPath = null;

            using (var ms = new MemoryStream())
            {
                // FIX 2: top margin = 100pt عشان البانر 90pt ومتداخلوش
                var doc = new Document(PageSize.A4, 36, 36, 100, 36);
                var writer = PdfWriter.GetInstance(doc, ms);
                doc.Open();

                regularPath = ExtractEmbeddedFontToTemp("Cairo-Regular.ttf");
                boldPath = ExtractEmbeddedFontToTemp("Cairo-Bold.ttf");

                try
                {
                    var bfReg = BaseFont.CreateFont(regularPath, BaseFont.IDENTITY_H, BaseFont.EMBEDDED);
                    var bfBold = BaseFont.CreateFont(boldPath, BaseFont.IDENTITY_H, BaseFont.EMBEDDED);

                    // الخطوط
                    var fTitle = new Font(bfBold, 20, Font.BOLD, BaseColor.WHITE);
                    var fSubTitle = new Font(bfReg, 12, Font.NORMAL, new BaseColor(200, 220, 255));
                    var fNormal = new Font(bfReg, 11, Font.NORMAL, BaseColor.BLACK);
                    var fBold = new Font(bfBold, 11, Font.BOLD, BaseColor.BLACK);
                    // FIX 3: خط أبيض عريض للهيدر rows في الجداول
                    var fBoldWhite = new Font(bfBold, 11, Font.BOLD, BaseColor.WHITE);
                    var fSmall = new Font(bfReg, 9, Font.NORMAL, new BaseColor(100, 100, 100));
                    var fGrandTot = new Font(bfBold, 13, Font.BOLD, new BaseColor(21, 101, 192));

                    var cb = writer.DirectContent;

                    // ── البانر العلوي ──────────────────────────────────────────
                    cb.SaveState();
                    // الخلفية الداكنة
                    cb.SetColorFill(new BaseColor(26, 47, 94));
                    cb.Rectangle(0, doc.PageSize.Height - 90, doc.PageSize.Width, 90);
                    cb.Fill();
                    // شريط أزرق فاتح في الأسفل
                    cb.SetColorFill(new BaseColor(21, 101, 192));
                    cb.Rectangle(0, doc.PageSize.Height - 92, doc.PageSize.Width, 4);
                    cb.Fill();
                    cb.RestoreState();

                    // FIX 4: Phrase مباشرة (مش Paragraph) في ShowTextAligned
                    string monthName = (month >= 1 && month <= 12)
                        ? ArabicMonths[month]
                        : month.ToString();

                    // العنوان الرئيسي
                    ColumnText.ShowTextAligned(cb, Element.ALIGN_RIGHT,
                        new Phrase($"التقرير الشهري للسيارة: {vehicle.Name}", fTitle),
                        doc.PageSize.Width - 40,
                        doc.PageSize.Height - 48, 0);

                    // العنوان الفرعي: الشهر + السنة + اسم المندوب
                    string subLine = $"{monthName}  {year}     |     المندوب: {vehicle.RepName ?? "—"}";
                    ColumnText.ShowTextAligned(cb, Element.ALIGN_RIGHT,
                        new Phrase(subLine, fSubTitle),
                        doc.PageSize.Width - 40,
                        doc.PageSize.Height - 72, 0);

                    // ── ملخص الشهر ──────────────────────────────────────────
                    int totalOrders = orders.Count;
                    int totalProducts = orders.Sum(o => o.Items?.Sum(i => i.Quantity) ?? 0);
                    decimal totalRevenue = orders.Sum(o => o.Items?.Sum(i => (decimal)i.Quantity * i.SalePrice) ?? 0);

                    // جدول بطاقات الملخص (3 أعمدة)
                    var summaryTable = new PdfPTable(3)
                    {
                        RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                        WidthPercentage = 100,
                        SpacingAfter = 14f
                    };
                    summaryTable.SetWidths(new float[] { 1f, 1f, 1f });

                    summaryTable.AddCell(MakeSummaryCard("عدد أوامر الصرف",
                        totalOrders.ToString(), new BaseColor(239, 246, 255), bfBold, bfReg));
                    summaryTable.AddCell(MakeSummaryCard("إجمالي الكمية (علبة)",
                        totalProducts.ToString("N0"), new BaseColor(236, 253, 245), bfBold, bfReg));
                    summaryTable.AddCell(MakeSummaryCard("إجمالي الإيرادات",
                        totalRevenue.ToString("N2", CultureInfo.InvariantCulture) + " ج",
                        new BaseColor(255, 247, 237), bfBold, bfReg));

                    doc.Add(summaryTable);

                    // ── تفاصيل كل أمر صرف ──────────────────────────────────
                    string[] colHdrs = { "المنتج", "كراتين", "علب إضافية", "إجمالي الكمية", "سعر البيع", "الإجمالي" };
                    float[] colWts = { 2.5f, 0.8f, 0.9f, 1.1f, 1f, 1.1f };
                    var darkBlue = new BaseColor(26, 47, 94);
                    var midBlue = new BaseColor(30, 58, 110);
                    var altRowColor = new BaseColor(248, 250, 255);

                    foreach (var ord in orders.OrderBy(o => o.CreatedAt))
                    {
                        // هيدر الأمر
                        string ordDate = ord.CreatedAt.ToLocalTime()
                            .ToString("yyyy/MM/dd   HH:mm", CultureInfo.InvariantCulture);

                        var ordHdrTable = new PdfPTable(2)
                        {
                            RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                            WidthPercentage = 100,
                            SpacingBefore = 10f,
                            SpacingAfter = 4f
                        };
                        ordHdrTable.SetWidths(new float[] { 1.2f, 1f });

                        var c1 = new PdfPCell(new Phrase($"أمر صرف رقم #{ord.Id}", fBold))
                        {
                            BackgroundColor = new BaseColor(239, 246, 255),
                            Border = Rectangle.NO_BORDER,
                            HorizontalAlignment = Element.ALIGN_RIGHT,
                            Padding = 7f,
                            RunDirection = PdfWriter.RUN_DIRECTION_RTL
                        };
                        var c2 = new PdfPCell(new Phrase($"التاريخ: {ordDate}", fSmall))
                        {
                            BackgroundColor = new BaseColor(239, 246, 255),
                            Border = Rectangle.NO_BORDER,
                            HorizontalAlignment = Element.ALIGN_LEFT,
                            Padding = 7f,
                            RunDirection = PdfWriter.RUN_DIRECTION_RTL
                        };
                        ordHdrTable.AddCell(c1);
                        ordHdrTable.AddCell(c2);
                        doc.Add(ordHdrTable);

                        // جدول المنتجات
                        var tbl = new PdfPTable(colHdrs.Length)
                        {
                            RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                            WidthPercentage = 100,
                            SpacingAfter = 4f
                        };
                        tbl.SetWidths(colWts);

                        // صف الهيدر
                        foreach (var h in colHdrs)
                        {
                            // FIX 3: استخدام fBoldWhite عشان النص يبان على الخلفية الداكنة
                            tbl.AddCell(new PdfPCell(new Phrase(h, fBoldWhite))
                            {
                                BackgroundColor = darkBlue,
                                HorizontalAlignment = Element.ALIGN_CENTER,
                                Padding = 7f,
                                RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                                BorderColor = midBlue,
                                BorderWidth = 0.5f
                            });
                        }

                        decimal orderTotal = 0m;
                        int rowIndex = 0;
                        foreach (var it in ord.Items ?? new List<DispatchOrderItemDto>())
                        {
                            int totalBoxes = it.Quantity;
                            int cartons = totalBoxes / 24;
                            int extra = totalBoxes % 24;
                            decimal rowTotal = (decimal)totalBoxes * it.SalePrice;
                            orderTotal += rowTotal;

                            var rowBg = rowIndex % 2 == 0
                                ? BaseColor.WHITE
                                : altRowColor;

                            string salePriceStr = it.SalePrice > 0
                                ? it.SalePrice.ToString("N2", CultureInfo.InvariantCulture) + " ج"
                                : "—";

                            tbl.AddCell(MakeDataCell(it.ProductName ?? $"#{it.ProductId}", fBold, Element.ALIGN_RIGHT, rowBg));
                            tbl.AddCell(MakeDataCell(cartons.ToString(), fNormal, Element.ALIGN_CENTER, rowBg));
                            tbl.AddCell(MakeDataCell(extra.ToString(), fNormal, Element.ALIGN_CENTER, rowBg));
                            tbl.AddCell(MakeDataCell($"{totalBoxes} علبة", fNormal, Element.ALIGN_CENTER, rowBg));
                            tbl.AddCell(MakeDataCell(salePriceStr, fNormal, Element.ALIGN_CENTER, rowBg));
                            tbl.AddCell(MakeDataCell(rowTotal.ToString("N2", CultureInfo.InvariantCulture) + " ج",
                                fBold, Element.ALIGN_CENTER, rowBg));
                            rowIndex++;
                        }

                        // صف إجمالي الأمر
                        var totCell = new PdfPCell(
                            new Phrase("إجمالي الأمر:   " +
                                orderTotal.ToString("N2", CultureInfo.InvariantCulture) + " ج", fBold))
                        {
                            Colspan = colHdrs.Length,
                            BackgroundColor = new BaseColor(219, 234, 254),
                            HorizontalAlignment = Element.ALIGN_RIGHT,
                            Padding = 7f,
                            RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                            BorderColor = new BaseColor(147, 197, 253),
                            BorderWidth = 0.5f
                        };
                        tbl.AddCell(totCell);
                        doc.Add(tbl);
                    }

                    // ── الإجمالي الكلي ──────────────────────────────────────
                    doc.Add(new Paragraph("\n"));
                    var grandTable = new PdfPTable(1)
                    {
                        RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                        WidthPercentage = 60,
                        HorizontalAlignment = Element.ALIGN_RIGHT,
                        SpacingBefore = 6f
                    };
                    grandTable.AddCell(new PdfPCell(
                        new Phrase("الإجمالي الكلي للشهر:   " +
                            totalRevenue.ToString("N2", CultureInfo.InvariantCulture) + " جنيه", fGrandTot))
                    {
                        BackgroundColor = new BaseColor(219, 234, 254),
                        HorizontalAlignment = Element.ALIGN_RIGHT,
                        Padding = 12f,
                        RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                        Border = Rectangle.BOX,
                        BorderColor = new BaseColor(21, 101, 192),
                        BorderWidth = 1.5f
                    });
                    doc.Add(grandTable);

                    // ── الفوتر ───────────────────────────────────────────────
                    doc.Add(new Paragraph("\n\n"));
                    var line = new Chunk(new iTextSharp.text.pdf.draw.LineSeparator(
                        0.5f, 100f, new BaseColor(200, 200, 200), Element.ALIGN_CENTER, -2));
                    doc.Add(new Paragraph(line));
                    doc.Add(new Paragraph(
                        $"تاريخ الإنشاء: {DateTime.Now:yyyy/MM/dd   HH:mm:ss}",
                        new Font(bfReg, 9, Font.NORMAL, new BaseColor(150, 150, 150)))
                    { Alignment = Element.ALIGN_RIGHT });
                }
                finally
                {
                    try { if (regularPath != null) File.Delete(regularPath); } catch { }
                    try { if (boldPath != null) File.Delete(boldPath); } catch { }
                }

                doc.Close();
                return ms.ToArray();
            }
        }

        // ── Helpers ──────────────────────────────────────────────────────────

        private static PdfPCell MakeSummaryCard(
            string label, string value, BaseColor bg, BaseFont bfBold, BaseFont bfReg)
        {
            var inner = new PdfPTable(1)
            {
                RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                WidthPercentage = 100
            };
            inner.AddCell(new PdfPCell(
                new Phrase(label, new Font(bfReg, 10, Font.NORMAL, new BaseColor(80, 80, 80))))
            {
                Border = Rectangle.NO_BORDER,
                HorizontalAlignment = Element.ALIGN_RIGHT,
                PaddingBottom = 4f,
                RunDirection = PdfWriter.RUN_DIRECTION_RTL
            });
            inner.AddCell(new PdfPCell(
                new Phrase(value, new Font(bfBold, 14, Font.BOLD, new BaseColor(26, 47, 94))))
            {
                Border = Rectangle.NO_BORDER,
                HorizontalAlignment = Element.ALIGN_RIGHT,
                RunDirection = PdfWriter.RUN_DIRECTION_RTL
            });

            return new PdfPCell(inner)
            {
                BackgroundColor = bg,
                Padding = 12f,
                Border = Rectangle.BOX,
                BorderColor = new BaseColor(200, 220, 255),
                BorderWidth = 0.5f,
                HorizontalAlignment = Element.ALIGN_RIGHT
            };
        }

        private static PdfPCell MakeDataCell(
            string text, Font font, int align, BaseColor bg)
        {
            return new PdfPCell(new Phrase(text, font))
            {
                HorizontalAlignment = align,
                Padding = 6f,
                RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                BackgroundColor = bg,
                BorderColor = new BaseColor(226, 232, 240),
                BorderWidth = 0.5f
            };
        }

        // ── Font Extraction ───────────────────────────────────────────────────
        private string ExtractEmbeddedFontToTemp(string fileName)
        {
            // نحاول في executing assembly الأول ثم entry assembly
            string resName = FindResourceName(_asm, fileName);

            if (resName == null)
            {
                var ea = Assembly.GetEntryAssembly();
                if (ea != null)
                {
                    resName = FindResourceName(ea, fileName);
                    // FIX 1: ممكن نعدل _asm دلوقتي عشان مش readonly
                    if (resName != null) _asm = ea;
                }
            }

            if (resName == null)
                throw new FileNotFoundException(
                    $"Embedded font not found: {fileName}\n" +
                    $"Resources in assembly: {string.Join(", ", _asm.GetManifestResourceNames())}");

            using (var rs = _asm.GetManifestResourceStream(resName))
            {
                if (rs == null)
                    throw new FileNotFoundException("Cannot open embedded resource: " + resName);

                var tmp = Path.Combine(Path.GetTempPath(), Guid.NewGuid() + ".ttf");
                using (var fs = File.Create(tmp))
                    rs.CopyTo(fs);
                return tmp;
            }
        }

        private static string FindResourceName(Assembly asm, string fileName)
        {
            foreach (var r in asm.GetManifestResourceNames())
                if (r.EndsWith("Resources.Fonts." + fileName, StringComparison.OrdinalIgnoreCase) ||
                    r.EndsWith("." + fileName, StringComparison.OrdinalIgnoreCase))
                    return r;
            return null;
        }
    }
}