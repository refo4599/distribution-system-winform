using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Linq;
using iTextSharp.text;
using iTextSharp.text.pdf;
using DistributionSystem.Business.Dtos;

namespace DistributionSystem.Business.Services
{
    public class PdfReportService
    {
        private static readonly string[] ArabicMonths = new[]
        {
            "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو",
            "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"
        };

        // ── تحويل الأرقام لعربية ─────────────────────────────────────────
        private static string ToArabicNumerals(string input)
        {
            if (string.IsNullOrEmpty(input)) return input;
            var sb = new System.Text.StringBuilder(input.Length);
            foreach (char c in input)
            {
                switch (c)
                {
                    case '0': sb.Append('\u0660'); break;
                    case '1': sb.Append('\u0661'); break;
                    case '2': sb.Append('\u0662'); break;
                    case '3': sb.Append('\u0663'); break;
                    case '4': sb.Append('\u0664'); break;
                    case '5': sb.Append('\u0665'); break;
                    case '6': sb.Append('\u0666'); break;
                    case '7': sb.Append('\u0667'); break;
                    case '8': sb.Append('\u0668'); break;
                    case '9': sb.Append('\u0669'); break;
                    default: sb.Append(c); break;
                }
            }
            return sb.ToString();
        }

        private static string ToAr(decimal value, string format = "N2") =>
            ToArabicNumerals(value.ToString(format, CultureInfo.InvariantCulture));

        private static string ToAr(int value) =>
            ToArabicNumerals(value.ToString());

        // ── تحميل الخط من Windows Fonts ──────────────────────────────────
        private static string GetWindowsFont(params string[] names)
        {
            string fontsFolder = Environment.GetFolderPath(Environment.SpecialFolder.Fonts);
            foreach (var name in names)
            {
                string path = Path.Combine(fontsFolder, name);
                if (File.Exists(path)) return path;
            }
            return Path.Combine(fontsFolder, "arial.ttf");
        }

        public byte[] GenerateVehicleMonthlyReport(
            VehicleDto vehicle, List<DispatchOrderDto> orders, int month, int year)
        {
            if (vehicle == null) throw new ArgumentNullException(nameof(vehicle));
            orders = orders ?? new List<DispatchOrderDto>();

            using (var ms = new MemoryStream())
            {
                var doc = new Document(PageSize.A4, 36, 36, 100, 36);
                var writer = PdfWriter.GetInstance(doc, ms);
                doc.Open();

                // ── تحميل الخطوط ─────────────────────────────────────────
                string regularPath = GetWindowsFont(
                    "Cairo Regular.ttf",
                    "tahoma.ttf");

                string boldPath = GetWindowsFont(
                    "Cairo Bold.ttf",
                    "tahomabd.ttf");

                var bfReg = BaseFont.CreateFont(regularPath, BaseFont.IDENTITY_H, BaseFont.EMBEDDED);
                var bfBold = BaseFont.CreateFont(boldPath, BaseFont.IDENTITY_H, BaseFont.EMBEDDED);

                // ── تعريف الخطوط ─────────────────────────────────────────
                var fTitle = new Font(bfBold, 20, Font.BOLD, BaseColor.WHITE);
                var fSubTitle = new Font(bfReg, 12, Font.NORMAL, new BaseColor(200, 220, 255));
                var fNormal = new Font(bfReg, 11, Font.NORMAL, BaseColor.BLACK);
                var fBold = new Font(bfBold, 11, Font.BOLD, BaseColor.BLACK);
                var fBoldWhite = new Font(bfBold, 11, Font.BOLD, BaseColor.WHITE);
                var fSmall = new Font(bfReg, 9, Font.NORMAL, new BaseColor(100, 100, 100));
                var fGrandTot = new Font(bfBold, 13, Font.BOLD, new BaseColor(21, 101, 192));

                var cb = writer.DirectContent;

                // ── البانر العلوي ─────────────────────────────────────────
                cb.SaveState();
                cb.SetColorFill(new BaseColor(26, 47, 94));
                cb.Rectangle(0, doc.PageSize.Height - 90, doc.PageSize.Width, 90);
                cb.Fill();
                cb.SetColorFill(new BaseColor(21, 101, 192));
                cb.Rectangle(0, doc.PageSize.Height - 92, doc.PageSize.Width, 4);
                cb.Fill();
                cb.RestoreState();

                // FIX 4: Phrase مباشرة (مش Paragraph) في ShowTextAligned
                string monthName = (month >= 1 && month <= 12)
                    ? ArabicMonths[month]
                    : month.ToString();

                // ── العنوان الرئيسي ───────────────────────────────────────────
                var titlePhrase = new Phrase();
                var titleChunk = new Chunk($"التقرير الشهري للسيارة: {vehicle.Name}", fTitle);
                titleChunk.SetTextRenderMode(PdfContentByte.TEXT_RENDER_MODE_FILL, 0, BaseColor.WHITE);
                titlePhrase.Add(titleChunk);

                ColumnText ct1 = new ColumnText(cb);
                ct1.RunDirection = PdfWriter.RUN_DIRECTION_RTL;
                ct1.SetSimpleColumn(
                    36,
                    doc.PageSize.Height - 65,
                    doc.PageSize.Width - 36,
                    doc.PageSize.Height - 30);
                ct1.AddText(titlePhrase);
                ct1.Alignment = Element.ALIGN_CENTER;
                ct1.Go();

                // ── العنوان الفرعي ────────────────────────────────────────────
                string subLine = $"{monthName}  {ToArabicNumerals(year.ToString())}     |     المندوب: {vehicle.RepName ?? "—"}";
                ColumnText ct2 = new ColumnText(cb);
                ct2.RunDirection = PdfWriter.RUN_DIRECTION_RTL;
                ct2.SetSimpleColumn(
                    36,
                    doc.PageSize.Height - 88,
                    doc.PageSize.Width - 36,
                    doc.PageSize.Height - 60);
                ct2.AddText(new Phrase(subLine, fSubTitle));
                ct2.Alignment = Element.ALIGN_CENTER;
                ct2.Go();

                // ── ملخص الشهر ────────────────────────────────────────────
                int totalOrders = orders.Count;
                int totalProducts = orders.Sum(o => o.Items?.Sum(i => i.Quantity) ?? 0);
                decimal totalRevenue = orders.Sum(o => o.Items?.Sum(i => (decimal)i.Quantity * i.SalePrice) ?? 0);

                var summaryTable = new PdfPTable(3)
                {
                    RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                    WidthPercentage = 100,
                    SpacingAfter = 14f
                };
                summaryTable.SetWidths(new float[] { 1f, 1f, 1f });
                summaryTable.AddCell(MakeSummaryCard("عدد أوامر الصرف",
                    ToAr(totalOrders),
                    new BaseColor(239, 246, 255), bfBold, bfReg));
                summaryTable.AddCell(MakeSummaryCard("إجمالي الكمية (علبة)",
                    ToArabicNumerals(totalProducts.ToString("N0")),
                    new BaseColor(236, 253, 245), bfBold, bfReg));
                summaryTable.AddCell(MakeSummaryCard("إجمالي الإيرادات",
                    ToAr(totalRevenue) + " ج",
                    new BaseColor(255, 247, 237), bfBold, bfReg));
                doc.Add(summaryTable);

                // ── تفاصيل كل أمر صرف ────────────────────────────────────
                string[] colHdrs = { "المنتج", "كراتين", "علب إضافية", "إجمالي الكمية", "سعر البيع", "الإجمالي" };
                float[] colWts = { 2.5f, 0.8f, 0.9f, 1.1f, 1f, 1.1f };
                var darkBlue = new BaseColor(26, 47, 94);
                var midBlue = new BaseColor(30, 58, 110);
                var altRowBg = new BaseColor(248, 250, 255);

                foreach (var ord in orders.OrderBy(o => o.CreatedAt))
                {
                    var localDate = ord.CreatedAt.ToLocalTime();
                    string ordDate = ToArabicNumerals(
                        localDate.ToString("yyyy/MM/dd   HH:mm", CultureInfo.InvariantCulture));

                    // هيدر الأمر
                    var ordHdr = new PdfPTable(2)
                    {
                        RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                        WidthPercentage = 100,
                        SpacingBefore = 10f,
                        SpacingAfter = 4f
                    };
                    ordHdr.SetWidths(new float[] { 1.2f, 1f });
                    ordHdr.AddCell(new PdfPCell(
                        new Phrase($"أمر صرف رقم #{ToAr(ord.Id)}", fBold))
                    {
                        BackgroundColor = new BaseColor(239, 246, 255),
                        Border = Rectangle.NO_BORDER,
                        HorizontalAlignment = Element.ALIGN_RIGHT,
                        Padding = 7f,
                        RunDirection = PdfWriter.RUN_DIRECTION_RTL
                    });
                    ordHdr.AddCell(new PdfPCell(
                        new Phrase($"التاريخ: {ordDate}", fSmall))
                    {
                        BackgroundColor = new BaseColor(239, 246, 255),
                        Border = Rectangle.NO_BORDER,
                        HorizontalAlignment = Element.ALIGN_LEFT,
                        Padding = 7f,
                        RunDirection = PdfWriter.RUN_DIRECTION_RTL
                    });
                    doc.Add(ordHdr);

                    // جدول المنتجات
                    var tbl = new PdfPTable(colHdrs.Length)
                    {
                        RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                        WidthPercentage = 100,
                        SpacingAfter = 4f
                    };
                    tbl.SetWidths(colWts);

                    foreach (var h in colHdrs)
                        tbl.AddCell(new PdfPCell(new Phrase(h, fBoldWhite))
                        {
                            BackgroundColor = darkBlue,
                            HorizontalAlignment = Element.ALIGN_CENTER,
                            Padding = 7f,
                            RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                            BorderColor = midBlue,
                            BorderWidth = 0.5f
                        });

                    decimal orderTotal = 0m;
                    int rowIndex = 0;
                    foreach (var it in ord.Items ?? new List<DispatchOrderItemDto>())
                    {
                        int totalBoxes = it.Quantity;
                        int cartons = totalBoxes / 24;
                        int extra = totalBoxes % 24;
                        decimal rowTot = (decimal)totalBoxes * it.SalePrice;
                        orderTotal += rowTot;
                        var bg = rowIndex % 2 == 0 ? BaseColor.WHITE : altRowBg;

                        string priceStr = it.SalePrice > 0
                            ? ToAr(it.SalePrice) + " ج" : "—";

                        tbl.AddCell(MakeDataCell(it.ProductName ?? $"#{ToAr(it.ProductId)}", fBold, Element.ALIGN_RIGHT, bg));
                        tbl.AddCell(MakeDataCell(ToAr(cartons), fNormal, Element.ALIGN_CENTER, bg));
                        tbl.AddCell(MakeDataCell(ToAr(extra), fNormal, Element.ALIGN_CENTER, bg));
                        tbl.AddCell(MakeDataCell($"{ToAr(totalBoxes)} علبة", fNormal, Element.ALIGN_CENTER, bg));
                        tbl.AddCell(MakeDataCell(priceStr, fNormal, Element.ALIGN_CENTER, bg));
                        tbl.AddCell(MakeDataCell(ToAr(rowTot) + " ج", fBold, Element.ALIGN_CENTER, bg));
                        rowIndex++;
                    }

                    tbl.AddCell(new PdfPCell(
                        new Phrase($"إجمالي الأمر:   {ToAr(orderTotal)} ج", fBold))
                    {
                        Colspan = colHdrs.Length,
                        BackgroundColor = new BaseColor(219, 234, 254),
                        HorizontalAlignment = Element.ALIGN_RIGHT,
                        Padding = 7f,
                        RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                        BorderColor = new BaseColor(147, 197, 253),
                        BorderWidth = 0.5f
                    });
                    doc.Add(tbl);
                }

                // ── الإجمالي الكلي ────────────────────────────────────────
                doc.Add(new Paragraph("\n"));
                var grandTable = new PdfPTable(1)
                {
                    RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                    WidthPercentage = 60,
                    HorizontalAlignment = Element.ALIGN_RIGHT,
                    SpacingBefore = 6f
                };
                grandTable.AddCell(new PdfPCell(
                    new Phrase($"الإجمالي الكلي للشهر:   {ToAr(totalRevenue)} جنيه", fGrandTot))
                {
                    BackgroundColor = new BaseColor(219, 234, 254),
                    HorizontalAlignment = Element.ALIGN_RIGHT,
                    Padding = 12f,
                    RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                    Border = Rectangle.BOX,
                    BorderColor = new BaseColor(21, 101, 192),
                    BorderWidth = 1.5f
                });
                doc.Add(grandTable);

                // ── الفوتر ────────────────────────────────────────────────
                doc.Add(new Paragraph("\n\n"));
                doc.Add(new Paragraph(new Chunk(new iTextSharp.text.pdf.draw.LineSeparator(
                    0.5f, 100f, new BaseColor(200, 200, 200), Element.ALIGN_CENTER, -2))));

                string footerDate = ToArabicNumerals(
                    DateTime.Now.ToString("yyyy/MM/dd   HH:mm:ss", CultureInfo.InvariantCulture));
                doc.Add(new Paragraph(
                    $"تاريخ الإنشاء: {footerDate}",
                    new Font(bfReg, 9, Font.NORMAL, new BaseColor(150, 150, 150)))
                { Alignment = Element.ALIGN_RIGHT });

                doc.Close();
                return ms.ToArray();
            }
        }

        // ── Helpers ──────────────────────────────────────────────────────

        private static PdfPCell MakeSummaryCard(
            string label, string value, BaseColor bg, BaseFont bfBold, BaseFont bfReg)
        {
            var inner = new PdfPTable(1)
            {
                RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                WidthPercentage = 100
            };
            inner.AddCell(new PdfPCell(
                new Phrase(label, new Font(bfReg, 10, Font.NORMAL, new BaseColor(80, 80, 80))))
            {
                Border = Rectangle.NO_BORDER,
                HorizontalAlignment = Element.ALIGN_RIGHT,
                PaddingBottom = 4f,
                RunDirection = PdfWriter.RUN_DIRECTION_RTL
            });
            inner.AddCell(new PdfPCell(
                new Phrase(value, new Font(bfBold, 14, Font.BOLD, new BaseColor(26, 47, 94))))
            {
                Border = Rectangle.NO_BORDER,
                HorizontalAlignment = Element.ALIGN_RIGHT,
                RunDirection = PdfWriter.RUN_DIRECTION_RTL
            });
            return new PdfPCell(inner)
            {
                BackgroundColor = bg,
                Padding = 12f,
                Border = Rectangle.BOX,
                BorderColor = new BaseColor(200, 220, 255),
                BorderWidth = 0.5f,
                HorizontalAlignment = Element.ALIGN_RIGHT
            };
        }

        private static PdfPCell MakeDataCell(string text, Font font, int align, BaseColor bg)
        {
            return new PdfPCell(new Phrase(text, font))
            {
                HorizontalAlignment = align,
                Padding = 6f,
                RunDirection = PdfWriter.RUN_DIRECTION_RTL,
                BackgroundColor = bg,
                BorderColor = new BaseColor(226, 232, 240),
                BorderWidth = 0.5f
            };
        }
    }
}